<div class="feed-container premium-bookmarks-container">
  <%= render 'shared/header' %>
  <div class="feed-layout">
    <main class="feed-main">

      <!-- Premium Dynamic Backdrop Glows -->
      <div class="premium-backdrop-glow blur-purple"></div>
      <div class="premium-backdrop-glow blur-pink"></div>

      <!-- Premium Glass Header -->
      <div class="premium-header-card-glass">
        <div class="premium-header-content">
          <div>
            <h1 class="premium-page-title-glow">
              <span class="folder-icon-bounce">📂</span> Nexus Collections
            </h1>
            <p class="premium-page-subtitle">Organize your saved posts & reels into dedicated folders</p>
          </div>
          <button class="premium-btn-collections" onclick="createCollectionModal()">
            <span class="folder-icon">+</span> New Collection
          </button>
        </div>
      </div>

      <!-- Also show all saved link -->
      <div class="collections-all-link-wrapper">
        <%= link_to bookmarks_path, class: 'premium-collection-card-glass all-saved-card' do %>
          <div class="premium-collection-cover-glow all-saved-cover">🔖</div>
          <div class="premium-collection-info">
            <h3 class="premium-collection-name">All Saved Items</h3>
            <p class="premium-collection-meta">View everything you've bookmarked</p>
          </div>
          <div class="premium-collection-arrow">→</div>
        <% end %>
      </div>

      <!-- Collections Grid -->
      <div class="premium-collections-grid" id="collections-grid">
        <% @collections.each do |col| %>
          <%= link_to bookmark_collection_path(col), class: 'premium-collection-card-glass' do %>
            <div class="premium-collection-cover-glow">
              <% cover = col.cover_thumbnail_url(self) %>
              <% if cover %>
                <img src="<%= cover %>" alt="<%= col.name %>" class="premium-collection-img">
              <% else %>
                <div class="premium-collection-empty-icon">📂</div>
              <% end %>
            </div>
            <div class="premium-collection-info">
              <h3 class="premium-collection-name"><%= col.name %></h3>
              <p class="premium-collection-meta"><%= col.bookmarks_count %> item<%= col.bookmarks_count == 1 ? '' : 's' %></p>
              <% if col.description.present? %>
                <p class="premium-collection-desc"><%= col.description.truncate(60) %></p>
              <% end %>
            </div>
            <div class="premium-collection-actions" onclick="event.preventDefault()">
              <button class="premium-collection-btn" onclick="editCollection(<%= col.id %>, '<%= j col.name %>', '<%= j col.description %>', event)" title="Edit">✏️</button>
              <% unless col.is_default %>
                <button class="premium-collection-btn btn-danger"
                        onclick="deleteCollection(<%= col.id %>, '<%= j col.name %>', event)" title="Delete">🗑</button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @collections.empty? %>
        <div class="premium-empty-state-glass">
          <div class="premium-empty-icon-glow">📂</div>
          <h3>No Collections Created</h3>
          <p>Create thematic folders to filter and organize your bookmarks list.</p>
          <button class="premium-btn-explore" onclick="createCollectionModal()">Create First Collection</button>
        </div>
      <% end %>

    </main>
  </div>
</div>

<!-- Create/Edit Collection Modal (Glassmorphic) -->
<div id="collection-create-modal" class="premium-modal-overlay-glass" style="display:none">
  <div class="premium-modal-glass">
    <div class="premium-modal-header">
      <h3 id="collection-modal-title">New Collection</h3>
      <button onclick="closeCollectionModal()" class="premium-modal-close-btn">✕</button>
    </div>
    <div class="premium-modal-body">
      <div class="premium-input-group">
        <label for="collection-name-input" class="premium-input-label">Name</label>
        <input type="text" id="collection-name-input" placeholder="Collection name..." maxlength="50" class="premium-input-field-glass">
      </div>
      <div class="premium-input-group" style="margin-bottom: 20px;">
        <label for="collection-desc-input" class="premium-input-label">Description (Optional)</label>
        <textarea id="collection-desc-input" placeholder="Describe this collection..." rows="3" class="premium-input-field-glass"></textarea>
      </div>
      <div class="premium-modal-footer">
        <button class="premium-btn-collections" onclick="saveCollection()">Save Collection</button>
        <button class="premium-btn-cancel-glass" onclick="closeCollectionModal()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
  let editingCollectionId = null;

  function createCollectionModal() {
    editingCollectionId = null;
    document.getElementById('collection-modal-title').textContent = 'New Collection';
    document.getElementById('collection-name-input').value = '';
    document.getElementById('collection-desc-input').value = '';
    document.getElementById('collection-create-modal').style.display = 'flex';
  }

  function editCollection(id, name, description, e) {
    e?.stopPropagation();
    editingCollectionId = id;
    document.getElementById('collection-modal-title').textContent = 'Edit Collection';
    document.getElementById('collection-name-input').value = name;
    document.getElementById('collection-desc-input').value = description || '';
    document.getElementById('collection-create-modal').style.display = 'flex';
  }

  function closeCollectionModal() {
    document.getElementById('collection-create-modal').style.display = 'none';
    editingCollectionId = null;
  }

  async function saveCollection() {
    const name = document.getElementById('collection-name-input').value.trim();
    if (!name) { alert('Name required'); return; }
    const description = document.getElementById('collection-desc-input').value.trim();
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const url    = editingCollectionId ? `/bookmark_collections/${editingCollectionId}` : '/bookmark_collections';
    const method = editingCollectionId ? 'PATCH' : 'POST';

    const resp = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ bookmark_collection: { name, description } })
    });
    const data = await resp.json();
    if (data.success) { closeCollectionModal(); window.location.reload(); }
    else { alert(data.errors?.join('\n') || 'Error saving'); }
  }

  async function deleteCollection(id, name, e) {
    e?.stopPropagation();
    if (!confirm(`Delete collection "${name}"? Items inside will not be deleted.`)) return;
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const resp = await fetch(`/bookmark_collections/${id}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken }
    });
    const data = await resp.json();
    if (data.success) window.location.reload();
  }
</script>

<%= stylesheet_link_tag 'bookmarks/bookmarks', 'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'shared/collections',  'data-turbo-track': 'reload' %>

