<div class="feed-container">
  <%= render 'shared/header' %>
  <div class="feed-layout">
    <main class="feed-main">

      <div class="page-header-card">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
          <div>
            <h1 class="page-title">📂 Collections</h1>
            <p class="page-subtitle">Organize your saved posts & reels</p>
          </div>
          <button class="btn-primary" onclick="createCollectionModal()">+ New Collection</button>
        </div>
      </div>

      <!-- Also show all saved link -->
      <div class="collections-all-link">
        <%= link_to bookmarks_path, class: 'collection-card collection-card--all' do %>
          <div class="collection-card__cover collection-card__cover--default">🔖</div>
          <div class="collection-card__info">
            <h3 class="collection-name">All Saved</h3>
            <p class="collection-meta">View all your saved items</p>
          </div>
          <div class="collection-card__arrow">›</div>
        <% end %>
      </div>

      <!-- Collections Grid -->
      <div class="collections-grid" id="collections-grid">
        <% @collections.each do |col| %>
          <%= link_to bookmark_collection_path(col), class: 'collection-card' do %>
            <div class="collection-card__cover">
              <% cover = col.cover_thumbnail_url(self) %>
              <% if cover %>
                <img src="<%= cover %>" alt="<%= col.name %>">
              <% else %>
                <div class="collection-card__cover--empty">📂</div>
              <% end %>
            </div>
            <div class="collection-card__info">
              <h3 class="collection-name"><%= col.name %></h3>
              <p class="collection-meta"><%= col.bookmarks_count %> item<%= col.bookmarks_count == 1 ? '' : 's' %></p>
              <% if col.description.present? %>
                <p class="collection-desc"><%= col.description.truncate(60) %></p>
              <% end %>
            </div>
            <div class="collection-card__actions" onclick="event.preventDefault()">
              <button class="collection-action-btn" onclick="editCollection(<%= col.id %>, '<%= j col.name %>', event)" title="Edit">✏️</button>
              <% unless col.is_default %>
                <button class="collection-action-btn collection-action-btn--danger"
                        onclick="deleteCollection(<%= col.id %>, '<%= j col.name %>', event)" title="Delete">🗑</button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if @collections.empty? %>
        <div class="bookmarks-empty">
          <div class="bookmarks-empty__icon">📂</div>
          <h3>No collections yet</h3>
          <p>Create collections to organize your saved content.</p>
          <button class="bookmarks-empty__btn" onclick="createCollectionModal()">Create First Collection</button>
        </div>
      <% end %>

    </main>
  </div>
</div>

<!-- Create/Edit Collection Modal -->
<div id="collection-create-modal" class="collection-modal-overlay" style="display:none">
  <div class="collection-modal">
    <div class="collection-modal__header">
      <h3 id="collection-modal-title">New Collection</h3>
      <button onclick="closeCollectionModal()" class="collection-modal__close">✕</button>
    </div>
    <div class="collection-modal__body">
      <input type="text" id="collection-name-input" placeholder="Collection name..." maxlength="50" class="form-control" style="margin-bottom:10px">
      <textarea id="collection-desc-input" placeholder="Description (optional)..." rows="2" class="form-control" style="margin-bottom:16px"></textarea>
      <div style="display:flex;gap:10px">
        <button class="btn-primary" onclick="saveCollection()">Save</button>
        <button class="btn-secondary" onclick="closeCollectionModal()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
  let editingCollectionId = null;

  function createCollectionModal() {
    editingCollectionId = null;
    document.getElementById('collection-modal-title').textContent = 'New Collection';
    document.getElementById('collection-name-input').value = '';
    document.getElementById('collection-desc-input').value = '';
    document.getElementById('collection-create-modal').style.display = 'flex';
  }

  function editCollection(id, name, e) {
    e?.stopPropagation();
    editingCollectionId = id;
    document.getElementById('collection-modal-title').textContent = 'Edit Collection';
    document.getElementById('collection-name-input').value = name;
    document.getElementById('collection-create-modal').style.display = 'flex';
  }

  function closeCollectionModal() {
    document.getElementById('collection-create-modal').style.display = 'none';
    editingCollectionId = null;
  }

  async function saveCollection() {
    const name = document.getElementById('collection-name-input').value.trim();
    if (!name) { alert('Name required'); return; }
    const description = document.getElementById('collection-desc-input').value.trim();
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const url    = editingCollectionId ? `/bookmark_collections/${editingCollectionId}` : '/bookmark_collections';
    const method = editingCollectionId ? 'PATCH' : 'POST';

    const resp = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ bookmark_collection: { name, description } })
    });
    const data = await resp.json();
    if (data.success) { closeCollectionModal(); window.location.reload(); }
    else { alert(data.errors?.join('\n') || 'Error saving'); }
  }

  async function deleteCollection(id, name, e) {
    e?.stopPropagation();
    if (!confirm(`Delete collection "${name}"? Items won't be deleted.`)) return;
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const resp = await fetch(`/bookmark_collections/${id}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrfToken }
    });
    const data = await resp.json();
    if (data.success) window.location.reload();
  }
</script>

<%= stylesheet_link_tag 'bookmarks/bookmarks', 'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'shared/collections',  'data-turbo-track': 'reload' %>
