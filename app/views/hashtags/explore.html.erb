<div class="explore-page">
  <%= render 'shared/header' %>
  
  <div class="explore-layout">
    <!-- Trending Hashtags Chips -->
    <% if @trending_hashtags.present? %>
      <div class="trending-hashtags-section">
        <div class="trending-hashtags-scroll">
          <% @trending_hashtags.first(10).each_with_index do |hashtag, index| %>
            <%= link_to hashtag_path(hashtag.name), class: 'trending-hashtag-chip' do %>
              <span class="hashtag-chip-rank">#<%= index + 1 %></span>
              <span>#<%= hashtag.name %></span>
              <span class="hashtag-chip-count"><%= hashtag.posts_count %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Instagram-style Grid -->
    <% if @recent_posts.present? %>
      <div class="explore-grid">
        <% @recent_posts.each do |post| %>
          <%= link_to post_path(post), class: 'explore-grid-item' do %>
            <% if post.images.attached? && post.images.count > 0 %>
              <%= image_tag post.images.first, alt: 'Post image' %>
              <% if post.images.count > 1 %>
                <div class="multiple-images-icon">📷</div>
              <% end %>
              <div class="explore-grid-overlay">
                <div class="explore-grid-stat"><span>❤️</span><span><%= post.likes_count || 0 %></span></div>
                <div class="explore-grid-stat"><span>💬</span><span><%= post.comments_count || 0 %></span></div>
              </div>

            <% elsif post.image.attached? %>
              <%= image_tag post.image, alt: 'Post image' %>
              <div class="explore-grid-overlay">
                <div class="explore-grid-stat"><span>❤️</span><span><%= post.likes_count || 0 %></span></div>
                <div class="explore-grid-stat"><span>💬</span><span><%= post.comments_count || 0 %></span></div>
              </div>

            <% elsif post.has_link_preview? && post.link_image_url.present? %>
              <img src="<%= post.link_image_url %>" alt="Link preview" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'">
              <div class="multiple-images-icon" style="background:#1877f2">🔗</div>
              <div class="explore-grid-overlay">
                <div class="explore-grid-stat"><span>❤️</span><span><%= post.likes_count || 0 %></span></div>
                <div class="explore-grid-stat"><span>💬</span><span><%= post.comments_count || 0 %></span></div>
              </div>

            <% else %>
              <div style="background: linear-gradient(45deg, #667eea, #764ba2); width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:white; font-size:1rem; font-weight:600; padding:1rem; text-align:center;">
                <%= truncate(post.content.to_s, length: 60) %>
              </div>
              <div class="explore-grid-overlay">
                <div class="explore-grid-stat"><span>❤️</span><span><%= post.likes_count || 0 %></span></div>
                <div class="explore-grid-stat"><span>💬</span><span><%= post.comments_count || 0 %></span></div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="explore-empty">
        <div class="explore-empty-icon">🔍</div>
        <h3>No posts yet</h3>
        <p>Be the first to share something amazing!</p>
      </div>
    <% end %>
  </div>
</div>

<%= stylesheet_link_tag 'explore/explore', 'data-turbo-track': 'reload' %>
