<% is_mine = message.sent_by?(current_user) %>
<div class="message-wrapper <%= is_mine ? 'mine' : 'theirs' %>"
     id="message-<%= message.id %>"
     data-message-id="<%= message.id %>">

  <% unless is_mine %>
    <div class="message-avatar-wrapper">
      <% if message.user.avatar.attached? %>
        <%= image_tag url_for(message.user.avatar), class: "message-avatar", alt: message.user.name %>
      <% else %>
        <div class="message-avatar-placeholder"><%= message.user.name&.first&.upcase %></div>
      <% end %>
    </div>
  <% end %>

  <div class="message-content-wrapper">
    <div class="message-bubble <%= message.deleted ? 'deleted' : '' %>"
         data-message-id="<%= message.id %>">
      <% if message.deleted %>
        <em class="message-deleted-text">Message deleted</em>
      <% elsif message.message_type == 'text' %>
        <p class="message-text"><%= simple_format(message.body) %></p>
      <% elsif message.message_type == 'image' && message.attachment.attached? %>
        <div class="message-image-wrapper">
          <%= image_tag url_for(message.attachment), class: "message-image",
                        loading: "lazy",
                        onclick: "chatApp.openImageViewer('#{url_for(message.attachment)}')" %>
        </div>
      <% elsif message.message_type == 'gif' && message.attachment.attached? %>
        <div class="message-image-wrapper">
          <%= image_tag url_for(message.attachment), class: "message-image message-gif" %>
        </div>
      <% elsif message.message_type == 'video' && message.attachment.attached? %>
        <div class="message-video-wrapper">
          <video controls class="message-video" preload="metadata">
            <source src="<%= url_for(message.attachment) %>">
          </video>
        </div>
      <% elsif message.message_type == 'audio' && message.attachment.attached? %>
        <div class="message-audio-wrapper">
          <audio controls class="message-audio" style="width:100%; border-radius:30px;">
            <source src="<%= url_for(message.attachment) %>">
          </audio>

          <% box_style = is_mine ? "margin-top:8px; font-size:0.82rem; background:rgba(0,0,0,0.22); backdrop-filter:blur(8px); padding:10px 12px; border-radius:12px; border:1px solid rgba(255,255,255,0.25); color:#ffffff;" : "margin-top:8px; font-size:0.82rem; background:rgba(59,130,246,0.08); padding:10px 12px; border-radius:12px; border-left:3px solid #3b82f6; color:#1e293b;" %>
          <% header_color = is_mine ? "#ffffff" : "#2563eb" %>
          <% select_style = is_mine ? "font-size:0.72rem; border-radius:6px; border:1px solid rgba(255,255,255,0.4); padding:3px 6px; background:rgba(255,255,255,0.2); color:#ffffff; font-weight:500; cursor:pointer; outline:none;" : "font-size:0.72rem; border-radius:6px; border:1px solid #cbd5e1; padding:3px 6px; background:#ffffff; color:#334155; font-weight:500; cursor:pointer; outline:none;" %>
          <% text_color = is_mine ? "rgba(255,255,255,0.95)" : "#334155" %>
          <% status_color = is_mine ? "rgba(255,255,255,0.85)" : "#64748b" %>

          <div class="message-transcription-box" id="transcription-<%= message.id %>" style="<%= box_style %>">
            <% if message.transcription.present? %>
              <div style="font-weight:600; color:<%= header_color %>; margin-bottom:6px; display:flex; align-items:center; justify-content:space-between; gap:6px; flex-wrap:wrap;">
                <span style="display:flex; align-items:center; gap:4px;">🎙️ AI Transcript</span>
                <select onchange="translateTranscriptText(this, 'transcript-text-<%= message.id %>')" style="<%= select_style %>">
                  <option value="" style="color:#1e293b; background:white;">🌐 Translate To...</option>
                  <option value="CUSTOM" style="color:#1e293b; background:white;">✏️ Type Any World Language...</option>
                  <optgroup label="Global Languages" style="color:#1e293b; background:white;">
                    <option value="English">🇬🇧 English</option>
                    <option value="Hindi">🇮🇳 Hindi (हिंदी)</option>
                    <option value="Hinglish">💬 Hinglish</option>
                    <option value="Spanish">🇪🇸 Spanish</option>
                    <option value="French">🇫🇷 French</option>
                    <option value="German">🇩🇪 German</option>
                    <option value="Mandarin Chinese">🇨🇳 Chinese</option>
                    <option value="Japanese">🇯🇵 Japanese</option>
                    <option value="Korean">🇰🇷 Korean</option>
                    <option value="Arabic">🇸🇦 Arabic</option>
                    <option value="Russian">🇷🇺 Russian</option>
                    <option value="Portuguese">🇵🇹 Portuguese</option>
                    <option value="Italian">🇮🇹 Italian</option>
                  </optgroup>
                  <optgroup label="Indian Languages" style="color:#1e293b; background:white;">
                    <option value="Marathi">🚩 Marathi (मराठी)</option>
                    <option value="Gujarati">🚩 Gujarati (ગુજરાતી)</option>
                    <option value="Bengali">🚩 Bengali (বাংলা)</option>
                    <option value="Punjabi">🚩 Punjabi (ਪੰਜਾਬੀ)</option>
                    <option value="Tamil">🚩 Tamil (தமிழ்)</option>
                    <option value="Telugu">🚩 Telugu (తెలుగు)</option>
                    <option value="Kannada">🚩 Kannada (ಕನ್ನಡ)</option>
                    <option value="Malayalam">🚩 Malayalam (മലയാളം)</option>
                    <option value="Urdu">🚩 Urdu (اردو)</option>
                  </optgroup>
                </select>
              </div>
              <p id="transcript-text-<%= message.id %>" style="margin:0; color:<%= text_color %>; font-style:italic; line-height:1.45; word-break:break-word;"><%= message.transcription %></p>
            <% elsif message.transcription_status == 'processing' || message.transcription_status == 'pending' %>
              <span style="color:<%= status_color %>; font-style:italic;">⚡ Transcribing audio with Whisper AI...</span>
            <% else %>
              <span style="color:<%= status_color %>; font-style:italic;">🎙️ Voice Note</span>
            <% end %>
          </div>
        </div>
      <% elsif message.message_type == 'file' && message.attachment.attached? %>
        <div class="message-file-wrapper">
          <div class="message-file-icon">📎</div>
          <div class="message-file-info">
            <span class="message-file-name"><%= message.attachment_filename %></span>
          </div>
          <%= link_to url_for(message.attachment), class: "message-file-download",
                      download: message.attachment_filename, target: "_blank" do %>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 12l-4-4h2.5V3h3v5H12L8 12zm-5 2h10v1.5H3V14z"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="message-meta">
      <span class="message-time">
        <%= message.created_at.strftime("%I:%M %p") %>
      </span>
      <% if is_mine %>
        <span class="message-status" data-message-id="<%= message.id %>">
          <% if message.read_at %>
            <span class="seen-indicator" title="Seen <%= message.read_at.strftime('%I:%M %p') %>">
              <svg width="16" height="10" viewBox="0 0 16 10" fill="#0084ff">
                <path d="M1 5l3 3 5-7M6 8l3-3 5-7" stroke="#0084ff" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              </svg>
            </span>
          <% else %>
            <span class="sent-indicator">
              <svg width="12" height="10" viewBox="0 0 12 10" fill="none">
                <path d="M1 5l3 3 7-7" stroke="#8a8d91" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          <% end %>
        </span>
      <% end %>
    </div>

    <!-- Message Context Menu (on hover) -->
    <% if is_mine && !message.deleted %>
      <div class="message-actions" data-message-id="<%= message.id %>">
        <button class="message-action-btn delete-message-btn"
                onclick="chatApp.deleteMessage(<%= message.id %>)"
                title="Delete">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
            <path d="M5.5 1.5h3a.5.5 0 010 1h-3a.5.5 0 010-1zM2 3.5h10l-.8 8H2.8L2 3.5zm2 2v4h1v-4H4zm3 0v4h1v-4H7z"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
</div>
