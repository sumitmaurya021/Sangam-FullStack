<% content_for :title, "Messenger - Sangam" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%= render 'shared/header' %>

<div class="messenger-layout" id="messengerLayout">
  <!-- Left Sidebar: Conversations List -->
  <div class="messenger-sidebar" id="messengerSidebar">
    <div class="messenger-sidebar-header">
      <h1 class="messenger-title">Chats</h1>
      <div class="messenger-header-actions">
        <button class="messenger-icon-btn" title="New Message" id="newMessageBtn">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M17.5 2.5a2.121 2.121 0 00-3 0L3 14l-.5 3.5 3.5-.5L17.5 5.5a2.121 2.121 0 000-3z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Search -->
    <div class="messenger-search-box">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="messenger-search-icon">
        <path d="M10.917 10.917a6.5 6.5 0 111.414-1.414l4.242 4.242a1 1 0 01-1.414 1.414l-4.242-4.242z"/>
      </svg>
      <input type="text" placeholder="Search Messenger" class="messenger-search-input" id="conversationSearch">
    </div>

    <!-- Conversations List -->
    <div class="messenger-conversations-list" id="conversationsList">
      <% if @conversations.empty? %>
        <div class="messenger-empty-state">
          <div class="messenger-empty-icon">💬</div>
          <p>No conversations yet</p>
          <p class="messenger-empty-sub">Start a chat with your friends!</p>
        </div>
      <% else %>
        <% @conversations.each do |conversation| %>
          <% other = conversation.other_participant(current_user) %>
          <% unread = @unread_counts[conversation.id] || 0 %>
          <% last_msg = conversation.latest_message %>
          <div class="messenger-conversation-item-wrapper"
               data-conv-id="<%= conversation.id %>"
               data-conv-url="<%= conversation_path(conversation) %>">
            <%= link_to conversation_path(conversation),
                        class: "messenger-conversation-item #{'unread' if unread > 0}",
                        data: { conversation_id: conversation.id, turbo: false } do %>
              <div class="messenger-avatar-wrapper">
                <% if other.avatar.attached? %>
                  <%= image_tag url_for(other.avatar), class: "messenger-avatar", alt: other.name %>
                <% else %>
                  <div class="messenger-avatar-placeholder">
                    <%= other.name&.first&.upcase %>
                  </div>
                <% end %>
                <span class="messenger-online-dot <%= other.online? ? 'online' : 'offline' %>"
                      data-user-id="<%= other.id %>"></span>
              </div>
              <div class="messenger-conversation-info">
                <div class="messenger-conversation-top">
                  <span class="messenger-conversation-name"><%= other.name %></span>
                  <span class="messenger-conversation-time">
                    <%= last_msg ? time_ago_in_words(last_msg.created_at) : '' %>
                  </span>
                </div>
                <div class="messenger-conversation-bottom">
                  <span class="messenger-last-message">
                    <% if last_msg %>
                      <% if last_msg.deleted %>
                        <em>Message deleted</em>
                      <% elsif last_msg.message_type != 'text' %>
                        📎 <%= last_msg.message_type.capitalize %>
                      <% else %>
                        <%= truncate(last_msg.body, length: 35) %>
                      <% end %>
                    <% end %>
                  </span>
                  <% if unread > 0 %>
                    <span class="messenger-unread-badge"><%= unread %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= button_to conversation_path(conversation),
                  method: :delete,
                  class: "messenger-conv-delete-btn",
                  title: "Delete conversation",
                  data: { turbo: false },
                  form: { onsubmit: "return confirm('Delete this conversation? This cannot be undone.')" } do %>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                <path d="M6.5 1.5h3a.5.5 0 010 1h-3a.5.5 0 010-1zM2 3.5h12l-.9 9.5a1 1 0 01-1 .9H3.9a1 1 0 01-1-.9L2 3.5zm3 2v5.5h1V5.5H5zm3 0v5.5h1V5.5H8zm3 0v5.5h1V5.5h-1z"/>
              </svg>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Right Panel: Empty State (when no conversation selected) -->
  <div class="messenger-main messenger-welcome" id="messengerMain">
    <div class="messenger-welcome-card">
      <div class="messenger-welcome-glow"></div>
      <div class="messenger-welcome-icon-wrapper">
        <div class="messenger-welcome-icon-bg">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke="url(#chatIconGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <defs>
              <linearGradient id="chatIconGrad" x1="3" y1="3" x2="21" y2="21" gradientUnits="userSpaceOnUse">
                <stop stop-color="#667eea"/>
                <stop offset="1" stop-color="#764ba2"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
      <h2 class="messenger-welcome-title">Your Messages</h2>
      <p class="messenger-welcome-subtitle">Send private messages, voice notes & files to your friends in real-time</p>
      
      <button class="btn-start-chat" id="startNewChatBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="15" y2="12"></line>
        </svg>
        <span>Start a new chat</span>
      </button>

      <div class="messenger-welcome-features">
        <div class="messenger-feature-chip">
          <span class="feature-chip-icon">🔒</span>
          <span>Private & Secure</span>
        </div>
        <div class="messenger-feature-chip">
          <span class="feature-chip-icon">✨</span>
          <span>AI Assist</span>
        </div>
        <div class="messenger-feature-chip">
          <span class="feature-chip-icon">🎙️</span>
          <span>Voice Notes</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- New Message Modal -->
<div class="messenger-modal-overlay" id="newMessageModal" style="display:none;">
  <div class="messenger-modal">
    <div class="messenger-modal-header">
      <h3>New Message</h3>
      <button class="messenger-modal-close" id="closeNewMessageModal">✕</button>
    </div>
    <div class="messenger-modal-search">
      <input type="text" placeholder="Search friends..." id="friendSearch" class="messenger-friend-search">
    </div>
    <div class="messenger-friends-list" id="friendsList">
      <!-- Populated via JS -->
    </div>
  </div>
</div>

<script>
  window.CHAT_DATA = {
    currentUserId: <%= current_user.id %>,
    conversationsPath: "<%= conversations_path %>",
    isListPage: true
  };
  document.dispatchEvent(new Event("chat:data-ready"));
</script>
