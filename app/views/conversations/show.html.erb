<% content_for :title, "Chat with #{@other_user.name} - Sangam" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<%= render 'shared/header' %>

<div class="messenger-layout" id="messengerLayout">
  <!-- Left Sidebar -->
  <div class="messenger-sidebar" id="messengerSidebar">
    <div class="messenger-sidebar-header">
      <h1 class="messenger-title">Chats</h1>
      <button class="messenger-icon-btn" title="New Message" id="newMessageBtn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M17.5 2.5a2.121 2.121 0 00-3 0L3 14l-.5 3.5 3.5-.5L17.5 5.5a2.121 2.121 0 000-3z"/>
        </svg>
      </button>
    </div>
    <div class="messenger-search-box">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="messenger-search-icon">
        <path d="M10.917 10.917a6.5 6.5 0 111.414-1.414l4.242 4.242a1 1 0 01-1.414 1.414l-4.242-4.242z"/>
      </svg>
      <input type="text" placeholder="Search Messenger" class="messenger-search-input" id="conversationSearch">
    </div>
    <div class="messenger-conversations-list" id="conversationsList">
      <% current_user.conversations.includes(:sender, :recipient).each do |conv| %>
        <% other = conv.other_participant(current_user) %>
        <% unread = conv.unread_count_for(current_user) %>
        <% last_msg = conv.last_message %>
        <div class="messenger-conversation-item-wrapper"
             data-conv-id="<%= conv.id %>"
             data-conv-url="<%= conversation_path(conv) %>">
          <%= link_to conversation_path(conv),
                      class: "messenger-conversation-item #{'active' if conv.id == @conversation.id} #{'unread' if unread > 0}",
                      data: { conversation_id: conv.id, turbo: false } do %>
            <div class="messenger-avatar-wrapper">
              <% if other.avatar.attached? %>
                <%= image_tag url_for(other.avatar), class: "messenger-avatar", alt: other.name %>
              <% else %>
                <div class="messenger-avatar-placeholder"><%= other.name&.first&.upcase %></div>
              <% end %>
              <span class="messenger-online-dot <%= other.online? ? 'online' : 'offline' %>"
                    data-user-id="<%= other.id %>"></span>
            </div>
            <div class="messenger-conversation-info">
              <div class="messenger-conversation-top">
                <span class="messenger-conversation-name"><%= other.name %></span>
                <span class="messenger-conversation-time">
                  <%= last_msg ? time_ago_in_words(last_msg.created_at) : '' %>
                </span>
              </div>
              <div class="messenger-conversation-bottom">
                <span class="messenger-last-message">
                  <% if last_msg %>
                    <% if last_msg.deleted %><em>Message deleted</em>
                    <% elsif last_msg.message_type != 'text' %>📎 <%= last_msg.message_type.capitalize %>
                    <% else %><%= truncate(last_msg.body, length: 35) %>
                    <% end %>
                  <% end %>
                </span>
                <% if unread > 0 %>
                  <span class="messenger-unread-badge"><%= unread %></span>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= button_to conversation_path(conv),
                method: :delete,
                class: "messenger-conv-delete-btn",
                title: "Delete conversation",
                data: { turbo: false },
                form: { onsubmit: "return confirm('Delete this conversation? This cannot be undone.')" } do %>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
              <path d="M6.5 1.5h3a.5.5 0 010 1h-3a.5.5 0 010-1zM2 3.5h12l-.9 9.5a1 1 0 01-1 .9H3.9a1 1 0 01-1-.9L2 3.5zm3 2v5.5h1V5.5H5zm3 0v5.5h1V5.5H8zm3 0v5.5h1V5.5h-1z"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Main Chat Window -->
  <div class="messenger-main" id="messengerMain">
    <div class="messenger-chat-header">
      <button class="messenger-back-btn" id="backBtn">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M12.5 15L7.5 10l5-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="messenger-chat-user" id="chatUserInfo">
        <div class="messenger-avatar-wrapper">
          <% if @other_user.avatar.attached? %>
            <%= image_tag url_for(@other_user.avatar), class: "messenger-avatar", alt: @other_user.name %>
          <% else %>
            <div class="messenger-avatar-placeholder"><%= @other_user.name&.first&.upcase %></div>
          <% end %>
          <span class="messenger-online-dot <%= @other_user.online? ? 'online' : 'offline' %>"
                id="headerOnlineDot" data-user-id="<%= @other_user.id %>"></span>
        </div>
        <div class="messenger-chat-user-info">
          <span class="messenger-chat-user-name"><%= @other_user.name %></span>
          <span class="messenger-chat-user-status" id="chatUserStatus">
            <% if @other_user.online? %>
              <span class="status-online">Active now</span>
            <% elsif @other_user.last_seen_at %>
              Active <%= time_ago_in_words(@other_user.last_seen_at) %> ago
            <% else %>Offline<% end %>
          </span>
        </div>
      </div>
      <div class="messenger-call-actions">
        <button class="messenger-call-btn" id="audioCallBtn" title="Voice Call">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M16.5 13.5c-1 0-2-.2-2.9-.5-.3-.1-.6 0-.8.2l-1.8 1.8c-2.1-1.1-3.9-2.9-5-5l1.8-1.8c.2-.2.3-.5.2-.8-.3-.9-.5-1.9-.5-2.9 0-.6-.4-1-1-1H3c-.6 0-1 .4-1 1 0 7.7 6.3 14 14 14 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
          </svg>
        </button>
        <button class="messenger-call-btn" id="videoCallBtn" title="Video Call">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13 7V5a1 1 0 00-1-1H3a1 1 0 00-1 1v10a1 1 0 001 1h9a1 1 0 001-1v-2l4 3V4l-4 3z"/>
          </svg>
        </button>
        <button class="messenger-call-btn" id="chatInfoBtn" title="Info">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M10 9v5M10 7v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages Area -->
    <div class="messenger-messages-area" id="messagesArea">
      <div class="messenger-load-more" id="loadMoreBtn" style="display:none;">
        <button onclick="chatApp.loadMoreMessages()">Load earlier messages</button>
      </div>
      <div class="messenger-messages-list" id="messagesList">
        <% @messages.each do |message| %>
          <%= render 'message', message: message, current_user: current_user %>
        <% end %>
      </div>
      <div class="messenger-typing-indicator" id="typingIndicator" style="display:none;">
        <div class="messenger-avatar-wrapper" style="width:28px;height:28px;">
          <% if @other_user.avatar.attached? %>
            <%= image_tag url_for(@other_user.avatar), class: "messenger-avatar", style: "width:28px;height:28px;" %>
          <% else %>
            <div class="messenger-avatar-placeholder" style="width:28px;height:28px;font-size:12px;"><%= @other_user.name&.first&.upcase %></div>
          <% end %>
        </div>
        <div class="typing-dots"><span></span><span></span><span></span></div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="messenger-input-area">
      <div class="messenger-attachment-preview" id="attachmentPreview" style="display:none;">
        <div class="attachment-preview-inner" id="attachmentPreviewInner"></div>
        <button class="attachment-remove-btn" id="removeAttachment">✕</button>
      </div>
      <div class="messenger-input-row">
        <button class="messenger-attach-btn" id="attachBtn" title="Attach file">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M16.5 10.5l-7 7a4.95 4.95 0 01-7-7l7.5-7.5a3.5 3.5 0 015 5L8 15.5a2 2 0 01-2.83-2.83L11 7"/>
          </svg>
        </button>
        <button class="messenger-attach-btn" id="imageBtn" title="Send image">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="7" cy="8.5" r="1.5" fill="currentColor"/>
            <path d="M2 14l4-4 3 3 3-3 4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>
        </button>
        <button class="messenger-attach-btn messenger-gif-btn" id="gifBtn" title="Send GIF">
          <span class="gif-label">GIF</span>
        </button>
        <input type="file" id="fileInput" style="display:none;" accept="*/*">
        <input type="file" id="imageInput" style="display:none;" accept="image/*,video/*">
        <div class="messenger-text-input-wrapper">
          <textarea id="messageInput" class="messenger-text-input" placeholder="Aa" rows="1"
                    data-conversation-id="<%= @conversation.id %>"></textarea>
        </div>
        <button class="messenger-attach-btn" id="emojiBtn" title="Emoji">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="7.5" cy="8.5" r="1" fill="currentColor"/>
            <circle cx="12.5" cy="8.5" r="1" fill="currentColor"/>
            <path d="M6.5 12.5c.8 1.5 6 1.5 7 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>
        </button>
        <button class="messenger-send-btn" id="sendBtn" title="Send">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 10l16-8-8 16v-8L2 10z"/>
          </svg>
        </button>
      </div>

      <!-- GIF Picker -->
      <div class="gif-picker-modal" id="gifPickerModal" style="display:none;">
        <div class="gif-picker-header">
          <input type="text" placeholder="Search GIFs..." id="gifSearchInput" class="gif-search-input">
          <button id="closeGifPicker">✕</button>
        </div>
        <div class="gif-grid" id="gifGrid"><div class="gif-loading">Loading GIFs...</div></div>
      </div>

      <!-- Emoji Picker -->
      <div class="emoji-picker" id="emojiPicker" style="display:none;">
        <div class="emoji-grid" id="emojiGrid"></div>
      </div>
    </div>
  </div>

  <!-- Info Panel -->
  <div class="messenger-info-panel" id="chatInfoPanel" style="display:none;">
    <div class="info-panel-header">
      <button class="messenger-icon-btn" id="closeInfoPanel">✕</button>
      <h3>Conversation Info</h3>
    </div>
    <div class="info-panel-content">
      <div class="info-user-section">
        <% if @other_user.avatar.attached? %>
          <%= image_tag url_for(@other_user.avatar), class: "info-user-avatar", alt: @other_user.name %>
        <% else %>
          <div class="info-user-avatar-placeholder"><%= @other_user.name&.first&.upcase %></div>
        <% end %>
        <h4><%= @other_user.name %></h4>
        <p class="info-user-status" id="infoPanelStatus">
          <%= @other_user.online? ? 'Active now' : (@other_user.last_seen_at ? "Active #{time_ago_in_words(@other_user.last_seen_at)} ago" : 'Offline') %>
        </p>
        <%= link_to profile_path(@other_user), class: "info-profile-link" do %>View Profile<% end %>
      </div>
      <div class="info-actions">
        <button class="info-action-btn" id="infoPanelAudioCall"><div class="info-action-icon">📞</div><span>Audio</span></button>
        <button class="info-action-btn" id="infoPanelVideoCall"><div class="info-action-icon">📹</div><span>Video</span></button>
        <%= link_to profile_path(@other_user), class: "info-action-btn" do %><div class="info-action-icon">👤</div><span>Profile</span><% end %>
      </div>
      <div class="info-section">
        <h5>Shared Media</h5>
        <div class="info-shared-media" id="sharedMedia"></div>
      </div>
      <div class="info-section info-danger-section">
        <button class="info-delete-chat-btn" onclick="chatApp.deleteConversation()">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M6.5 1.5h3a.5.5 0 010 1h-3a.5.5 0 010-1zM2 3.5h12l-.9 9.5a1 1 0 01-1 .9H3.9a1 1 0 01-1-.9L2 3.5zm3 2v5.5h1V5.5H5zm3 0v5.5h1V5.5H8zm3 0v5.5h1V5.5h-1z"/>
          </svg>
          Delete Conversation
        </button>
      </div>
    </div>
  </div>
</div>


<!-- Call Modal -->
<div class="call-modal-overlay" id="callModal" style="display:none;">
  <div class="call-modal">
    <div class="call-modal-header"><span id="callModalTitle">Calling...</span></div>
    <div class="call-user-info">
      <% if @other_user.avatar.attached? %>
        <%= image_tag url_for(@other_user.avatar), class: "call-user-avatar" %>
      <% else %>
        <div class="call-user-avatar-placeholder"><%= @other_user.name&.first&.upcase %></div>
      <% end %>
      <h3 id="callUserName"><%= @other_user.name %></h3>
      <p id="callStatus">Calling...</p>
    </div>
    <div class="call-video-container" id="callVideoContainer" style="display:none;">
      <video id="remoteVideo" autoplay playsinline class="remote-video"></video>
      <video id="localVideo" autoplay playsinline muted class="local-video"></video>
    </div>
    <div class="call-controls">
      <button class="call-control-btn mute-btn" id="muteBtn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
      </button>
      <button class="call-control-btn end-call-btn" id="endCallBtn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
      </button>
      <button class="call-control-btn video-toggle-btn" id="videoToggleBtn" style="display:none;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Incoming Call -->
<div class="incoming-call-overlay" id="incomingCallModal" style="display:none;">
  <div class="incoming-call-modal">
    <div class="incoming-call-info">
      <% if @other_user.avatar.attached? %>
        <%= image_tag url_for(@other_user.avatar), class: "incoming-call-avatar" %>
      <% else %>
        <div class="incoming-call-avatar-placeholder"><%= @other_user.name&.first&.upcase %></div>
      <% end %>
      <h3><%= @other_user.name %></h3>
      <p id="incomingCallType">Incoming call...</p>
    </div>
    <div class="incoming-call-actions">
      <button class="incoming-reject-btn" id="rejectCallBtn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
      </button>
      <button class="incoming-accept-btn" id="acceptCallBtn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- CHAT DATA — must be last, fires chat:data-ready event -->
<script>
  window.CHAT_DATA = {
    currentUserId:   <%= current_user.id %>,
    conversationId:  <%= @conversation.id %>,
    otherUserId:     <%= @other_user.id %>,
    otherUserName:   "<%= j @other_user.name %>",
    otherUserOnline: <%= @other_user.online? %>,
    messagesPath:    "<%= conversation_messages_path(@conversation) %>",
    conversationsPath: "<%= conversations_path %>",
    loadMorePath:    "<%= messages_conversation_path(@conversation) %>"
  };
  // Mobile: add chat-open so main panel is visible instead of sidebar
  var layout = document.getElementById("messengerLayout");
  if (layout) layout.classList.add("chat-open");
  document.dispatchEvent(new Event("chat:data-ready"));
</script>
