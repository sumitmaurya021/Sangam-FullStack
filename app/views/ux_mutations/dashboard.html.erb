<div class="feed-container">
  <%= render 'shared/header' %>

  <div class="dt-container">
    <%# Backdrop Glows %>
    <div class="premium-backdrop-glow blur-purple" style="position: absolute; width: 400px; height: 400px; background: rgba(168, 85, 247, 0.15); filter: blur(100px); border-radius: 50%; pointer-events: none;"></div>

    <%# Top Header Card %>
    <div class="dt-header-card">
      <div class="dt-header-title-group">
        <div class="dt-header-icon" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(99, 102, 241, 0.15)); border-color: rgba(168, 85, 247, 0.3);">✨</div>
        <div>
          <h1 class="dt-header-title">Self-Evolving UX & Funnel Intelligence</h1>
          <p class="dt-header-subtitle">Real-time friction analytics, form abandonment telemetry, and automated layout mutation metrics.</p>
        </div>
      </div>

      <div class="dt-status-pill-box">
        <div>
          <span style="display: block; font-size: 11px; text-transform: uppercase; font-weight: 700; color: #64748b;">Engine Mode</span>
          <span class="dt-status-indicator active">
            <span class="dt-pulse-dot" style="background: #a855f7; box-shadow: 0 0 10px #a855f7;"></span>
            Auto-Mutation Active
          </span>
        </div>
      </div>
    </div>

    <%# Metrics Overview Grid %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <div class="dt-card" style="margin-bottom: 0;">
        <span class="dt-form-label">Total Telemetry Events</span>
        <div style="font-size: 32px; font-weight: 900; color: #6366f1; margin-top: 4px;"><%= @total_events %></div>
        <span style="font-size: 12px; color: #94a3b8;">Recorded across platform routes</span>
      </div>

      <div class="dt-card" style="margin-bottom: 0;">
        <span class="dt-form-label">Friction Signals</span>
        <div style="font-size: 32px; font-weight: 900; color: #f59e0b; margin-top: 4px;"><%= @friction_events_count %></div>
        <span style="font-size: 12px; color: #94a3b8;">Form abandonments & hesitations</span>
      </div>

      <div class="dt-card" style="margin-bottom: 0;">
        <span class="dt-form-label">Active Layout Modes</span>
        <div style="font-size: 14px; font-weight: 700; color: var(--text-color, #0f172a); margin-top: 8px;">
          <% @mode_counts.each do |mode, count| %>
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <span><%= mode.humanize %>:</span>
              <strong style="color: #a855f7;"><%= count %> users</strong>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Main Content Grid %>
    <div class="dt-grid">
      <div>
        <%# Friction Routes Panel %>
        <div class="dt-card">
          <h2 class="dt-card-title">
            <span style="font-size: 20px;">🔥</span> Top High-Friction Page Routes
          </h2>

          <% if @top_friction_routes.empty? %>
            <div style="text-align: center; padding: 20px; color: #94a3b8; font-size: 13px;">
              No high-friction routes detected. Form abandonments and hesitations will automatically populate here.
            </div>
          <% else %>
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <% @top_friction_routes.each do |route, count| %>
                <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-log, #f8fafc); border: 1px solid var(--border-log, #e2e8f0); border-radius: 12px; padding: 12px 16px;">
                  <span style="font-family: monospace; font-size: 13px; font-weight: 700; color: #6366f1;"><%= route %></span>
                  <span class="dt-badge dt-badge-blocked"><%= count %> Friction Events</span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Telemetry Audit Stream %>
        <div class="dt-card">
          <h2 class="dt-card-title">
            <span style="font-size: 20px;">📡</span> Live Telemetry Audit Stream
          </h2>

          <% if @recent_events.empty? %>
            <div style="text-align: center; padding: 30px; color: #94a3b8; font-size: 13px;">
              No recent telemetry events logged yet.
            </div>
          <% else %>
            <div>
              <% @recent_events.each do |event| %>
                <div class="dt-log-item">
                  <div class="dt-log-meta">
                    <span>
                      <span class="dt-badge <%= event.event_type == 'form_abandonment' ? 'dt-badge-error' : 'dt-badge-blocked' %>"><%= event.event_type.humanize %></span>
                      <strong style="margin-left: 8px; color: var(--text-color, #0f172a);"><%= event.page_route %></strong>
                    </span>
                    <span style="font-size: 11px;"><%= event.created_at.strftime("%H:%M:%S") %></span>
                  </div>
                  <div style="font-size: 12px; color: var(--text-muted, #64748b);">
                    Duration: <%= event.duration_ms %>ms | User: <%= event.user&.display_name || 'Guest' %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Right Column: AI Recommendations & Manual Controls %>
      <div>
        <div class="dt-card">
          <h2 class="dt-card-title">
            <span style="font-size: 20px;">🤖</span> AI Funnel Recommendations
          </h2>

          <div style="background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.25); border-radius: 14px; padding: 16px; margin-bottom: 16px;">
            <strong style="display: block; font-size: 13px; color: #a855f7; margin-bottom: 4px;">Automated Form Simplification</strong>
            <p style="font-size: 12px; color: var(--text-muted, #64748b); line-height: 1.5; margin: 0;">
              The engine automatically mutates multi-input marketplace forms into single-step AI voice wizards for users with friction scores >= 5.0.
            </p>
          </div>

          <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 14px; padding: 16px;">
            <strong style="display: block; font-size: 13px; color: #6366f1; margin-bottom: 4px;">Power User Density Tuning</strong>
            <p style="font-size: 12px; color: var(--text-muted, #64748b); line-height: 1.5; margin: 0;">
              High-velocity users with >50 actions and zero abandonments are automatically assigned high-density table layouts to maximize productivity.
            </p>
          </div>
        </div>

        <%# Your Personal UX Preference %>
        <div class="dt-card">
          <h2 class="dt-card-title">
            <span style="font-size: 20px;">🎨</span> Your Layout Mode
          </h2>

          <%= form_with(model: (current_user.ux_mutation_preference || current_user.build_ux_mutation_preference), url: ux_mutation_path, method: :patch) do |f| %>
            <div class="dt-form-group">
              <%= f.label :layout_mode, "Select Layout Mode", class: "dt-form-label" %>
              <%= f.select :layout_mode, [["Standard Adaptive", "standard"], ["Minimalist Studio (Simplified)", "minimalist"], ["Power Density (Compact)", "power_density"], ["Voice First AI", "voice_first"]], {}, class: "dt-select" %>
            </div>

            <div class="dt-form-group">
              <label class="dt-checkbox-label">
                <%= f.check_box :auto_adapt, style: "accent-color: #a855f7; width: 16px; height: 16px;" %>
                Allow AI to Auto-Mutate Layout
              </label>
            </div>

            <%= f.submit "Update My UX Preference", class: "dt-btn-save", style: "width: 100%; margin-top: 8px; background: linear-gradient(135deg, #a855f7, #6366f1);" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
