<div class="profile-container">
  <%= render 'shared/header' %>

  <div class="follows-page">
    <div class="follows-header">
      <%= link_to profile_path(@user), class: 'follows-back-link' do %>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        Back to Profile
      <% end %>
      <h1 class="follows-title">
        <%= @user.name %>'s Followers
        <span class="follows-count">(<%= @followers.total_count %>)</span>
      </h1>
    </div>

    <div class="follows-list">
      <% if @followers.any? %>
        <% @followers.each do |follower_user| %>
          <div class="follow-item">
            <%= link_to profile_path(follower_user), class: 'follow-item__avatar' do %>
              <% if follower_user.avatar.attached? %>
                <%= image_tag follower_user.avatar, alt: follower_user.name %>
              <% else %>
                <%= follower_user.name&.first&.upcase || 'U' %>
              <% end %>
            <% end %>

            <div class="follow-item__info">
              <%= link_to follower_user.name || follower_user.email, profile_path(follower_user), class: 'follow-item__name' %>
              <% if follower_user.bio.present? %>
                <p class="follow-item__bio"><%= follower_user.bio.truncate(60) %></p>
              <% end %>
              <p class="follow-item__meta">
                <span><%= follower_user.followers_count %> followers</span>
                <span class="follow-item__dot">·</span>
                <span><%= follower_user.posts.count %> posts</span>
              </p>
            </div>

            <div class="follow-item__action">
              <% if follower_user != current_user %>
                <%= render 'follows/button', user: follower_user %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Pagination %>
        <div class="follows-pagination">
          <%= link_to_unless @followers.first_page?, '← Prev',
                profile_followers_path(@user, page: @followers.prev_page),
                class: 'pagination-btn' %>
          <%= link_to_unless @followers.last_page?, 'Next →',
                profile_followers_path(@user, page: @followers.next_page),
                class: 'pagination-btn' %>
        </div>
      <% else %>
        <div class="follows-empty">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="#d1d5db">
            <circle cx="32" cy="20" r="12" fill="currentColor"/>
            <path d="M8 56c0-13.255 10.745-24 24-24s24 10.745 24 24" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
          </svg>
          <p><%= @user == current_user ? "You don't" : "#{@user.name} doesn't" %> have any followers yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= stylesheet_link_tag 'profiles/show', 'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'profiles/friends', 'data-turbo-track': 'reload' %>
