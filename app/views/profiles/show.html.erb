<div class="profile-container">
  <%= render 'shared/header' %>

  <!-- Cinematic Cover Photo -->
  <div class="cover-photo">
    <% if @user.cover_photo.present? %>
      <%= image_tag @user.cover_photo, alt: 'Cover photo' %>
    <% end %>
  </div>

  <!-- Profile Info Section - Floating Card -->
  <div class="profile-info-section">
    <div class="profile-info-card">
      <div class="profile-header-layout">
        <!-- Large Animated Avatar -->
        <div class="profile-avatar-large">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, alt: "#{@user.name || @user.email} profile photo" %>
          <% else %>
            <%= @user.name&.first&.upcase || 'U' %>
          <% end %>
        </div>
        
        <!-- Profile Details -->
        <div class="profile-details-main">
          <h1 class="profile-name"><%= @user.name || @user.email %></h1>
          
          <% if @user.bio.present? %>
            <p class="profile-bio"><%= @user.bio %></p>
          <% end %>
          
          <!-- Horizontal Stats -->
          <div class="profile-stats-row">
            <div class="stat-item">
              <span class="stat-value"><%= @posts_count %></span>
              <span class="stat-label">Posts</span>
            </div>
            <div class="stat-item">
              <span class="stat-value"><%= @friends_count %></span>
              <span class="stat-label">Friends</span>
            </div>
          </div>
          
          <!-- Action Buttons -->
          <div class="profile-actions">
            <% if @user == current_user %>
              <%= link_to edit_user_registration_path, class: 'btn-profile-action' do %>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                </svg>
                Edit Profile
              <% end %>
            <% elsif current_user.friends_with?(@user) %>
              <% friendship = current_user.friendships.find_by(friend: @user) || @user.friendships.find_by(friend: current_user) %>
              <%= button_to friendship_path(friendship), method: :delete, class: 'btn-profile-action btn-unfriend', data: { confirm: 'Remove friend?' } do %>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M11 6a3 3 0 11-6 0 3 3 0 016 0zM14 17a6 6 0 00-12 0h12zM13 8a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V8z"/>
                </svg>
                Unfriend
              <% end %>
            <% elsif current_user.friend_request_pending?(@user) %>
              <button class="btn-profile-action btn-pending" disabled>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                Request Pending
              </button>
            <% else %>
              <%= button_to friendships_path(friend_id: @user.id), class: 'btn-profile-action btn-add-friend' do %>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/>
                </svg>
                Add Friend
              <% end %>
            <% end %>
            
            <%= link_to profile_friends_path(@user), class: 'btn-profile-action btn-secondary' do %>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
              </svg>
              View Friends
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Timeline Posts - Facebook Style -->
  <div class="profile-content">
    <h2 class="section-title">Posts</h2>
    
    <% if @posts.any? %>
      <div class="timeline-posts">
        <% @posts.each do |post| %>
          <article class="timeline-post-card" id="post-<%= post.id %>">
            <!-- Post Header -->
            <div class="post-header-timeline">
              <div class="post-avatar-timeline">
                <% if post.user.avatar.attached? %>
                  <%= image_tag post.user.avatar, alt: "#{post.user.name || post.user.email} avatar" %>
                <% else %>
                  <%= post.user.name&.first&.upcase || 'U' %>
                <% end %>
              </div>
              <div class="post-meta-timeline">
                <h3 class="post-author-name"><%= post.user.name || post.user.email %></h3>
                <span class="post-time-timeline">
                  <%= time_ago_in_words(post.created_at) %> ago
                </span>
              </div>
              <% if post.user == current_user %>
                <%= button_to post_path(post), method: :delete, class: 'btn-delete-post', data: { confirm: 'Delete this post?' } do %>
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
            
            <!-- Post Content -->
            <div class="post-content-timeline">
              <p><%= post.content %></p>
              <% if post.image.present? %>
                <div class="post-image-timeline">
                  <%= image_tag post.image, alt: 'Post image' %>
                </div>
              <% end %>
            </div>
            
            <!-- Post Stats -->
            <div class="post-stats-timeline">
              <div class="stats-left">
                <div class="reaction-icons">
                  <span class="reaction-icon">👍</span>
                  <span class="reaction-icon love">❤️</span>
                </div>
                <span class="likes-count"><%= post.likes_count %> likes</span>
              </div>
              <div class="stats-right">
                <span class="stat-link"><%= post.comments_count %> comments</span>
                <span class="stat-link"><%= post.shares_count %> shares</span>
              </div>
            </div>
            
            <!-- Post Actions -->
            <div class="post-actions-timeline">
              <%= button_to like_post_path(post), method: :post, class: "action-btn-timeline #{current_user.liked?(post) ? 'active' : ''}" do %>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
                </svg>
                <span>Like</span>
              <% end %>
              
              <button class="action-btn-timeline">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
                </svg>
                <span>Comment</span>
              </button>
              
              <%= button_to share_post_path(post), method: :post, class: 'action-btn-timeline' do %>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
                </svg>
                <span>Share</span>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state-timeline">
        <svg width="80" height="80" viewBox="0 0 64 64" fill="#ccc">
          <path d="M32 4C16.536 4 4 16.536 4 32s12.536 28 28 28 28-12.536 28-28S47.464 4 32 4zm0 52c-13.234 0-24-10.766-24-24S18.766 8 32 8s24 10.766 24 24-10.766 24-24 24z"/>
          <path d="M32 16a4 4 0 100 8 4 4 0 000-8zm-2 14h4v16h-4V30z"/>
        </svg>
        <h3>No posts yet</h3>
        <p>When <%= @user.name || @user.email %> posts, you'll see them here.</p>
      </div>
    <% end %>
  </div>
</div>

<%= stylesheet_link_tag 'profiles/show', 'data-turbo-track': 'reload' %>
