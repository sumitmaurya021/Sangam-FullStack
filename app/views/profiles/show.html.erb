<div class="profile-container">
  <%= render 'shared/header' %>

  <!-- Premium Cover Photo Section -->
  <div class="premium-cover-wrapper">
    <div class="cover-photo">
      <% if @user.cover_photo.present? %>
        <%= image_tag @user.cover_photo, alt: 'Cover photo' %>
      <% else %>
        <div class="cover-photo-placeholder"></div>
      <% end %>
    </div>
    <div class="cover-glass-overlay"></div>
  </div>

  <!-- Main Asymmetric Dashboard Grid -->
  <div class="profile-dashboard-grid">
    
    <!-- LEFT SIDEBAR: User Details & Stats Card -->
    <div class="profile-sidebar-column">
      
      <!-- Primary Glass Profile Card -->
      <div class="premium-glass-card profile-main-card animate-fade-in">
        <div class="profile-avatar-outer-ring">
          <div class="profile-avatar-large">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, alt: "#{@user.name} profile photo" %>
            <% else %>
              <%= @user.name&.first&.upcase || 'U' %>
            <% end %>
          </div>
          <% if @user.online %>
            <div class="profile-online-badge-glow" title="Online now"></div>
          <% end %>
        </div>

        <div class="profile-identity-info">
          <div class="profile-name-row">
            <h1 class="profile-name"><%= @user.name || @user.email %></h1>
            <% if @user.verified? %>
              <span class="premium-verified-badge" title="Verified Member">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </span>
            <% end %>
            <% if @user.birthday_today? %>
              <span class="premium-birthday-badge" title="Birthday today! 🎂">🎂</span>
            <% end %>
          </div>

          <% if @user.bio.present? %>
            <p class="profile-bio"><%= @user.bio %></p>
          <% end %>
        </div>

        <!-- Premium Interactive Stats Grid -->
        <div class="premium-stats-grid">
          <div class="premium-stat-box">
            <span class="stat-value"><%= @posts_count %></span>
            <span class="stat-label">Posts</span>
          </div>
          <div class="premium-stat-box">
            <span class="stat-value"><%= @friends_count %></span>
            <span class="stat-label">Friends</span>
          </div>
          <%= link_to profile_followers_path(@user), class: 'premium-stat-box premium-stat-box--link' do %>
            <span class="stat-value" id="followers_count_<%= @user.id %>"><%= @followers_count %></span>
            <span class="stat-label">Followers</span>
          <% end %>
          <%= link_to profile_following_path(@user), class: 'premium-stat-box premium-stat-box--link' do %>
            <span class="stat-value"><%= @following_count %></span>
            <span class="stat-label">Following</span>
          <% end %>
        </div>

        <!-- Extra Meta Info (Location, Website, etc.) -->
        <div class="premium-meta-info-list">
          <% if @user.location.present? %>
            <div class="meta-info-item">
              <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span><%= @user.location %></span>
            </div>
          <% end %>
          <% if @user.website_url.present? %>
            <div class="meta-info-item">
              <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span><%= link_to @user.website_url.sub(/https?:\/\//, ''), @user.website_url, target: '_blank', rel: 'noopener noreferrer', class: 'premium-profile-link' %></span>
            </div>
          <% end %>
          <% if @user.birthday.present? && @user != current_user %>
            <div class="meta-info-item">
              <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              <span>Birthday: <%= @user.birthday.strftime('%B %d') %></span>
            </div>
          <% end %>
          <div class="meta-info-item">
            <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Joined <%= @user.created_at.strftime('%B %Y') %></span>
          </div>
        </div>

        <!-- Mutual Friends Card Integration inside card -->
        <% if @mutual_friends.any? %>
          <div class="premium-mutual-card">
            <span class="mutual-title">Mutual Friends</span>
            <div class="mutual-friends-row">
              <div class="mutual-friends-avatars">
                <% @mutual_friends.first(5).each do |mf| %>
                  <div class="mutual-friend-avatar" title="<%= mf.name %>">
                    <% if mf.avatar.attached? %>
                      <%= image_tag mf.avatar, alt: mf.name %>
                    <% else %>
                      <%= mf.name&.first&.upcase %>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <span class="mutual-friends-text">
                <%= @mutual_friends.count %> mutual friend<%= @mutual_friends.count == 1 ? '' : 's' %>
              </span>
            </div>
          </div>
        <% end %>

        <!-- Elegant Call to Action Buttons -->
        <div class="premium-actions-area">
          <% if @user == current_user %>
            <%= link_to edit_user_registration_path, class: 'premium-btn premium-btn-primary full-width' do %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"></path></svg>
              <span>Edit Profile</span>
            <% end %>
          <% elsif current_user.friends_with?(@user) %>
            <% friendship = current_user.friendships.find_by(friend: @user) || @user.friendships.find_by(friend: current_user) %>
            <%= button_to friendship_path(friendship), method: :delete, class: 'premium-btn premium-btn-danger full-width', data: { confirm: 'Remove friend?' } do %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="23" y1="11" x2="17" y2="11"></line></svg>
              <span>Unfriend</span>
            <% end %>
          <% elsif current_user.friend_request_pending?(@user) %>
            <button class="premium-btn premium-btn-warning full-width" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>Request Pending</span>
            </button>
          <% else %>
            <%= button_to friendships_path(friend_id: @user.id), class: 'premium-btn premium-btn-success full-width' do %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="17" y1="11" x2="23" y2="11"></line></svg>
              <span>Add Friend</span>
            <% end %>
          <% end %>

          <div class="premium-btn-group">
            <% if @user != current_user %>
              <%= render 'follows/button', user: @user %>
            <% end %>

            <% if @user != current_user %>
              <button class="premium-btn <%= @is_close_friend ? 'premium-btn-star-active' : 'premium-btn-star' %>"
                      id="close-friend-btn-<%= @user.id %>"
                      onclick="toggleCloseFriend(<%= @user.id %>, this)"
                      title="<%= @is_close_friend ? 'Remove from Close Friends' : 'Add to Close Friends' %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg>
                <span><%= @is_close_friend ? 'Close Friend' : 'Close Friend' %></span>
              </button>
            <% end %>

            <%= link_to profile_friends_path(@user), class: 'premium-btn premium-btn-glass' do %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>Friends</span>
            <% end %>

            <% if @user != current_user %>
              <%= button_to conversations_path(recipient_id: @user.id),
                            method: :post,
                            class: 'premium-btn premium-btn-blue',
                            form: { data: { turbo: false }, class: 'chat-btn-form' } do %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <span>Message</span>
              <% end %>
            <% end %>
          </div>
        </div>

      </div>

    </div>

    <!-- RIGHT MAIN CONTENT: Highlights, Analytics, and Feed -->
    <div class="profile-main-column">
      
      <!-- Instagram-Style Premium highlights -->
      <% if @highlights.any? || @user == current_user %>
        <div class="premium-glass-card highlights-card animate-fade-in delay-1">
          <h3 class="card-inline-title">Highlights</h3>
          <div class="premium-highlights-row" id="highlights-row-<%= @user.id %>">
            <% @highlights.each do |highlight| %>
              <div class="highlight-item" onclick="openHighlight(<%= highlight.id %>)" title="<%= highlight.name %>">
                <div class="highlight-circle-glow">
                  <div class="highlight-circle">
                    <% cover = highlight.cover_media_url(self) %>
                    <% if cover %>
                      <img src="<%= cover %>" alt="<%= highlight.name %>">
                    <% else %>
                      <span class="highlight-emoji"><%= highlight.emoji %></span>
                    <% end %>
                  </div>
                </div>
                <span class="highlight-item__name"><%= highlight.name.truncate(12) %></span>
              </div>
            <% end %>

            <% if @user == current_user %>
              <div class="highlight-item highlight-item--new" onclick="createHighlightPrompt()" title="New Highlight">
                <div class="highlight-circle-glow highlight-circle-glow--new">
                  <div class="highlight-circle highlight-circle--new">
                    <span>+</span>
                  </div>
                </div>
                <span class="highlight-item__name">New</span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Dynamic Post Analytics for Current User -->
      <% if @user == current_user && @posts_count > 0 %>
        <div class="premium-analytics-grid animate-fade-in delay-2">
          <div class="analytics-card glass-glow-card">
            <div class="analytics-icon-wrapper views">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div class="analytics-content">
              <span class="analytics-value"><%= number_with_delimiter(@user.posts.sum(:views_count)) %></span>
              <span class="analytics-label">Total Views</span>
            </div>
          </div>
          
          <div class="analytics-card glass-glow-card">
            <div class="analytics-icon-wrapper likes">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </div>
            <div class="analytics-content">
              <span class="analytics-value"><%= number_with_delimiter(@user.posts.sum(:likes_count)) %></span>
              <span class="analytics-label">Total Likes</span>
            </div>
          </div>

          <div class="analytics-card glass-glow-card">
            <div class="analytics-icon-wrapper comments">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            <div class="analytics-content">
              <span class="analytics-value"><%= number_with_delimiter(@user.posts.sum(:comments_count)) %></span>
              <span class="analytics-label">Comments</span>
            </div>
          </div>

          <div class="analytics-card glass-glow-card">
            <div class="analytics-icon-wrapper shares">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
            </div>
            <div class="analytics-content">
              <span class="analytics-value"><%= number_with_delimiter(@user.posts.sum(:shares_count)) %></span>
              <span class="analytics-label">Shares</span>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Timeline Posts Section -->
      <div class="profile-feed-container animate-fade-in delay-3">
        <div class="feed-section-header">
          <h2 class="section-title">Timeline Posts</h2>
          <div class="section-divider"></div>
        </div>
        
        <% if @posts.any? %>
          <div class="timeline-posts" id="profile-posts-feed" data-next-page="<%= @posts.next_page %>" data-loading="false">
            <%= render partial: 'posts/post_card', collection: @posts, as: :post %>
          </div>

          <div id="profile-infinite-scroll-sentinel" style="height: 10px; margin-bottom: 20px;"></div>
          <div id="profile-posts-loading-spinner" style="display: none; text-align: center; margin-top: 15px; margin-bottom: 30px;">
            <div class="posts-spinner"></div>
          </div>
        <% else %>
          <div class="premium-glass-card empty-state-timeline">
            <div class="empty-icon-glow">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <h3>No posts yet</h3>
            <p>When <%= @user.name || @user.email %> posts, their content will appear in this feed.</p>
          </div>
        <% end %>
      </div>

    </div>

  </div>
</div>

<script>
  window.toggleCloseFriend = async function(userId, btn) {
    const isActive = btn.classList.contains('premium-btn-star-active');
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const method = isActive ? 'DELETE' : 'POST';
    const url = `/close_friends/${userId}`;

    try {
      const resp = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
      });
      const data = await resp.json();
      if (data.success) {
        btn.classList.toggle('premium-btn-star-active', !isActive);
        btn.classList.toggle('premium-btn-star', isActive);
      }
    } catch(e) { console.error(e); }
  };

  window.openHighlight = async function(id) {
    try {
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
      const resp = await fetch(`/profile_highlights/${id}/stories`, {
        headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrfToken }
      });
      if (!resp.ok) { console.error('Highlight fetch failed'); return; }
      const data = await resp.json();

      if (!data.stories || data.stories.length === 0) {
        alert(`"${data.highlight?.name || 'Highlight'}" has no stories yet.`);
        return;
      }

      const group = {
        user: data.stories[0].user,
        stories: data.stories,
        all_viewed: false,
        highlight_name: data.highlight.name
      };

      if (typeof storyGroups !== 'undefined' && typeof openStoryViewer === 'function') {
        const originalGroups = [...storyGroups];
        storyGroups.unshift(group);
        openStoryViewer(0);

        const overlay = document.getElementById('storyViewerOverlay');
        const observer = new MutationObserver(() => {
          if (overlay && overlay.style.display === 'none') {
            storyGroups = originalGroups;
            observer.disconnect();
          }
        });
        if (overlay) observer.observe(overlay, { attributes: true, attributeFilter: ['style'] });
      } else {
        window.location.href = `/stories/${data.stories[0].id}`;
      }
    } catch(e) {
      console.error('openHighlight error:', e);
    }
  };

  window.createHighlightPrompt = async function() {
    const name = prompt('Highlight name (max 15 chars):');
    if (!name?.trim()) return;
    const emoji = prompt('Pick an emoji:', '⭐') || '⭐';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const resp = await fetch('/profile_highlights', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ profile_highlight: { name: name.trim().slice(0,15), emoji } })
    });
    const data = await resp.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert(data.errors?.join('\n'));
    }
  };
</script>

<%= stylesheet_link_tag 'posts/post_card',   'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'posts/feed',        'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'profiles/show',     'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'shared/marketplace','data-turbo-track': 'reload' %>
<%= javascript_include_tag 'profiles/show',  'data-turbo-track': 'reload' %>
