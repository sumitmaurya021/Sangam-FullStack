<% content_for :page_title, "AI Safety & Moderation Logs" %>

<div class="adm-welcome">
  <div>
    <h1>🛡️ AI Safety & <span>Moderation Center</span></h1>
    <p>Real-time automated content toxicity detection, flagged review queue, and audit logs.</p>
  </div>
</div>

<!-- Stats Row -->
<div class="adm-stats-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
  <div class="adm-stat-card" style="background:#1e293b; padding:18px; border-radius:12px; border:1px solid #334155;">
    <div style="font-size:0.85rem; color:#94a3b8;">Total AI Scans</div>
    <div style="font-size:1.8rem; font-weight:700; color:#f8fafc; margin-top:4px;"><%= @logs.total_count %></div>
  </div>
  <div class="adm-stat-card" style="background:#1e293b; padding:18px; border-radius:12px; border:1px solid #ef444433;">
    <div style="font-size:0.85rem; color:#f87171;">Blocked Items</div>
    <div style="font-size:1.8rem; font-weight:700; color:#ef4444; margin-top:4px;"><%= AiModerationLog.blocked.count %></div>
  </div>
  <div class="adm-stat-card" style="background:#1e293b; padding:18px; border-radius:12px; border:1px solid #f59e0b33;">
    <div style="font-size:0.85rem; color:#fbbf24;">Pending Review Queue</div>
    <div style="font-size:1.8rem; font-weight:700; color:#f59e0b; margin-top:4px;"><%= @flagged_posts.count + @flagged_comments.count %></div>
  </div>
</div>

<!-- Pending Flagged Content Queue -->
<% if @flagged_posts.any? || @flagged_comments.any? %>
  <div class="adm-table-card" style="margin-bottom:24px; border:1px solid #f59e0b66;">
    <div class="adm-card-header" style="background:#451a03; padding:16px;">
      <div>
        <h3 style="color:#fde68a;">⚠️ Pending Flagged Review Queue</h3>
        <p style="color:#fef3c7;">Content flagged by AI requiring admin approval or removal</p>
      </div>
    </div>
    <table class="adm-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>User</th>
          <th>Content Snippet</th>
          <th>AI Flag Reason</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @flagged_posts.each do |post| %>
          <% log = AiModerationLog.find_by(target_type: "Post", target_id: post.id) %>
          <tr>
            <td><span style="background:#3b82f633; color:#60a5fa; padding:3px 8px; border-radius:6px; font-weight:600; font-size:0.8rem;">POST</span></td>
            <td><strong><%= post.user.name %></strong></td>
            <td class="adm-muted"><%= truncate(post.content.to_s, length: 60) %></td>
            <td><span style="color:#f87171; font-weight:500;"><%= post.flag_reason || "Flagged by AI Guard" %></span></td>
            <td><%= post.created_at.strftime('%b %d, %H:%M') %></td>
            <td style="display:flex; gap:8px;">
              <% if log %>
                <%= button_to "Approve", admin_approve_moderation_path(log.id), method: :post, class: "btn-approve", style: "background:#10b981; color:white; border:none; padding:4px 10px; border-radius:6px; font-size:0.8rem; cursor:pointer;" %>
                <%= button_to "Reject & Delete", admin_reject_moderation_path(log.id), method: :post, class: "btn-reject", style: "background:#ef4444; color:white; border:none; padding:4px 10px; border-radius:6px; font-size:0.8rem; cursor:pointer;" %>
              <% else %>
                <span class="adm-muted">Auto-Flagged</span>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% @flagged_comments.each do |comment| %>
          <% log = AiModerationLog.find_by(target_type: "Comment", target_id: comment.id) %>
          <tr>
            <td><span style="background:#8b5cf633; color:#a78bfa; padding:3px 8px; border-radius:6px; font-weight:600; font-size:0.8rem;">COMMENT</span></td>
            <td><strong><%= comment.user.name %></strong></td>
            <td class="adm-muted"><%= truncate(comment.content.to_s, length: 60) %></td>
            <td><span style="color:#f87171; font-weight:500;"><%= comment.flag_reason || "Flagged by AI Guard" %></span></td>
            <td><%= comment.created_at.strftime('%b %d, %H:%M') %></td>
            <td style="display:flex; gap:8px;">
              <% if log %>
                <%= button_to "Approve", admin_approve_moderation_path(log.id), method: :post, class: "btn-approve", style: "background:#10b981; color:white; border:none; padding:4px 10px; border-radius:6px; font-size:0.8rem; cursor:pointer;" %>
                <%= button_to "Reject & Delete", admin_reject_moderation_path(log.id), method: :post, class: "btn-reject", style: "background:#ef4444; color:white; border:none; padding:4px 10px; border-radius:6px; font-size:0.8rem; cursor:pointer;" %>
              <% else %>
                <span class="adm-muted">Auto-Flagged</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<!-- AI Moderation Audit Logs -->
<div class="adm-table-card" style="margin-bottom:20px">
  <div class="adm-card-header">
    <div>
      <h3>AI Moderation Audit History</h3>
      <p>Complete history of content scanned by AI Moderation Service</p>
    </div>
  </div>
  <table class="adm-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>User</th>
        <th>Target</th>
        <th>Content Snippet</th>
        <th>Toxicity Score</th>
        <th>Categories</th>
        <th>Action Taken</th>
        <th>Timestamp</th>
      </tr>
    </thead>
    <tbody>
      <% @logs.each do |log| %>
        <tr>
          <td class="adm-muted">#<%= log.id %></td>
          <td><%= log.user&.name || "System" %></td>
          <td><span style="font-weight:600; font-size:0.8rem;"><%= log.target_type || "Text" %></span></td>
          <td class="adm-muted"><%= truncate(log.content_snippet.to_s, length: 50) %></td>
          <td>
            <div style="font-weight:700; color: <%= log.toxicity_score >= 0.7 ? '#ef4444' : (log.toxicity_score >= 0.4 ? '#f59e0b' : '#10b981') %>">
              <%= (log.toxicity_score * 100).round %>%
            </div>
          </td>
          <td><span class="adm-muted" style="font-size:0.8rem;"><%= log.flagged_categories.presence || "none" %></span></td>
          <td>
            <% case log.action_taken %>
            <% when "blocked" %>
              <span style="background:#ef444422; color:#ef4444; padding:3px 8px; border-radius:6px; font-weight:600; font-size:0.75rem;">BLOCKED</span>
            <% when "flagged_for_review" %>
              <span style="background:#f59e0b22; color:#f59e0b; padding:3px 8px; border-radius:6px; font-weight:600; font-size:0.75rem;">FLAGGED</span>
            <% else %>
              <span style="background:#10b98122; color:#10b981; padding:3px 8px; border-radius:6px; font-weight:600; font-size:0.75rem;">APPROVED</span>
            <% end %>
          </td>
          <td><span class="adm-time-badge"><%= log.created_at.strftime('%b %d, %H:%M') %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div style="padding:16px 0 0; display:flex; justify-content:center">
    <%= paginate @logs %>
  </div>
</div>
