<%= render 'shared/header' %>
<div class="articles-wrapper-futuristic">
  <div class="editor-container-future">
    
    <div style="margin-bottom: 30px;">
      <%= link_to article_path(@article), class: 'btn-neon-ghost' do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to Article
      <% end %>
    </div>

    <div style="margin-bottom: 40px; text-align: center;">
      <h1 class="reader-title-glow" style="margin-bottom: 10px;">Modify Parameters</h1>
      <p style="color: #94a3b8; font-size: 18px;">Update the existing knowledge core.</p>
    </div>

    <%= render 'form', article: @article %>
  </div>
</div>
<%= stylesheet_link_tag 'articles', 'data-turbo-track': 'reload' %>
