<div class="groups-page-wrapper">
  <%= render 'shared/header' %>

  <div class="groups-hero">
    <div class="groups-hero-content">
      <h1 class="groups-hero-title">Discover Communities</h1>
      <p class="groups-hero-subtitle">Join vibrant communities, share your passion, and connect with people who inspire you.</p>
      <%= link_to new_group_path, class: 'btn-hero-glass' do %>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Create Group
      <% end %>
    </div>
  </div>

  <main>
    <!-- Your Groups -->
    <div id="your-groups">
      <div class="groups-section-header">
        <h2 class="groups-section-title">Your Groups</h2>
      </div>

      <% if @my_groups.empty? %>
        <div class="groups-empty-state">
          <div class="empty-state-icon-wrapper">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3>You haven't joined any groups yet</h3>
          <p>Groups are where you connect with people who share your interests. Discover amazing communities below!</p>
        </div>
      <% else %>
        <div class="groups-grid">
          <% @my_groups.each do |group| %>
            <%= render 'groups/group_card', group: group %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Discover Groups -->
    <div id="discover">
      <div class="groups-section-header">
        <h2 class="groups-section-title">Discover Groups</h2>
      </div>

      <% if @suggested_groups.empty? %>
        <div class="groups-empty-state">
          <p>No new groups to discover right now.</p>
        </div>
      <% else %>
        <div class="groups-grid">
          <% @suggested_groups.each do |group| %>
            <%= render 'groups/group_card', group: group, show_join: true %>
          <% end %>
        </div>
      <% end %>
    </div>
  </main>
</div>
