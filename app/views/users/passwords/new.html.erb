<%= stylesheet_link_tag 'users/passwords', media: 'all' %>

<div class="auth-container">
  <div class="auth-card password-card">
    <div class="auth-header">
      <h1 class="auth-logo">Sangam</h1>
      <h2 class="auth-title">Find Your Account</h2>
      <p class="auth-subtitle">Please enter your email address to search for your account.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email address", class: 'form-input' %>
      </div>

      <div class="form-actions">
        <%= f.submit "Search", class: 'btn btn-primary' %>
        <%= link_to "Cancel", new_session_path(resource_name), class: 'btn btn-secondary' %>
      </div>
    <% end %>
  </div>
</div>
