<%= stylesheet_link_tag 'auth_premium', media: 'all', 'data-turbo-track': 'reload' %>
<script src="/assets/auth_premium.js" data-turbo-track="reload"></script>

<div class="ap-viewport">
  <!-- Dynamic Ambient Backdrop & Particle Canvas -->
  <div class="ap-ambient-bg">
    <canvas id="apCanvas" class="ap-canvas"></canvas>
    <div class="ap-glow-orb ap-glow-orb--1"></div>
    <div class="ap-glow-orb ap-glow-orb--2"></div>
    <div class="ap-glow-orb ap-glow-orb--3"></div>
  </div>
  <div class="ap-grid-overlay"></div>

  <!-- Split-Screen Container -->
  <div class="ap-split-wrapper">
    <!-- LEFT SIDE: Animated App Showcase -->
    <%= render "users/shared/showcase_panel" %>

    <!-- RIGHT SIDE: Authentication Form Panel -->
    <div class="ap-form-panel">
      <div class="ap-card">
        <div class="ap-card-border-glow"></div>

        <!-- Header -->
        <div class="ap-header">
          <h1 class="ap-title">Set new password</h1>
          <p class="ap-subtitle">Please enter a new secure password for your account</p>
        </div>

        <!-- Validation Errors -->
        <%= render "users/shared/error_messages", resource: resource %>

        <!-- Reset Password Form -->
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'ap-form' }) do |f| %>
          <%= f.hidden_field :reset_password_token %>

          <!-- New Password Input -->
          <div class="ap-form-group">
            <label class="ap-label" for="user_password">
              <span>New Password</span>
              <% if @minimum_password_length %>
                <span class="ap-strength-label">(<%= @minimum_password_length %> chars min)</span>
              <% end %>
            </label>
            <div class="ap-input-wrapper">
              <%= f.password_field :password,
                    id: 'user_password',
                    autofocus: true,
                    autocomplete: "new-password",
                    placeholder: "••••••••",
                    class: "ap-input",
                    data: { password_strength: true },
                    required: true %>
              <div class="ap-input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>
              <button type="button" class="ap-password-toggle" data-toggle-password="user_password" onclick="const inp=this.closest('.ap-input-wrapper').querySelector('input'); if(inp){ inp.type = inp.type==='password'?'text':'password'; } return false;" aria-label="Toggle password visibility">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <!-- Live Strength Meter -->
            <div class="ap-strength-meter" data-score="0">
              <div class="ap-strength-bars">
                <div class="ap-strength-bar"></div>
                <div class="ap-strength-bar"></div>
                <div class="ap-strength-bar"></div>
                <div class="ap-strength-bar"></div>
              </div>
              <span class="ap-strength-label"></span>
            </div>
          </div>

          <!-- Confirm Password Input -->
          <div class="ap-form-group">
            <label class="ap-label" for="user_password_confirmation">Confirm New Password</label>
            <div class="ap-input-wrapper">
              <%= f.password_field :password_confirmation,
                    id: 'user_password_confirmation',
                    autocomplete: "new-password",
                    placeholder: "••••••••",
                    class: "ap-input",
                    required: true %>
              <div class="ap-input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              </div>
              <button type="button" class="ap-password-toggle" data-toggle-password="user_password_confirmation" onclick="const inp=this.closest('.ap-input-wrapper').querySelector('input'); if(inp){ inp.type = inp.type==='password'?'text':'password'; } return false;" aria-label="Toggle password visibility">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <%= f.button type: :submit, class: "ap-btn-primary" do %>
            <span class="ap-btn-text">Update Password</span>
            <div class="ap-spinner"></div>
          <% end %>
        <% end %>

        <!-- Footer Switcher -->
        <div class="ap-footer">
          <%= link_to "Back to Sign In", new_session_path(resource_name), class: "ap-footer-link" %>
        </div>

        <div class="ap-copyright">
          © <%= Time.current.year %> Sangam. All rights reserved.
        </div>
      </div>
    </div>
  </div>
</div>
