<div class="edit-profile-container">
  <%= render 'shared/header' %>

  <div class="edit-profile-content-wrapper">
    
    <div class="edit-profile-dashboard">
      
      <!-- MAIN EDIT FORM COLUMN (Left side in grid) -->
      <div class="edit-profile-main-column">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true, class: 'main-edit-form' }) do |f| %>
          
          <%= render "users/shared/error_messages", resource: resource %>

          <!-- Cover Photo Section -->
          <div class="premium-glass-card cover-photo-section animate-fade-in">
            <h3 class="card-inline-title">Cover Photo</h3>
            <div class="cover-photo-preview" id="coverPreview">
              <% if current_user.cover_photo.attached? %>
                <%= image_tag current_user.cover_photo, id: 'coverImage' %>
              <% else %>
                <div class="cover-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                  <span>Add a cover photo to stand out</span>
                </div>
              <% end %>
            </div>
            
            <label class="cover-upload-btn-premium">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
              <span>Change Cover Image</span>
              <%= f.file_field :cover_photo, accept: 'image/*', class: 'file-input', onchange: 'previewCover(this)' %>
            </label>
          </div>

          <!-- Avatar & Basics Section -->
          <div class="premium-glass-card avatar-section-premium animate-fade-in delay-1">
            <h3 class="card-inline-title">Avatar & Basics</h3>
            <div class="avatar-setup-row">
              <div class="avatar-preview-container">
                <div class="avatar-preview-large" id="avatarPreview">
                  <% if current_user.avatar.attached? %>
                    <%= image_tag current_user.avatar, id: 'avatarImage' %>
                  <% else %>
                    <span class="avatar-initial"><%= current_user.name&.first&.upcase || 'U' %></span>
                  <% end %>
                </div>
                <label class="avatar-upload-btn-premium">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                  <%= f.file_field :avatar, accept: 'image/*', class: 'file-input', onchange: 'previewAvatar(this)' %>
                </label>
              </div>
              <div class="avatar-setup-info">
                <h2 class="profile-name-display"><%= current_user.name || current_user.email %></h2>
                <p class="basics-subtext">Click the camera icon to upload a square avatar image.</p>
              </div>
            </div>
          </div>

          <!-- Form Details Section -->
          <div class="premium-glass-card fields-card animate-fade-in delay-2">
            <h3 class="card-inline-title">Profile Information</h3>
            
            <div class="form-grid-premium">
              <div class="form-group-premium">
                <%= f.label :name, "Display Name" %>
                <%= f.text_field :name, class: 'form-input-premium', placeholder: 'Your display name' %>
              </div>

              <div class="form-group-premium">
                <%= f.label :email, "Email Address" %>
                <%= f.email_field :email, class: 'form-input-premium', autocomplete: "email" %>
              </div>
            </div>

            <div class="form-group-premium full-width-premium">
              <%= f.label :bio, "Short Biography" %>
              <%= f.text_area :bio, class: 'form-textarea-premium', rows: 4, placeholder: 'Write something interesting about yourself...' %>
            </div>

            <div class="form-grid-premium">
              <div class="form-group-premium">
                <%= f.label :location, "📍 Location" %>
                <%= f.text_field :location, class: 'form-input-premium', placeholder: 'City, Country' %>
              </div>
              <div class="form-group-premium">
                <%= f.label :website_url, "🔗 Website Link" %>
                <%= f.url_field :website_url, class: 'form-input-premium', placeholder: 'https://yourwebsite.com' %>
              </div>
            </div>

            <div class="form-grid-premium">
              <div class="form-group-premium">
                <%= f.label :birthday, "🎂 Birthday" %>
                <%= f.date_field :birthday, class: 'form-input-premium' %>
                <span class="help-text">Shown on profile · friends will be notified on the day</span>
              </div>
              <div class="form-group-premium toggle-wrapper-premium">
                <%= f.label :dark_mode, class: 'toggle-label-premium' do %>
                  <%= f.check_box :dark_mode, class: 'toggle-checkbox-premium', id: 'dark-mode-checkbox' %>
                  <span class="toggle-slider-premium"></span>
                  <span>🌙 Dark Mode Theme</span>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Password Setup Section -->
          <div class="premium-glass-card fields-card animate-fade-in delay-2">
            <h3 class="card-inline-title">Security & Password</h3>
            <p class="section-subtitle-premium">Leave password fields blank if you do not wish to change them.</p>

            <div class="form-grid-premium">
              <div class="form-group-premium">
                <%= f.label :password, "New Password" %>
                <%= f.password_field :password, class: 'form-input-premium', autocomplete: "new-password", placeholder: 'Min 6 characters' %>
                <% if @minimum_password_length %>
                  <span class="help-text"><%= @minimum_password_length %> characters minimum</span>
                <% end %>
              </div>

              <div class="form-group-premium">
                <%= f.label :password_confirmation, "Confirm New Password" %>
                <%= f.password_field :password_confirmation, class: 'form-input-premium', autocomplete: "new-password", placeholder: 'Retype password' %>
              </div>
            </div>

            <div class="form-divider-premium"></div>

            <div class="form-group-premium full-width-premium required-confirm-group">
              <%= f.label :current_password, "Current Password (Required)" %>
              <%= f.password_field :current_password, class: 'form-input-premium highlighted-input', autocomplete: "current-password", placeholder: 'Confirm your current password to save changes' %>
              <span class="help-text error">We require your current password to verify security modifications.</span>
            </div>
          </div>

          <!-- Form Actions Card -->
          <div class="premium-glass-card form-actions-card animate-fade-in delay-3">
            <%= f.submit "Save Modifications", class: 'premium-btn premium-btn-primary' %>
            <%= link_to "Cancel & Return", profile_path(current_user), class: 'premium-btn premium-btn-glass' %>
          </div>

        <% end %>
      </div>

      <!-- SIDEBAR COLUMN (Right side in grid for 2FA & Danger Zone) -->
      <div class="edit-profile-sidebar-column">
        
        <!-- Two-Factor Authentication (2FA) -->
        <div class="premium-glass-card security-setup-card animate-fade-in delay-1">
          <div class="tfa-header-premium">
            <div class="tfa-icon-wrapper-premium <%= 'active' if current_user.two_factor_enabled? %>">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <% if current_user.two_factor_enabled? %>
                  <path d="M9 12l2 2 4-4" stroke="#10b981" stroke-width="2.5"/>
                <% end %>
              </svg>
            </div>
            <div class="tfa-title-info">
              <h3 class="card-inline-title no-margin">Two-Factor Auth</h3>
              <% if current_user.two_factor_enabled? %>
                <span class="premium-badge-status success">Active / Enabled</span>
              <% else %>
                <span class="premium-badge-status off">Deactivated</span>
              <% end %>
            </div>
          </div>

          <div class="tfa-body-premium">
            <% if current_user.two_factor_enabled? %>
              <p class="tfa-desc-text">
                Your profile is secured using verification tokens. To disable 2FA, confirm with a 6-digit OTP code below.
              </p>

              <% if flash[:backup_codes].present? %>
                <div class="backup-codes-premium-container">
                  <h4>Emergency Backup Codes</h4>
                  <p>Save these codes in a secure vault. Each can only be used once.</p>
                  <div class="backup-codes-grid">
                    <% flash[:backup_codes].each do |code| %>
                      <code class="backup-code-item"><%= code %></code>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <%= form_with url: disable_two_factor_auth_path, method: :delete, html: { class: 'tfa-disable-form-premium' } do |f| %>
                <div class="tfa-disable-layout">
                  <%= f.text_field :otp_code,
                        placeholder: 'OTP Code',
                        class: 'form-input-premium tfa-otp-input',
                        maxlength: 7,
                        inputmode: 'numeric',
                        autocomplete: 'off',
                        required: true %>
                  <%= f.submit 'Disable',
                        class: 'premium-btn premium-btn-danger compact',
                        data: { confirm: 'Disable Two-Factor Authentication?' } %>
                </div>
              <% end %>

            <% else %>
              <p class="tfa-desc-text">
                Provide an extra lock to your account. Enter an OTP code generated by authentication apps to sign in securely.
              </p>
              <%= link_to setup_two_factor_auth_path, class: 'premium-btn premium-btn-success' do %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Setup / Enable 2FA</span>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Danger Zone Card -->
        <div class="premium-glass-card danger-zone-card animate-fade-in delay-2">
          <div class="danger-header-premium">
            <svg class="danger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <h3 class="card-inline-title no-margin danger-title">Danger Zone</h3>
          </div>
          <div class="danger-body-premium">
            <p class="danger-desc-text">
              Deleting your account is permanent. All posts, stories, messages, and friendships will be removed.
            </p>
            <%= button_to "Delete Account Permanently", registration_path(resource_name), data: { confirm: "Are you sure? This cannot be undone." }, method: :delete, class: 'premium-btn premium-btn-danger full-width' %>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  function previewCover(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('coverPreview');
        preview.innerHTML = `<img src="${e.target.result}" id="coverImage" style="width: 100%; height: 100%; object-fit: cover;">`;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function previewAvatar(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('avatarPreview');
        preview.innerHTML = `<img src="${e.target.result}" id="avatarImage" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<%= stylesheet_link_tag 'users/registrations', 'data-turbo-track': 'reload' %>
