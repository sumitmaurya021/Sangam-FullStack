<%= stylesheet_link_tag 'users/registrations', media: 'all' %>

<div class="auth-container">
  <div class="auth-card signup-card">
    <div class="auth-header">
      <h1 class="auth-logo">Sangam</h1>
      <p class="auth-subtitle">Create a new account</p>
      <p class="auth-description">It's quick and easy.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.text_field :name, autofocus: true, placeholder: "Full Name", class: 'form-input', required: true %>
      </div>

      <div class="form-group">
        <%= f.email_field :email, autocomplete: "email", placeholder: "Email address", class: 'form-input' %>
      </div>

      <div class="form-group">
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "New password", class: 'form-input' %>
        <% if @minimum_password_length %>
          <small class="form-hint">(<%= @minimum_password_length %> characters minimum)</small>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: 'form-input' %>
      </div>

      <div class="form-info">
        <p>By clicking Sign Up, you agree to our Terms, Data Policy and Cookie Policy.</p>
      </div>

      <div class="form-actions">
        <%= f.submit "Sign Up", class: 'btn btn-success' %>
      </div>
    <% end %>

    <div class="auth-footer">
      <div class="signin-prompt">
        <%= link_to "Already have an account? Log In", new_session_path(resource_name), class: 'link-primary' %>
      </div>
    </div>
  </div>
</div>
