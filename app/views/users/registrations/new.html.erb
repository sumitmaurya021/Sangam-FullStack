<%= stylesheet_link_tag 'users/sessions', media: 'all' %>

<div class="auth-container">

  <!-- LEFT IMAGE PANEL -->
  <div class="auth-image-panel">
    <div class="auth-image-bg" id="randomBg"></div>
    <div class="auth-image-overlay"></div>
    <div class="auth-image-content">
      <p class="auth-image-quote" id="randomQuote"></p>
      <p class="auth-image-attr" id="randomAttr"></p>
    </div>
  </div>

  <!-- RIGHT FORM PANEL -->
  <div class="auth-form-panel">
    <div class="auth-form-inner">
      <div class="auth-brand">
        <span class="auth-brand-logo">Sangam</span>
        <span class="auth-brand-tagline">Connect with friends and the world</span>
      </div>

      <h1 class="auth-heading">Create account</h1>
      <p class="auth-subheading">It's quick and easy.</p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <div class="form-group">
          <label class="form-label">Full Name</label>
          <%= f.text_field :name, autofocus: true, placeholder: "John Doe", class: 'form-input', required: true %>
        </div>

        <div class="form-group">
          <label class="form-label">Email Address</label>
          <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: 'form-input' %>
        </div>

        <div class="form-group">
          <label class="form-label">Password</label>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: 'form-input' %>
          <% if @minimum_password_length %>
            <small class="form-hint">(<%= @minimum_password_length %> characters minimum)</small>
          <% end %>
        </div>

        <div class="form-group">
          <label class="form-label">Confirm Password</label>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: 'form-input' %>
        </div>

        <div class="form-info">
          <p>By clicking Sign Up, you agree to our Terms, Data Policy and Cookie Policy.</p>
        </div>

        <%= f.submit "Sign Up", class: 'btn btn-success' %>
      <% end %>

      <div class="auth-footer">
        <div class="signin-prompt">
          <%= link_to "Already have an account? Log In", new_session_path(resource_name), class: 'link-primary' %>
        </div>
      </div>

      <p class="auth-panel-foot">© <%= Time.current.year %> Sangam</p>
    </div>
  </div>
</div>

<script>
  // Use turbo:load instead of DOMContentLoaded for Turbo compatibility
  document.addEventListener("turbo:load", function () {
    const quotes = [
      {
        text: "The best time to connect with someone is now.",
        attr: "— Unknown"
      },
      {
        text: "Friendship is the only cement that will ever hold the world together.",
        attr: "— Woodrow Wilson"
      },
      {
        text: "Connection is why we're here. It gives purpose and meaning to our lives.",
        attr: "— Brené Brown"
      },
      {
        text: "Alone we can do so little; together we can do so much.",
        attr: "— Helen Keller"
      },
      {
        text: "The quality of your life is the quality of your relationships.",
        attr: "— Tony Robbins"
      }
    ];

    const randomSeed = Math.floor(Math.random() * 999999999);
    const imageUrl = `https://picsum.photos/seed/${randomSeed}/2000/2500`;
    const quote = quotes[Math.floor(Math.random() * quotes.length)];

    const bg = document.getElementById("randomBg");
    const quoteEl = document.getElementById("randomQuote");
    const attrEl = document.getElementById("randomAttr");

    if (bg) {
      bg.style.backgroundImage = `url('${imageUrl}')`;
    }

    if (quoteEl) {
      quoteEl.textContent = `"${quote.text}"`;
    }

    if (attrEl) {
      attrEl.textContent = quote.attr;
    }
  });
</script>
