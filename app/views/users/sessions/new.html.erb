<!-- app/views/devise/sessions/new.html.erb -->

<%= stylesheet_link_tag 'users/sessions', media: 'all' %>

<div class="auth-container">

  <!-- LEFT IMAGE PANEL -->

  <div class="auth-image-panel">

    <div
      class="auth-image-bg"
      id="randomBg">
    </div>

    <div class="auth-image-overlay"></div>

    <div class="auth-image-content">

      <p
        class="auth-image-quote"
        id="randomQuote">
      </p>

      <p
        class="auth-image-attr"
        id="randomAttr">
      </p>

    </div>

  </div>

  <!-- RIGHT FORM PANEL -->

  <div class="auth-form-panel">

    <div class="auth-form-inner">

      <div class="auth-brand">

        <span class="auth-brand-logo">
          Sangam
        </span>

        <span class="auth-brand-tagline">
          Connect with friends and the world
        </span>

      </div>

      <h1 class="auth-heading">
        Welcome back
      </h1>

      <p class="auth-subheading">
        Sign in to continue to your account
      </p>

      <%= form_for(
            resource,
            as: resource_name,
            url: session_path(resource_name),
            html: { class: 'auth-form' }
          ) do |f| %>

        <div class="form-group">

          <label class="form-label">
            Email Address
          </label>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "you@example.com",
                class: "form-input" %>

        </div>

        <div class="form-group">

          <label class="form-label">
            Password
          </label>

          <%= f.password_field :password,
                autocomplete: "current-password",
                placeholder: "••••••••",
                class: "form-input" %>

        </div>

        <div class="auth-meta">

          <% if devise_mapping.rememberable? %>

            <div class="form-checkbox">

              <%= f.check_box :remember_me,
                    class: "checkbox-input",
                    id: "remember_me" %>

              <%= f.label :remember_me,
                    "Keep me signed in",
                    class: "checkbox-label" %>

            </div>

          <% end %>

          <%= link_to "Forgot password?",
                new_password_path(resource_name),
                class: "link-muted" %>

        </div>

        <%= f.submit "Sign in",
              class: "btn btn-primary" %>

      <% end %>

      <div class="auth-signup">

        <span class="auth-signup-text">
          Don't have an account?
        </span>

        <%= link_to "Create account",
              new_registration_path(resource_name),
              class: "btn btn-outline" %>

      </div>

      <!-- OAuth Providers -->
      <div class="auth-divider">or continue with</div>

      <div class="oauth-buttons">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
              method: :post,
              class: 'btn-oauth btn-oauth--google',
              data: { turbo: false } do %>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        <% end %>

        <%= button_to user_github_omniauth_authorize_path,
              method: :post,
              class: 'btn-oauth btn-oauth--github',
              data: { turbo: false } do %>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12"/>
          </svg>
          Continue with GitHub
        <% end %>
      </div>

    <p class="auth-panel-foot">
      © <%= Time.current.year %> Sangam
    </p>
    </div>

  </div>
</div>

<script>
  // Use turbo:load instead of DOMContentLoaded for Turbo compatibility
  document.addEventListener("turbo:load", function () {

    const quotes = [
      {
        text: "The best time to connect with someone is now.",
        attr: "— Unknown"
      },
      {
        text: "Friendship is the only cement that will ever hold the world together.",
        attr: "— Woodrow Wilson"
      },
      {
        text: "Connection is why we're here. It gives purpose and meaning to our lives.",
        attr: "— Brené Brown"
      },
      {
        text: "Alone we can do so little; together we can do so much.",
        attr: "— Helen Keller"
      },
      {
        text: "The quality of your life is the quality of your relationships.",
        attr: "— Tony Robbins"
      }
    ];

    /* UNLIMITED RANDOM IMAGES */

    const randomSeed = Math.floor(Math.random() * 999999999);

    const imageUrl =
      `https://picsum.photos/seed/${randomSeed}/2000/2500`;

    const quote =
      quotes[Math.floor(Math.random() * quotes.length)];

    const bg =
      document.getElementById("randomBg");

    const quoteEl =
      document.getElementById("randomQuote");

    const attrEl =
      document.getElementById("randomAttr");

    if (bg) {
      bg.style.backgroundImage = `url('${imageUrl}')`;
    }

    if (quoteEl) {
      quoteEl.textContent = `"${quote.text}"`;
    }

    if (attrEl) {
      attrEl.textContent = quote.attr;
    }

  });
</script>