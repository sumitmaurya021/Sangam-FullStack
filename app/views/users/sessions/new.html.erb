<%= stylesheet_link_tag 'auth_premium', media: 'all', 'data-turbo-track': 'reload' %>
<script src="/assets/auth_premium.js" data-turbo-track="reload"></script>

<div class="ap-viewport">
  <!-- Dynamic Ambient Backdrop & Particle Canvas -->
  <div class="ap-ambient-bg">
    <canvas id="apCanvas" class="ap-canvas"></canvas>
    <div class="ap-glow-orb ap-glow-orb--1"></div>
    <div class="ap-glow-orb ap-glow-orb--2"></div>
    <div class="ap-glow-orb ap-glow-orb--3"></div>
  </div>
  <div class="ap-grid-overlay"></div>

  <!-- Split-Screen Container -->
  <div class="ap-split-wrapper">
    <!-- LEFT SIDE: Animated App Showcase -->
    <%= render "users/shared/showcase_panel" %>

    <!-- RIGHT SIDE: Authentication Form Panel -->
    <div class="ap-form-panel">
      <div class="ap-card">
        <div class="ap-card-border-glow"></div>

        <!-- Header -->
        <div class="ap-header">
          <h1 class="ap-title">Welcome back</h1>
          <p class="ap-subtitle">Enter your credentials to access your Sangam account</p>
        </div>

        <!-- Flash Alerts -->
        <% if flash[:alert].present? %>
          <div class="ap-alert ap-alert--error" role="alert">
            <svg class="ap-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div><%= flash[:alert] %></div>
          </div>
        <% end %>

        <% if flash[:notice].present? %>
          <div class="ap-alert ap-alert--success" role="alert">
            <svg class="ap-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <div><%= flash[:notice] %></div>
          </div>
        <% end %>

        <!-- Login Form -->
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'ap-form', id: 'loginForm' }) do |f| %>
          
          <!-- Email Input -->
          <div class="ap-form-group">
            <label class="ap-label" for="user_email">Email Address</label>
            <div class="ap-input-wrapper">
              <%= f.email_field :email,
                    id: 'user_email',
                    autofocus: true,
                    autocomplete: "email",
                    placeholder: "name@example.com",
                    class: "ap-input",
                    required: true %>
              <div class="ap-input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
            </div>
          </div>

          <!-- Password Input -->
          <div class="ap-form-group">
            <div class="ap-label">
              <span>Password</span>
              <%- if devise_mapping.recoverable? %>
                <%= link_to "Forgot?", new_password_path(resource_name), class: "ap-label-link" %>
              <% end %>
            </div>
            <div class="ap-input-wrapper">
              <%= f.password_field :password,
                    id: 'user_password',
                    autocomplete: "current-password",
                    placeholder: "••••••••",
                    class: "ap-input",
                    required: true %>
              <div class="ap-input-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </div>
              <button type="button" class="ap-password-toggle" data-toggle-password="user_password" onclick="const inp=this.closest('.ap-input-wrapper').querySelector('input'); if(inp){ inp.type = inp.type==='password'?'text':'password'; } return false;" aria-label="Toggle password visibility">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <!-- Remember Me Checkbox -->
          <% if devise_mapping.rememberable? %>
            <div class="ap-meta-row">
              <label class="ap-checkbox-wrapper">
                <%= f.check_box :remember_me, class: "ap-checkbox-native" %>
                <span class="ap-checkbox-custom">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span>Keep me signed in</span>
              </label>
            </div>
          <% end %>

          <!-- Submit Button -->
          <%= f.button type: :submit, class: "ap-btn-primary" do %>
            <span class="ap-btn-text">Sign In to Sangam</span>
            <div class="ap-spinner"></div>
          <% end %>
        <% end %>

        <!-- Social OAuth Section -->
        <div class="ap-divider"><span>or continue with</span></div>

        <div class="ap-oauth-grid">
          <%= button_to user_google_oauth2_omniauth_authorize_path,
                method: :post,
                class: 'ap-oauth-btn',
                data: { turbo: false } do %>
            <svg viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          <% end %>

          <%= button_to user_github_omniauth_authorize_path,
                method: :post,
                class: 'ap-oauth-btn',
                data: { turbo: false } do %>
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12"/>
            </svg>
            GitHub
          <% end %>
        </div>

        <!-- Footer Switcher -->
        <div class="ap-footer">
          Don't have an account?
          <%= link_to "Create account", new_registration_path(resource_name), class: "ap-footer-link" %>
        </div>

        <div class="ap-copyright">
          © <%= Time.current.year %> Sangam. All rights reserved.
        </div>
      </div>
    </div>
  </div>
</div>