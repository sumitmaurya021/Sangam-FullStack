<div class="ap-showcase-panel" id="apShowcasePanel">
  <!-- Morphing Ambient Liquid Glow -->
  <div class="ap-liquid-aurora">
    <div class="ap-aurora-blob ap-aurora-blob--1"></div>
    <div class="ap-aurora-blob ap-aurora-blob--2"></div>
    <div class="ap-aurora-blob ap-aurora-blob--3"></div>
  </div>

  <!-- Top Badge & Brand Header -->
  <div class="ap-showcase-badge">
    <span class="ap-showcase-badge-dot"></span>
    SANGAM NEXT-GEN SOCIAL ECOSYSTEM
  </div>

  <div class="ap-showcase-brand">
    <div class="ap-brand-icon">S</div>
    <span class="ap-brand-name">Sangam</span>
  </div>

  <h1 class="ap-showcase-headline">
    Where Connections<br />
    <span>Come Alive.</span>
  </h1>

  <p class="ap-showcase-subtext">
    The world's most fluid social network powered by AI discovery, real-time messaging, and high-definition media.
  </p>

  <!-- Interactive Vercel-Style Feature Tabs -->
  <div class="ap-showcase-tabs" id="apShowcaseTabs">
    <div class="ap-tab-item is-active" data-tab="0" onclick="if(window.apSwitchTab) window.apSwitchTab(0); return false;">
      <div class="ap-tab-progress"><div class="ap-tab-progress-bar"></div></div>
      <span>✨ AI Feed</span>
    </div>
    <div class="ap-tab-item" data-tab="1" onclick="if(window.apSwitchTab) window.apSwitchTab(1); return false;">
      <div class="ap-tab-progress"><div class="ap-tab-progress-bar"></div></div>
      <span>💬 Messenger &amp; Calls</span>
    </div>
    <div class="ap-tab-item" data-tab="2" onclick="if(window.apSwitchTab) window.apSwitchTab(2); return false;">
      <div class="ap-tab-progress"><div class="ap-tab-progress-bar"></div></div>
      <span>📊 Live Stories &amp; Polls</span>
    </div>
  </div>

  <!-- SPACIOUS CRYSTAL-CLEAR SINGLE PREVIEW CARD (NO OVERLAPPING TEXT) -->
  <div class="ap-preview-viewport">
    
    <!-- FEATURE 1: AI FEED PREVIEW CARD -->
    <div class="ap-preview-card is-active" data-widget="0">
      <div class="ap-preview-card-glow"></div>
      
      <div class="ap-preview-header">
        <div class="ap-preview-user">
          <div class="ap-preview-avatar" style="background: linear-gradient(135deg, #6366f1, #d946ef);">
            <span>SM</span>
            <span class="ap-online-dot"></span>
          </div>
          <div class="ap-preview-user-info">
            <div class="ap-user-name">Sumit Maurya <span class="ap-verified-badge">✓</span></div>
            <div class="ap-user-meta">Posted 2m ago • Sangam AI Generator</div>
          </div>
        </div>
        <div class="ap-ai-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          AI Captions
        </div>
      </div>

      <p class="ap-preview-text">
        Building the next generation of social connectivity with Sangam! AI caption generation, low-latency ActionCable messaging, and zero-scroll glass design. 🚀✨
      </p>

      <div class="ap-preview-actions">
        <div class="ap-action-btn"><span class="ap-heart-icon">❤️</span> 1,428 Likes</div>
        <div class="ap-action-btn">💬 128 Comments</div>
        <div class="ap-action-btn">⚡ 94 Shares</div>
      </div>
    </div>

    <!-- FEATURE 2: MESSENGER & HD CALLS PREVIEW CARD -->
    <div class="ap-preview-card" data-widget="1">
      <div class="ap-preview-card-glow"></div>
      
      <div class="ap-preview-header">
        <div class="ap-preview-user">
          <div class="ap-preview-avatar" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
            <span>AM</span>
            <span class="ap-online-dot"></span>
          </div>
          <div class="ap-preview-user-info">
            <div class="ap-user-name">Alex Morgan</div>
            <div class="ap-user-meta">Active Encrypted WebSockets Channel</div>
          </div>
        </div>
        <div class="ap-call-pill">
          <span class="ap-recording-dot"></span>
          HD Voice Call
        </div>
      </div>

      <div class="ap-chat-bubble">
        <p>Hey! The real-time messenger feels ultra responsive ⚡</p>
        <span class="ap-chat-time">10:42 AM • Delivered</span>
      </div>

      <div class="ap-equalizer-bar">
        <span class="ap-eq-label">Active Audio Waveform</span>
        <div class="ap-eq-bars">
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
          <div class="ap-eq-col"></div>
        </div>
      </div>
    </div>

    <!-- FEATURE 3: STORIES & LIVE POLLS PREVIEW CARD -->
    <div class="ap-preview-card" data-widget="2">
      <div class="ap-preview-card-glow"></div>
      
      <div class="ap-preview-header">
        <div class="ap-preview-user">
          <div class="ap-preview-avatar" style="background: linear-gradient(135deg, #f59e0b, #ef4444);">
            <span>SG</span>
          </div>
          <div class="ap-preview-user-info">
            <div class="ap-user-name">Sangam Community Poll</div>
            <div class="ap-user-meta">1,842 Votes • Live Results</div>
          </div>
        </div>
        <div class="ap-poll-badge">LIVE POLL</div>
      </div>

      <p class="ap-poll-question">Which Sangam feature do you use most?</p>

      <div class="ap-poll-option">
        <div class="ap-poll-fill" style="width: 88%;"></div>
        <div class="ap-poll-content">
          <span>⚡ AI Captions &amp; Discovery</span>
          <span class="ap-poll-percent">88%</span>
        </div>
      </div>

      <div class="ap-poll-option">
        <div class="ap-poll-fill" style="width: 64%;"></div>
        <div class="ap-poll-content">
          <span>💬 HD Audio Messenger</span>
          <span class="ap-poll-percent">64%</span>
        </div>
      </div>
    </div>

  </div><!-- /.ap-preview-viewport -->

  <!-- Showcase Stats Bar -->
  <div class="ap-showcase-stats">
    <div class="ap-stat-item">
      <span class="ap-stat-val">100K+</span>
      <span class="ap-stat-lbl">Active Users</span>
    </div>
    <div class="ap-stat-item">
      <span class="ap-stat-val">99.9%</span>
      <span class="ap-stat-lbl">Uptime</span>
    </div>
    <div class="ap-stat-item">
      <span class="ap-stat-val">E2E</span>
      <span class="ap-stat-lbl">Encrypted</span>
    </div>
  </div>
</div>
