<%= stylesheet_link_tag 'home/dashboard', media: 'all' %>

<% if user_signed_in? %>
  <!-- Dashboard Header -->
  <header class="dashboard-header">
    <div class="header-container">
      <div class="header-left">
        <%= link_to "Sangam", root_path, class: 'header-logo' %>
        
        <div class="header-search">
          <input type="text" class="search-input" placeholder="Search Sangam">
          <span class="search-icon">🔍</span>
        </div>
      </div>

      <div class="header-right">
        <div class="header-icons">
          <button class="icon-button" title="Home">
            <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          </button>
          
          <button class="icon-button" title="Notifications">
            <svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
            <span class="notification-badge">3</span>
          </button>
        </div>

        <!-- Profile Dropdown -->
        <div class="profile-dropdown">
          <button class="profile-button" id="profileButton">
            <%= current_user.email[0].upcase %>
          </button>

          <div class="dropdown-menu" id="dropdownMenu">
            <div class="dropdown-header">
              <div class="dropdown-user">
                <div class="dropdown-avatar">
                  <%= current_user.email[0].upcase %>
                </div>
                <div class="dropdown-user-info">
                  <h3><%= current_user.email.split('@').first.capitalize %></h3>
                  <p><%= current_user.email %></p>
                </div>
              </div>
            </div>

            <div class="dropdown-divider"></div>

            <div class="dropdown-body">
              <a href="#" class="dropdown-item">
                <div class="dropdown-item-icon">
                  <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <div class="dropdown-item-text">
                  <span>View Profile</span>
                  <small>See your profile</small>
                </div>
              </a>

              <a href="#" class="dropdown-item">
                <div class="dropdown-item-icon">
                  <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                </div>
                <div class="dropdown-item-text">
                  <span>Settings</span>
                  <small>Account preferences</small>
                </div>
              </a>

              <div class="dropdown-divider"></div>

              <%= button_to destroy_user_session_path, method: :delete, class: 'dropdown-item logout', form: { style: 'display: inline;' } do %>
                <div class="dropdown-item-icon">
                  <svg viewBox="0 0 24 24"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                </div>
                <div class="dropdown-item-text">
                  <span>Log Out</span>
                  <small>Sign out of your account</small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="dropdown-overlay" id="dropdownOverlay"></div>

  <!-- Dashboard Main Content -->
  <main class="dashboard-main">
    <div class="dashboard-container">
      <!-- Left Sidebar -->
      <aside class="dashboard-sidebar">
        <nav class="sidebar-menu">
          <a href="#" class="sidebar-item">
            <div class="sidebar-item-icon">
              <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            <span><%= current_user.email.split('@').first.capitalize %></span>
          </a>

          <a href="#" class="sidebar-item">
            <div class="sidebar-item-icon">
              <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <span>Friends</span>
          </a>

          <a href="#" class="sidebar-item">
            <div class="sidebar-item-icon">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <span>Pages</span>
          </a>

          <a href="#" class="sidebar-item">
            <div class="sidebar-item-icon">
              <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
            </div>
            <span>Saved</span>
          </a>
        </nav>
      </aside>

      <!-- Feed -->
      <section class="dashboard-feed">
        <div class="welcome-card">
          <h1>Welcome, <%= current_user.email.split('@').first.capitalize %>! 👋</h1>
          <p>Connect with friends and share your moments. Start exploring your feed below.</p>
        </div>

        <!-- Add more feed content here -->
      </section>

      <!-- Right Widgets -->
      <aside class="dashboard-widgets">
        <div class="widget-card">
          <h3>Sponsored</h3>
          <p style="color: #65676b; font-size: 14px;">No ads to show</p>
        </div>

        <div class="widget-card">
          <h3>Contacts</h3>
          <p style="color: #65676b; font-size: 14px;">Your friends will appear here</p>
        </div>
      </aside>
    </div>
  </main>

  <script>
    // Profile Dropdown Toggle
    const profileButton = document.getElementById('profileButton');
    const dropdownMenu = document.getElementById('dropdownMenu');
    const dropdownOverlay = document.getElementById('dropdownOverlay');

    profileButton.addEventListener('click', function(e) {
      e.stopPropagation();
      dropdownMenu.classList.toggle('active');
      dropdownOverlay.classList.toggle('active');
    });

    dropdownOverlay.addEventListener('click', function() {
      dropdownMenu.classList.remove('active');
      dropdownOverlay.classList.remove('active');
    });

    document.addEventListener('click', function(e) {
      if (!profileButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
        dropdownMenu.classList.remove('active');
        dropdownOverlay.classList.remove('active');
      }
    });
  </script>

<% else %>
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <div style="background: white; padding: 40px; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); text-align: center; max-width: 400px;">
      <h1 style="font-size: 48px; font-weight: bold; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 20px;">Sangam</h1>
      <p style="color: #666; margin-bottom: 30px; font-size: 16px;">Connect with friends and the world around you</p>
      <%= link_to "Sign In", new_user_session_path, style: "display: inline-block; padding: 14px 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; margin-right: 10px; transition: transform 0.3s;" %>
      <%= link_to "Sign Up", new_user_registration_path, style: "display: inline-block; padding: 14px 40px; background: linear-gradient(135deg, #42e695 0%, #3bb2b8 100%); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; transition: transform 0.3s;" %>
    </div>
  </div>
<% end %>