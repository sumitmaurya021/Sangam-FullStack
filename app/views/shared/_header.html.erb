<!-- Facebook-style Header -->
<header class="fb-header">
  <div class="fb-header-content">
    <!-- Left Section: Logo & Search -->
    <div class="fb-header-left">
      <%= link_to posts_path, class: 'fb-logo-link' do %>
        <svg class="fb-logo" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
            </linearGradient>
          </defs>
          <circle cx="20" cy="20" r="20" fill="url(#logoGradient)"/>
          <path d="M20 8C15.5 8 12 10.5 12 13.5C12 15.5 13.5 17 15.5 17.5C14 18 13 19.5 13 21C13 23.5 15.5 25.5 19 26.5V28C19 29.5 17.5 30.5 15.5 30.5C13.5 30.5 12 29.5 12 28H9C9 31.5 12.5 34 16.5 34C20.5 34 24 31.5 24 28C24 26 22.5 24.5 20.5 24C22 23.5 23 22 23 20.5C23 18 20.5 16 17 15V13C17 11.5 18.5 10.5 20.5 10.5C22.5 10.5 24 11.5 24 13H27C27 9.5 23.5 8 20 8Z" fill="white"/>
          <circle cx="28" cy="12" r="2.5" fill="white" opacity="0.8"/>
          <circle cx="32" cy="20" r="2" fill="white" opacity="0.6"/>
          <circle cx="28" cy="28" r="2.5" fill="white" opacity="0.8"/>
        </svg>
      <% end %>
      <div class="fb-search" id="headerSearchBox">
        <svg class="fb-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M10.917 10.917a6.5 6.5 0 111.414-1.414l4.242 4.242a1 1 0 01-1.414 1.414l-4.242-4.242zM11.5 6.5a5 5 0 11-10 0 5 5 0 0110 0z"/>
        </svg>
        <input
          type="text"
          id="headerSearchInput"
          placeholder="Search Sangam"
          class="fb-search-input"
          autocomplete="off"
          aria-label="Search users"
          aria-expanded="false"
          aria-controls="searchDropdown"
        >
        <!-- Live search dropdown -->
        <div class="fb-search-dropdown" id="searchDropdown" role="listbox" aria-label="Search results">
          <div class="fb-search-dropdown-inner" id="searchDropdownInner"></div>
        </div>
      </div>
    </div>

    <!-- Center Section: Navigation -->
    <div class="fb-header-center">
      <%= link_to posts_path, class: "fb-nav-item #{current_page?(posts_path) ? 'active' : ''}", title: 'Home' do %>
        <svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor">
