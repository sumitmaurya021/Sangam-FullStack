        <% unread = current_user.total_unread_messages %>
        <% if unread > 0 %>
          <span class="fb-notification-badge" id="chatUnreadBadge"><%= unread %></span>
        <% else %>
          <span class="fb-notification-badge" id="chatUnreadBadge" style="display:none;"></span>
        <% end %>
      <% end %>
      
      <button class="fb-icon-btn fb-notification-btn fb-desktop-only" title="Notifications">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
