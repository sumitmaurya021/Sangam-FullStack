<!-- Premium Modern Header 2026 -->
<header class="premium-header" id="premiumHeader">
  <div class="premium-header__container">
    
    <!-- Logo Section -->
    <div class="premium-header__logo">
      <%= link_to posts_path, class: 'premium-logo', title: 'Sangam' do %>
        <div class="premium-logo__icon">
          <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
              </linearGradient>
            </defs>
            <circle cx="20" cy="20" r="20" fill="url(#logoGrad)"/>
            <path d="M20 8C15.5 8 12 10.5 12 13.5C12 15.5 13.5 17 15.5 17.5C14 18 13 19.5 13 21C13 23.5 15.5 25.5 19 26.5V28C19 29.5 17.5 30.5 15.5 30.5C13.5 30.5 12 29.5 12 28H9C9 31.5 12.5 34 16.5 34C20.5 34 24 31.5 24 28C24 26 22.5 24.5 20.5 24C22 23.5 23 22 23 20.5C23 18 20.5 16 17 15V13C17 11.5 18.5 10.5 20.5 10.5C22.5 10.5 24 11.5 24 13H27C27 9.5 23.5 8 20 8Z" fill="white"/>
          </svg>
        </div>
        <span class="premium-logo__text">Sangam</span>
      <% end %>
    </div>

    <!-- Desktop Search -->
    <div class="premium-header__search" id="desktopSearch">
      <div class="premium-search">
        <button type="button" class="premium-search__icon" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16zM19 19l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <input 
          type="text" 
          class="premium-search__input" 
          id="headerSearchInput"
          placeholder="Search Sangam..."
          autocomplete="off"
          aria-label="Search"
        />
        <div class="premium-search__dropdown" id="searchDropdown">
          <div id="searchResults"></div>
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="premium-header__nav">
      <%= link_to posts_path, class: "premium-nav__item #{current_page?(posts_path) ? 'is-active' : ''}", title: 'Home' do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="premium-nav__label">Home</span>
      <% end %>
      
      <%= link_to reels_path, class: "premium-nav__item #{current_page?(reels_path) ? 'is-active' : ''}", title: 'Reels' do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M10 8l6 4-6 4V8z" fill="currentColor"/>
        </svg>
        <span class="premium-nav__label">Reels</span>
      <% end %>
      
      <%= link_to groups_path, class: "premium-nav__item #{current_page?(groups_path) ? 'is-active' : ''}", title: 'Groups' do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="premium-nav__label">Groups</span>
      <% end %>
      
      <%= link_to events_path, class: "premium-nav__item #{current_page?(events_path) ? 'is-active' : ''}", title: 'Events' do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="premium-nav__label">Events</span>
      <% end %>
      
      <%= link_to explore_path, class: "premium-nav__item #{current_page?(explore_path) ? 'is-active' : ''}", title: 'Explore' do %>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          <path d="M8 14l9-5-5 9-1-4-3-0z" fill="currentColor"/>
        </svg>
        <span class="premium-nav__label">Explore</span>
      <% end %>
    </nav>

    <!-- Actions -->
    <div class="premium-header__actions">
      
      <!-- Mobile Search Toggle -->
      <button class="premium-action-btn premium-action-btn--search" id="mobileSearchToggle" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16zM19 19l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Messenger -->
      <%= link_to conversations_path, class: 'premium-action-btn', title: 'Messages' do %>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M10 2C5.313 2 1.5 5.438 1.5 9.688c0 2.414 1.203 4.562 3.094 5.969V19l3.594-1.969A9.458 9.458 0 0010 17.5c4.687 0 8.5-3.438 8.5-7.688S14.687 2 10 2z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10.906 12.844l-2.187-2.344-4.281 2.344 4.719-5L11.406 10l4.219-2.344-4.719 5z" fill="currentColor"/>
        </svg>
        <% unread = current_user.total_unread_messages %>
        <% if unread > 0 %>
          <span class="premium-badge"><%= unread > 99 ? '99+' : unread %></span>
        <% end %>
      <% end %>

      <!-- Notifications -->
      <button class="premium-action-btn" id="notificationsBtn" aria-label="Notifications" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M15 7A5 5 0 105 7c0 2.76-.89 5.258-2 6.738V15h14v-1.262C15.89 12.258 15 9.76 15 7zM7.5 18a2.5 2.5 0 005 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <% unread_notif = current_user.unread_notifications_count %>
        <% if unread_notif > 0 %>
          <span class="premium-badge" id="notifBadge"><%= unread_notif > 99 ? '99+' : unread_notif %></span>
        <% end %>
      </button>

      <!-- Notifications Dropdown -->
      <div class="premium-dropdown" id="notificationsDropdown">
        <div class="premium-dropdown__header">
          <h3 class="premium-dropdown__title">Notifications</h3>
          <button class="premium-dropdown__action" id="markAllReadBtn">Mark all read</button>
        </div>
        <div class="premium-dropdown__content" id="notificationsList">
          <div class="premium-dropdown__loading">
            <div class="premium-spinner"></div>
            <span>Loading...</span>
          </div>
        </div>
      </div>

      <!-- User Menu -->
      <button class="premium-user-btn" id="userMenuBtn" aria-label="Account menu" aria-expanded="false">
        <div class="premium-avatar">
          <%= current_user.name&.first&.upcase || 'U' %>
        </div>
        <svg class="premium-user-btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4 6l4 4 4-4"/>
        </svg>
      </button>

      <!-- User Dropdown -->
      <div class="premium-dropdown premium-dropdown--user" id="userDropdown">
        <%= link_to profile_path(current_user), class: 'premium-user-profile' do %>
          <div class="premium-avatar premium-avatar--lg">
            <%= current_user.name&.first&.upcase || 'U' %>
          </div>
          <div class="premium-user-profile__info">
            <div class="premium-user-profile__name"><%= current_user.name || current_user.email %></div>
            <div class="premium-user-profile__label">View profile</div>
          </div>
        <% end %>
        
        <div class="premium-dropdown__divider"></div>
        
        <%= link_to bookmarks_path, class: 'premium-dropdown__item' do %>
          <div class="premium-dropdown__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"/>
            </svg>
          </div>
          <span>Saved Posts</span>
        <% end %>

        <%= link_to group_chats_path, class: 'premium-dropdown__item' do %>
          <div class="premium-dropdown__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9 9a3 3 0 116 0 3 3 0 01-6 0zM3 9a3 3 0 116 0 3 3 0 01-6 0zM9 17a6 6 0 0112 0H9zm-6 0a6 6 0 0112 0H3z"/>
            </svg>
          </div>
          <span>Group Chats</span>
        <% end %>
        
        <% if current_user.super_admin? %>
          <div class="premium-dropdown__divider"></div>
          <%= link_to admin_dashboard_path, class: 'premium-dropdown__item premium-dropdown__item--admin' do %>
            <div class="premium-dropdown__icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 2L2 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-8-5z"/>
              </svg>
            </div>
            <span>Admin Dashboard</span>
          <% end %>
        <% end %>
        
        <div class="premium-dropdown__divider"></div>
        
        <%= button_to destroy_user_session_path, method: :delete, class: 'premium-dropdown__item premium-dropdown__item--logout' do %>
          <div class="premium-dropdown__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.5 3.5h-7v13h7v1.5h-7c-.828 0-1.5-.672-1.5-1.5v-13c0-.828.672-1.5 1.5-1.5h7v1.5zm4.5 6.5l-3.5-3.5v2.5h-6v2h6v2.5l3.5-3.5z"/>
            </svg>
          </div>
          <span>Log out</span>
        <% end %>
      </div>

      <!-- Mobile Menu Toggle -->
      <button class="premium-action-btn premium-action-btn--menu" id="mobileMenuToggle" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Search Overlay -->
<div class="premium-mobile-search" id="mobileSearchOverlay">
  <div class="premium-mobile-search__header">
    <button class="premium-mobile-search__back" id="mobileSearchClose" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="premium-search">
      <input 
        type="text" 
        class="premium-search__input" 
        id="mobileSearchInput"
        placeholder="Search Sangam..."
        autocomplete="off"
      />
    </div>
  </div>
  <div class="premium-mobile-search__results" id="mobileSearchResults"></div>
</div>

<!-- Mobile Menu Overlay -->
<div class="premium-mobile-menu" id="mobileMenuOverlay">
  <div class="premium-mobile-menu__header">
    <div class="premium-logo">
      <div class="premium-logo__icon">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <defs>
            <linearGradient id="logoGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
            </linearGradient>
          </defs>
          <circle cx="20" cy="20" r="20" fill="url(#logoGrad2)"/>
          <path d="M20 8C15.5 8 12 10.5 12 13.5C12 15.5 13.5 17 15.5 17.5C14 18 13 19.5 13 21C13 23.5 15.5 25.5 19 26.5V28C19 29.5 17.5 30.5 15.5 30.5C13.5 30.5 12 29.5 12 28H9C9 31.5 12.5 34 16.5 34C20.5 34 24 31.5 24 28C24 26 22.5 24.5 20.5 24C22 23.5 23 22 23 20.5C23 18 20.5 16 17 15V13C17 11.5 18.5 10.5 20.5 10.5C22.5 10.5 24 11.5 24 13H27C27 9.5 23.5 8 20 8Z" fill="white"/>
        </svg>
      </div>
      <span class="premium-logo__text">Sangam</span>
    </div>
    <button class="premium-mobile-menu__close" id="mobileMenuClose" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="premium-mobile-nav">
    <%= link_to profile_path(current_user), class: 'premium-mobile-profile' do %>
      <div class="premium-avatar premium-avatar--lg">
        <%= current_user.name&.first&.upcase || 'U' %>
      </div>
      <div class="premium-mobile-profile__info">
        <div class="premium-mobile-profile__name"><%= current_user.name || current_user.email %></div>
        <div class="premium-mobile-profile__label">View profile</div>
      </div>
    <% end %>

    <div class="premium-mobile-nav__divider"></div>

    <%= link_to posts_path, class: "premium-mobile-nav__item #{current_page?(posts_path) ? 'is-active' : ''}" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Home</span>
    <% end %>

    <%= link_to reels_path, class: "premium-mobile-nav__item #{current_page?(reels_path) ? 'is-active' : ''}" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
        <path d="M10 8l6 4-6 4V8z" fill="currentColor"/>
      </svg>
      <span>Reels</span>
    <% end %>

    <%= link_to groups_path, class: "premium-mobile-nav__item #{current_page?(groups_path) ? 'is-active' : ''}" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Groups</span>
    <% end %>

    <%= link_to events_path, class: "premium-mobile-nav__item #{current_page?(events_path) ? 'is-active' : ''}" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
        <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>Events</span>
    <% end %>

    <%= link_to explore_path, class: "premium-mobile-nav__item #{current_page?(explore_path) ? 'is-active' : ''}" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
        <path d="M8 14l9-5-5 9-1-4-3-0z" fill="currentColor"/>
      </svg>
      <span>Explore</span>
    <% end %>

    <%= link_to conversations_path, class: 'premium-mobile-nav__item' do %>
      <svg width="24" height="24" viewBox="0 0 20 20" fill="none">
        <path d="M10 2C5.313 2 1.5 5.438 1.5 9.688c0 2.414 1.203 4.562 3.094 5.969V19l3.594-1.969A9.458 9.458 0 0010 17.5c4.687 0 8.5-3.438 8.5-7.688S14.687 2 10 2z" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span>Messages</span>
      <% unread = current_user.total_unread_messages %>
      <% if unread > 0 %>
        <span class="premium-badge"><%= unread > 99 ? '99+' : unread %></span>
      <% end %>
    <% end %>

    <%= link_to bookmarks_path, class: 'premium-mobile-nav__item' do %>
      <svg width="24" height="24" viewBox="0 0 20 20" fill="none">
        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span>Saved Posts</span>
    <% end %>

    <% if current_user.super_admin? %>
      <div class="premium-mobile-nav__divider"></div>
      <%= link_to admin_dashboard_path, class: 'premium-mobile-nav__item premium-mobile-nav__item--admin' do %>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 2L2 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-8-5z"/>
        </svg>
        <span>Admin Dashboard</span>
      <% end %>
    <% end %>

    <div class="premium-mobile-nav__divider"></div>

    <%= button_to destroy_user_session_path, method: :delete, class: 'premium-mobile-nav__item premium-mobile-nav__item--logout' do %>
      <svg width="24" height="24" viewBox="0 0 20 20" fill="none">
        <path d="M10.5 3.5h-7v13h7v1.5h-7c-.828 0-1.5-.672-1.5-1.5v-13c0-.828.672-1.5 1.5-1.5h7v1.5zm4.5 6.5l-3.5-3.5v2.5h-6v2h6v2.5l3.5-3.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>Log out</span>
    <% end %>
  </nav>
</div>
