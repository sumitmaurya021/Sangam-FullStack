              <path d="M10 2.5c-.828 0-1.5.672-1.5 1.5v.586C6.348 5.207 5 7.13 5 9.5v3.75l-1.25 1.25v.75h12.5v-.75L15 13.25V9.5c0-2.37-1.348-4.293-3.5-4.914V4c0-.828-.672-1.5-1.5-1.5zm-2.5 15c0 1.379 1.121 2.5 2.5 2.5s2.5-1.121 2.5-2.5h-5z"/>
