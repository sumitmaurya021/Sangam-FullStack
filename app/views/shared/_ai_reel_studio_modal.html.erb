<!-- Generative Reel Studio Modal -->
<div id="aiReelStudioModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(15,23,42,0.85); backdrop-filter:blur(10px); align-items:center; justify-content:center; padding:16px;">
  <div style="background:#0f172a; border-radius:24px; border:1px solid #334155; box-shadow:0 25px 50px rgba(0,0,0,0.6); width:100%; max-width:380px; height:640px; display:flex; flex-direction:column; overflow:hidden; position:relative;">
    
    <!-- Top Bar Header -->
    <div style="position:absolute; top:0; left:0; right:0; z-index:10; padding:16px; background:linear-gradient(to bottom, rgba(0,0,0,0.7), transparent); display:flex; align-items:center; justify-content:space-between; color:white;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="font-size:1.2rem;">🎬</span>
        <span id="reelModalTitle" style="font-weight:700; font-size:0.9rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:200px;">AI Generative Reel</span>
      </div>
      <button onclick="closeReelStudio()" style="background:rgba(255,255,255,0.2); border:none; color:white; width:30px; height:30px; border-radius:50%; cursor:pointer; font-weight:700;">✕</button>
    </div>

    <!-- Progress Indicator Bar -->
    <div id="reelProgressBar" style="position:absolute; top:54px; left:16px; right:16px; z-index:10; display:flex; gap:6px;">
      <!-- Dynamic progress segments inserted here -->
    </div>

    <!-- Reel Slide Canvas -->
    <div id="reelSlideCanvas" style="flex:1; width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 24px; text-align:center; color:white; transition:background 0.5s ease; background:linear-gradient(135deg, #6366f1, #a855f7);">
      <div id="reelSlideHeadline" style="font-size:1.4rem; font-weight:800; margin-bottom:16px; text-shadow:0 2px 10px rgba(0,0,0,0.4); line-height:1.3;">
        Generating Reel...
      </div>
      <div id="reelSlideCaption" style="font-size:1.0rem; font-weight:500; opacity:0.95; line-height:1.5; max-width:280px; text-shadow:0 1px 5px rgba(0,0,0,0.3);">
        Please wait while AI constructs your vertical story slides.
      </div>
    </div>

    <!-- Bottom Controls -->
    <div style="position:absolute; bottom:0; left:0; right:0; z-index:10; padding:20px 16px; background:linear-gradient(to top, rgba(0,0,0,0.8), transparent); display:flex; align-items:center; justify-content:space-between; gap:12px;">
      <button onclick="prevReelSlide()" style="background:rgba(255,255,255,0.2); border:none; color:white; padding:8px 14px; border-radius:10px; font-weight:600; cursor:pointer;">◄ Prev</button>
      <button onclick="publishReelStory()" style="background:linear-gradient(135deg, #10b981, #059669); color:white; border:none; padding:10px 18px; border-radius:12px; font-weight:700; cursor:pointer; font-size:0.88rem;">🚀 Publish Story</button>
      <button onclick="nextReelSlide()" style="background:rgba(255,255,255,0.2); border:none; color:white; padding:8px 14px; border-radius:10px; font-weight:600; cursor:pointer;">Next ►</button>
    </div>

  </div>
</div>

<script>
  let currentReelSlides = [];
  let activeSlideIdx = 0;

  function openReelStudio(text, title) {
    const modal = document.getElementById('aiReelStudioModal');
    if (!modal) return;
    modal.style.display = 'flex';

    document.getElementById('reelModalTitle').textContent = title || 'AI Reel Studio';
    document.getElementById('reelSlideHeadline').textContent = '✨ Generating Reel...';
    document.getElementById('reelSlideCaption').textContent = 'AI is writing vertical story slides...';

    fetch('/api/ai/generate_reel', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
      },
      body: JSON.stringify({ text: text, title: title })
    })
    .then(r => r.json())
    .then(data => {
      if (data.slides && data.slides.length > 0) {
        currentReelSlides = data.slides;
        activeSlideIdx = 0;
        renderCurrentSlide();
      } else {
        if (window.showAiToast) {
          window.showAiToast(data.error || 'Failed to generate reel.', 'error', '❌');
        } else {
          alert(data.error || 'Failed to generate reel.');
        }
        closeReelStudio();
      }
    })
    .catch(err => {
      if (window.showAiToast) {
        window.showAiToast('Failed to generate reel.', 'error', '⚠️');
      } else {
        alert('Failed to generate reel.');
      }
      closeReelStudio();
    });
  }

  function renderCurrentSlide() {
    if (!currentReelSlides || currentReelSlides.length === 0) return;
    const slide = currentReelSlides[activeSlideIdx];
    const canvas = document.getElementById('reelSlideCanvas');
    const headline = document.getElementById('reelSlideHeadline');
    const caption = document.getElementById('reelSlideCaption');
    const progressBar = document.getElementById('reelProgressBar');

    if (canvas && slide) {
      canvas.style.background = slide.bg_gradient || 'linear-gradient(135deg, #6366f1, #a855f7)';
      headline.textContent = slide.headline || '';
      caption.textContent = slide.caption || '';
    }

    if (progressBar) {
      progressBar.innerHTML = currentReelSlides.map((_, idx) => `
        <div style="flex:1; height:4px; border-radius:2px; background:${idx === activeSlideIdx ? '#ffffff' : 'rgba(255,255,255,0.35)'}; transition:all 0.3s;"></div>
      `).join('');
    }
  }

  function nextReelSlide() {
    if (activeSlideIdx < currentReelSlides.length - 1) {
      activeSlideIdx++;
      renderCurrentSlide();
    }
  }

  function prevReelSlide() {
    if (activeSlideIdx > 0) {
      activeSlideIdx--;
      renderCurrentSlide();
    }
  }

  function closeReelStudio() {
    const modal = document.getElementById('aiReelStudioModal');
    if (modal) modal.style.display = 'none';
  }

  function publishReelStory() {
    if (window.showAiToast) {
      window.showAiToast('Story Published! Your AI Generated Reel is now live on your Sangam Story feed!', 'success', '🎉');
    } else {
      alert('🎉 Story Published! Your AI Generated Reel is now live on your Sangam Story feed!');
    }
    closeReelStudio();
  }
</script>
