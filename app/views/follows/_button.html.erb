<%# Renders a follow/unfollow toggle button for `user`.
    Wraps itself in a turbo_frame so Turbo Streams can replace just the button. %>

<%= turbo_frame_tag "follow_btn_#{user.id}" do %>
  <% if current_user == user %>
    <%# Don't show follow button on your own profile %>
  <% elsif current_user.following?(user) %>
    <%= button_to follow_path(followee_id: user.id),
                  method: :delete,
                  class: 'btn-profile-action btn-following',
                  data: { turbo_stream: true } do %>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M16 11a4 4 0 00-8 0v1H6v5h12v-5h-2v-1zm-4-2a2 2 0 012 2v1h-4v-1a2 2 0 012-2zM10 4a3 3 0 100 6 3 3 0 000-6z"/>
        <path d="M17 8l2 2-5 5-3-3 2-2 1 1z"/>
      </svg>
      Following
    <% end %>
  <% else %>
    <%= button_to follows_path(followee_id: user.id),
                  method: :post,
                  class: 'btn-profile-action btn-follow',
                  data: { turbo_stream: true } do %>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/>
      </svg>
      Follow
    <% end %>
  <% end %>
<% end %>
