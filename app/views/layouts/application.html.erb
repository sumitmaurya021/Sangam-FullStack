<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sangam" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sangam">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="action-cable-url" content="/cable">
    <meta name="giphy-api-key" content="<%= ENV['GIPHY_API_KEY'].to_s %>">
    <meta name="turn-server-url" content="<%= ENV['TURN_SERVER_URL'].to_s %>">
    <meta name="turn-server-username" content="<%= ENV['TURN_SERVER_USERNAME'].to_s %>">
    <meta name="turn-server-credential" content="<%= ENV['TURN_SERVER_CREDENTIAL'].to_s %>">
    <% if user_signed_in? %>
      <meta name="current-user-id" content="<%= current_user.id %>">
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">

    <%# Core stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'shared/header',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'chat/messenger',                 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'chat/chat_widget',               'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'notifications/notifications',    'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'stories/stories',                'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'groups/groups',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'events/events',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'search/search',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'bookmarks/bookmarks',            'data-turbo-track': 'reload' %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
    <%= render 'shared/chat_widget' if user_signed_in? %>
  </body>
</html>
