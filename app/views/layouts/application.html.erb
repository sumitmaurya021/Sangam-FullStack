<!DOCTYPE html>
<html class="<%= 'dark-mode' if user_signed_in? && current_user.dark_mode %>">
  <head>
    <title><%= content_for(:title) || "Sangam" %></title>
    <%= render 'shared/meta_tags' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Sangam">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="action-cable-url" content="/cable">
    <meta name="giphy-api-key" content="<%= ENV['GIPHY_API_KEY'].to_s %>">
    <meta name="turn-server-url" content="<%= ENV['TURN_SERVER_URL'].to_s %>">
    <meta name="turn-server-username" content="<%= ENV['TURN_SERVER_USERNAME'].to_s %>">
    <meta name="turn-server-credential" content="<%= ENV['TURN_SERVER_CREDENTIAL'].to_s %>">
    <% if user_signed_in? %>
      <meta name="current-user-id" content="<%= current_user.id %>">
    <% end %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">

    <%# Core stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'shared/header',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'shared/dark_mode',               'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'chat/messenger',                 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'chat/chat_widget',               'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'notifications/notifications',    'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'stories/stories',                'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'groups/groups',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'events/events',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'search/search',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'bookmarks/bookmarks',            'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'shared/collections',             'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'shared/lightbox',                'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'futuristic_ai',                  'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'digital_twin',                    'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'ux_mutations',                    'data-turbo-track': 'reload' %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= 'dark-mode' if user_signed_in? && current_user.dark_mode %>"
        data-dark-mode="<%= user_signed_in? && current_user.dark_mode ? 'true' : 'false' %>"
        data-ux-mode="<%= current_ux_mode %>">

    <%= yield %>
    <%= render 'shared/chat_widget' if user_signed_in? %>
    <%= render 'shared/lightbox' %>
    <%= render 'shared/ai_copilot_modal' if user_signed_in? %>
    <%= render 'shared/ai_reel_studio_modal' if user_signed_in? %>

    <script>
      window.translateTranscriptText = function(selectEl, targetId) {
        let targetLang = selectEl.value;
        if (!targetLang) return;

        if (targetLang === 'CUSTOM') {
          targetLang = prompt('Enter any language name in the world (e.g. Swahili, Korean, Punjabi, Italian, Latin, etc.):');
          if (!targetLang || !targetLang.trim()) {
            selectEl.value = '';
            return;
          }
        }

        const pEl = document.getElementById(targetId);
        if (!pEl) return;

        const originalText = pEl.getAttribute('data-original-text') || pEl.textContent;
        if (!pEl.getAttribute('data-original-text')) {
          pEl.setAttribute('data-original-text', originalText);
        }

        pEl.style.opacity = '0.4';
        selectEl.disabled = true;

        fetch('/api/ai/translate_text', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
          },
          body: JSON.stringify({ text: originalText, target_language: targetLang })
        })
        .then(r => r.json())
        .then(data => {
          selectEl.disabled = false;
          pEl.style.opacity = '1';
          if (data.translated_text) {
            pEl.textContent = data.translated_text;
          }
        })
        .catch(err => {
          selectEl.disabled = false;
          pEl.style.opacity = '1';
          console.error('Translation failed:', err);
        });
      };
    </script>
  </body>
</html>
