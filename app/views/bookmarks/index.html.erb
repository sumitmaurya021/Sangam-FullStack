<div class="feed-container">
  <%= render 'shared/header' %>
  <div class="feed-layout">
    <main class="feed-main">

      <!-- Page header -->
      <div class="page-header-card">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
          <div>
            <h1 class="page-title">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor" style="vertical-align:middle;margin-right:8px;">
                <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"/>
              </svg>
              Saved
            </h1>
            <p class="page-subtitle">
              <%= @post_bookmarks.total_count %> post<%= @post_bookmarks.total_count == 1 ? '' : 's' %> ·
              <%= @saved_reels.size %> reel<%= @saved_reels.size == 1 ? '' : 's' %>
            </p>
          </div>
          <%= link_to bookmark_collections_path, class: 'btn-secondary btn-sm' do %>
            📂 Collections (<%= @collections.count %>)
          <% end %>
        </div>
      </div>

      <!-- Tabs -->
      <div class="bookmarks-tabs">
        <%= link_to bookmarks_path(tab: 'posts'),
              class: "bookmarks-tab #{@active_tab == 'posts' ? 'active' : ''}" do %>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
            <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"/>
          </svg>
          Posts
          <span class="bookmarks-tab__count"><%= @post_bookmarks.total_count %></span>
        <% end %>

        <%= link_to bookmarks_path(tab: 'reels'),
              class: "bookmarks-tab #{@active_tab == 'reels' ? 'active' : ''}" do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="10"/>
            <path d="M10 8l6 4-6 4V8z" fill="white"/>
          </svg>
          Reels
          <span class="bookmarks-tab__count"><%= @saved_reels.size %></span>
        <% end %>
      </div>

      <!-- Posts tab -->
      <% if @active_tab == 'posts' %>
        <% if @saved_posts.empty? %>
          <div class="bookmarks-empty">
            <div class="bookmarks-empty__icon">🔖</div>
            <h3>No saved posts yet</h3>
            <p>Tap <strong>Save</strong> on any post to find it here later.</p>
            <%= link_to 'Browse Feed', posts_path, class: 'bookmarks-empty__btn' %>
          </div>
        <% else %>
          <div class="posts-feed">
            <%= render partial: 'posts/post_card', collection: @saved_posts, as: :post %>
          </div>

          <% if @post_bookmarks.next_page %>
            <div class="pagination-wrapper">
              <%= link_to 'Load More', bookmarks_path(tab: 'posts', page: @post_bookmarks.next_page),
                    class: 'btn-load-more' %>
            </div>
          <% end %>
        <% end %>

      <!-- Reels tab -->
      <% else %>
        <% if @saved_reels.empty? %>
          <div class="bookmarks-empty">
            <div class="bookmarks-empty__icon">🎬</div>
            <h3>No saved reels yet</h3>
            <p>Tap <strong>Save</strong> on any reel to find it here.</p>
            <%= link_to 'Browse Reels', reels_path, class: 'bookmarks-empty__btn' %>
          </div>
        <% else %>
          <div class="bookmarks-reels-grid">
            <% @saved_reels.each do |reel| %>
              <div class="bookmarks-reel-card">
                <%= link_to reels_path(anchor: "reel-#{reel.id}"), class: 'bookmarks-reel-card__thumb' do %>
                  <% if reel.thumbnail.attached? %>
                    <%= image_tag reel.thumbnail, alt: reel.caption.to_s.truncate(40) %>
                  <% elsif reel.video.attached? %>
                    <div class="bookmarks-reel-card__placeholder">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="rgba(255,255,255,.7)">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                      </svg>
                    </div>
                  <% end %>
                  <!-- Duration badge if available -->
                  <% if reel.respond_to?(:duration) && reel.duration.present? %>
                    <span class="bookmarks-reel-card__dur">
                      <%= "#{reel.duration / 60}:#{reel.duration % 60 < 10 ? '0' : ''}#{reel.duration % 60}" %>
                    </span>
                  <% end %>
                  <div class="bookmarks-reel-card__overlay">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                <% end %>

                <div class="bookmarks-reel-card__info">
                  <div class="bookmarks-reel-card__author">
                    <div class="bookmarks-reel-card__avatar">
                      <% if reel.user.avatar.attached? %>
                        <%= image_tag reel.user.avatar, alt: reel.user.name %>
                      <% else %>
                        <%= reel.user.name&.first&.upcase || 'U' %>
                      <% end %>
                    </div>
                    <span class="bookmarks-reel-card__name"><%= reel.user.name %></span>
                  </div>
                  <% if reel.caption.present? %>
                    <p class="bookmarks-reel-card__caption"><%= reel.caption.truncate(60) %></p>
                  <% end %>
                  <div class="bookmarks-reel-card__stats">
                    <span>❤️ <%= number_with_delimiter(reel.likes_count) %></span>
                    <span>💬 <%= number_with_delimiter(reel.comments_count) %></span>
                    <span>👁 <%= number_with_delimiter(reel.views_count) %></span>
                  </div>
                </div>

                <!-- Unsave button -->
                <button class="bookmarks-reel-card__unsave"
                        data-reel-id="<%= reel.id %>"
                        data-bookmarked="true"
                        onclick="toggleReelBookmark(<%= reel.id %>, this); this.closest('.bookmarks-reel-card').remove();"
                        title="Remove from saved">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
                  </svg>
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

    </main>
  </div>
</div>

<%= stylesheet_link_tag 'posts/post_card',   'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'posts/feed',        'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'bookmarks/bookmarks', 'data-turbo-track': 'reload' %>
