<% cache [post, current_user.id, post.likes_count, post.comments_count, post.updated_at] do %>
<article class="post-card" 
         id="post-<%= post.id %>" 
         data-post-id="<%= post.id %>"
         data-controller="post-reaction bookmark comment-section"
         data-post-reaction-post-id-value="<%= post.id %>"
         data-post-reaction-liked-value="<%= current_user.liked?(post) %>"
         data-post-reaction-reaction-type-value="<%= current_user.liked?(post) ? post.user_reaction(current_user)&.reaction_type : '' %>"
         data-post-reaction-count-value="<%= post.likes_count %>"
         data-post-reaction-url-value="<%= like_post_path(post) %>"
         data-bookmark-post-id-value="<%= post.id %>"
         data-bookmark-bookmarked-value="<%= post.bookmarked_by?(current_user) %>"
         data-bookmark-url-value="<%= bookmark_post_path(post) %>"
         data-comment-section-post-id-value="<%= post.id %>">
  <!-- Post Header -->
  <div class="post-header">
    <div class="post-author">
      <%= link_to profile_path(post.user), class: 'author-link' do %>
        <div class="author-avatar">
          <% if post.user.avatar.attached? %>
            <%= image_tag post.user.avatar, alt: "#{post.user.name} avatar" %>
          <% else %>
            <%= post.user.name&.first&.upcase || 'U' %>
          <% end %>
        </div>
        <div class="author-info">
          <div class="author-name"><%= post.user.name || post.user.email %></div>
          <div class="post-time">
            <%= time_ago_in_words(post.created_at) %> ago
            <% if post.visibility == 'friends' %>
              <span class="post-visibility-badge" title="Friends only">👥</span>
            <% elsif post.visibility == 'close_friends' %>
              <span class="post-visibility-badge" title="Close Friends">⭐</span>
            <% elsif post.visibility == 'private' %>
              <span class="post-visibility-badge" title="Only me">🔒</span>
            <% end %>
            <% if post.scheduled? %>
              <span class="post-visibility-badge" title="Scheduled">🕐 Scheduled</span>
            <% end %>
            <% if post.edited? %>
              <span class="post-edited-badge"> · Edited</span>
            <% end %>
            <% if post.respond_to?(:recommendation_score_pct) %>
              <span style="background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(168,85,247,0.15)); color:#6366f1; border:1px solid rgba(99,102,241,0.3); border-radius:12px; padding:2px 8px; font-size:0.7rem; font-weight:600; margin-left:6px;">✨ <%= post.recommendation_score_pct %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% if post.user == current_user %>
      <div class="post-menu"
           data-controller="post-edit"
           data-post-edit-post-id-value="<%= post.id %>">
        <button class="post-menu-btn" onclick="togglePostMenu(<%= post.id %>); event.stopPropagation();">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <circle cx="10" cy="4" r="1.5"/>
            <circle cx="10" cy="10" r="1.5"/>
            <circle cx="10" cy="16" r="1.5"/>
          </svg>
        </button>
        <div class="post-dropdown" id="postMenu<%= post.id %>">
          <button class="dropdown-item"
                  data-action="click->post-edit#edit">
            ✏️ Edit Post
          </button>
          <%= button_to 'Delete Post',
                post_path(post),
                method: :delete,
                class: 'dropdown-item-danger',
                form: { data: { turbo_confirm: 'Are you sure you want to delete this post?' } } %>
        </div>
      </div>
    <% else %>
      <div class="post-menu">
        <button class="post-menu-btn" onclick="togglePostMenu(<%= post.id %>); event.stopPropagation();">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
            <circle cx="10" cy="4" r="1.5"/>
            <circle cx="10" cy="10" r="1.5"/>
            <circle cx="10" cy="16" r="1.5"/>
          </svg>
        </button>
        <div class="post-dropdown" id="postMenu<%= post.id %>">
          <button class="dropdown-item"
                  onclick="toggleBookmark(<%= post.id %>, this)"
                  data-bookmarked="<%= post.bookmarked_by?(current_user) %>">
            <%= post.bookmarked_by?(current_user) ? '🔖 Saved' : '🔖 Save Post' %>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Post Content -->
  <div class="post-content">
    <%= simple_format(post.content) if post.content.present? %>

    <%# Location tag %>
    <% if post.has_location? %>
      <div class="post-location-tag">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
        <%= post.location_name %>
      </div>
    <% end %>

    <%# Collaborators %>
    <% accepted_collabs = post.post_collaborators.accepted rescue [] %>
    <% if accepted_collabs.any? %>
      <div class="post-collaborators">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
        <span>With </span>
        <% accepted_collabs.each_with_index do |c, i| %>
          <%= link_to c.user.name, profile_path(c.user), class: 'collab-name' %><%= i < accepted_collabs.length - 1 ? ', ' : '' %>
        <% end %>
      </div>
    <% end %>
    
    <!-- Poll -->
    <% if post.has_poll? %>
      <%= render 'polls/poll', poll: post.poll %>
    <% end %>

    <%# Fundraiser %>
    <% if post.has_fundraiser? %>
      <%= render 'posts/fundraiser_card', fundraiser: post.fundraiser %>
    <% end %>

    <!-- Multiple Images Grid -->
    <% if post.images.attached? && post.images.any? %>
      <% total = post.total_images_count %>
      <div class="post-images-grid grid-<%= [total, 5].min %>" 
           id="post-images-<%= post.id %>" 
           data-urls="<%= post.images.map { |img| url_for(img) }.to_json %>">
        <% post.display_images(5).each_with_index do |image, index| %>
          <% is_last = (index == 4) && (total > 5) %>
          <div class="post-image-item <%= 'image-overlay' if is_last %>" onclick="openImageGallery(<%= post.id %>, <%= index %>)">
            <%= image_tag image, alt: "Post image #{index + 1}", loading: "lazy" %>
            <% if is_last %>
              <div class="image-overlay-text"><span class="overlay-plus">+<%= total - 5 %></span></div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% elsif post.image.attached? %>
      <div class="post-single-image" 
           id="post-images-<%= post.id %>" 
           data-urls="<%= [url_for(post.image)].to_json %>"
           onclick="openImageGallery(<%= post.id %>, 0)"
           style="cursor: pointer;">
        <%= image_tag post.image, alt: 'Post image', loading: "lazy" %>
      </div>
    <% end %>

    <%# Link Preview %>
    <% if post.has_link_preview? %>
      <a href="<%= post.link_url %>" target="_blank" rel="noopener noreferrer" class="link-preview-card">
        <% if post.link_image_url.present? %>
          <img class="link-preview-img" src="<%= post.link_image_url %>" alt="<%= post.link_title %>" onerror="this.style.display='none'">
        <% end %>
        <div class="link-preview-body">
          <p class="link-preview-domain"><%= post.link_domain %></p>
          <p class="link-preview-title"><%= post.link_title %></p>
          <% if post.link_description.present? %>
            <p class="link-preview-desc"><%= post.link_description.truncate(120) %></p>
          <% end %>
        </div>
      </a>
    <% end %>
  </div>

  <!-- Post Stats -->
    <div class="post-stats">
      <div class="stat-item">
        <div class="reaction-icons" id="reaction-summary-<%= post.id %>" data-post-reaction-target="summary">
          <% reaction_counts = post.reaction_counts %>
          <% if reaction_counts.any? %>
            <% reaction_counts.first(3).each do |reaction_type, count| %>
              <span class="reaction-icon <%= reaction_type %>"><%= Like::REACTIONS[reaction_type] %></span>
            <% end %>
          <% else %>
            <span class="reaction-icon like">👍</span>
          <% end %>
        </div>
        <span id="likes-count-<%= post.id %>" data-post-reaction-target="count"><%= post.likes_count %></span>
      </div>
      <div class="stat-links">
        <span><%= pluralize(post.comments_count, 'comment') %></span>
        <span><%= pluralize(post.shares_count, 'share') %></span>
        <% if post.views_count > 0 %>
          <span>👁 <%= number_with_delimiter(post.views_count) %></span>
        <% end %>
      </div>
    </div>

    <!-- Post Actions Bar -->
    <div class="post-actions-bar">
      <div class="action-btn-wrapper">
        <div class="reaction-picker" id="reaction-picker-<%= post.id %>" data-post-reaction-target="picker">
          <% Like::REACTIONS.each do |reaction_type, emoji| %>
            <button class="reaction-btn"
                    data-reaction="<%= reaction_type %>"
                    data-action="click->post-reaction#react">
              <span class="reaction-emoji"><%= emoji %></span>
            </button>
          <% end %>
        </div>

        <button class="action-btn <%= current_user.liked?(post) ? 'active' : '' %>" 
                id="like-btn-<%= post.id %>"
                data-post-reaction-target="button"
                data-action="click->post-reaction#react contextmenu->post-reaction#togglePicker">
          <% if current_user.liked?(post) %>
            <span id="like-text-<%= post.id %>" data-post-reaction-target="text">
              <%= post.user_reaction(current_user).reaction_emoji %> <%= post.user_reaction(current_user).reaction_type.capitalize %>
            </span>
          <% else %>
            <svg class="action-icon" id="like-icon-<%= post.id %>" data-post-reaction-target="icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
            </svg>
            <span id="like-text-<%= post.id %>" data-post-reaction-target="text">
              Like
            </span>
          <% end %>
        </button>
      </div>

      <button class="action-btn" data-action="click->comment-section#toggleSection">
        <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
        </svg>
        <span>Comment</span>
      </button>
      
      <%= button_to share_post_path(post), method: :post, class: 'action-btn', data: { turbo: false } do %>
        <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
        </svg>
        <span>Share</span>
      <% end %>

      <button class="action-btn action-btn--story"
              onclick="openStsModal(<%= post.id %>)"
              aria-label="Share to story"
              title="Share to your story">
        <svg class="action-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 8 12 12 14 14"/>
          <path d="M12 2a10 10 0 010 20" stroke-dasharray="4 2"/>
        </svg>
        <span>Story</span>
      </button>

      <%= render 'stories/share_to_story_modal', post: post %>

      <button class="action-btn <%= post.bookmarked_by?(current_user) ? 'active' : '' %>"
              id="bookmark-btn-<%= post.id %>"
              data-bookmark-target="button"
              data-action="click->bookmark#toggle contextmenu->bookmark#showCollections"
              data-bookmarked="<%= post.bookmarked_by?(current_user) %>"
              title="Save post (right-click to save to collection)">
        <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"/>
        </svg>
        <span id="bookmark-text-<%= post.id %>"><%= post.bookmarked_by?(current_user) ? 'Saved' : 'Save' %></span>
      </button>
    </div>

    <!-- Comments Section -->
    <div class="comments-section" id="comments-<%= post.id %>" data-comment-section-target="container" style="display: none;">
    <div class="comments-list" id="comments-list-<%= post.id %>">
      <% post.comments.top_level.recent.each do |comment| %>
        <%= render 'comments/comment', comment: comment, post: post %>
      <% end %>
    </div>
    
    <%= form_with model: [post, Comment.new], class: 'comment-form', id: "comment-form-#{post.id}" do |f| %>
      <div class="comment-input-wrapper voice-recorder-container-<%= post.id %>">
        <div class="comment-avatar-small">
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, alt: "Your avatar" %>
          <% else %>
            <%= current_user.name&.first&.upcase || 'U' %>
          <% end %>
        </div>

        <!-- Voice Recording UI -->
        <div class="voice-recording-ui" style="display:none; align-items:center; flex:1; justify-content: space-between; padding: 0 10px; background: #f0f2f5; border-radius: 20px; margin-right: 8px;">
          <div class="recording-indicator" style="display:flex; align-items:center; gap:10px; color:#ff4d4f;">
            <div class="recording-pulse" style="width:10px; height:10px; background:#ff4d4f; border-radius:50%; animation: pulse 1s infinite;"></div>
            <span class="recording-timer" style="font-weight:bold;">0:00</span>
          </div>
          <div class="recording-actions" style="display:flex; gap:10px;">
            <button class="record-cancel-btn record-action-btn" type="button" style="color:#666; border:none; background:none; cursor:pointer;" title="Cancel">✕</button>
            <button class="record-send-btn record-action-btn" type="button" style="color:#0084ff; border:none; background:none; cursor:pointer;" title="Send">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 10l16-8-8 16v-8L2 10z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="default-input-area" style="display:flex; flex:1; align-items:center; gap: 4px;">
          <%= f.text_field :content, placeholder: 'Write a comment...', class: 'comment-input', autocomplete: 'off', style: 'flex:1;', data: { comment_section_target: 'input' } %>
          
          <button type="button" class="voice-record-btn" title="Record Voice Note" style="background:none;border:none;color:#f55;cursor:pointer;padding:5px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
          </button>

          <%= f.file_field :attachment, id: "comment-audio-input-#{post.id}", style: "display:none;", accept: "audio/*" %>
          <%= f.submit 'Post', class: 'btn-comment' %>
        </div>

        <%= f.hidden_field :parent_id, value: nil, id: "parent-id-#{post.id}", data: { comment_section_target: 'parentId' } %>
        <%= f.hidden_field :replied_to_user_id, value: nil, id: "replied-to-user-id-#{post.id}", data: { comment_section_target: 'repliedToUserId' } %>
      </div>
      <div class="reply-indicator" id="reply-indicator-<%= post.id %>" data-comment-section-target="replyIndicator" style="display: none;">
        Replying to <span id="reply-to-name-<%= post.id %>" data-comment-section-target="replyToName"></span>
        <button type="button" data-action="click->comment-section#cancelReply" class="cancel-reply">✕</button>
      </div>
    <% end %>

    <script>
      (function() {
        const container = document.querySelector('.voice-recorder-container-<%= post.id %>');
        if (container && window.VoiceRecorder) {
          new window.VoiceRecorder(container, (audioBlob) => {
            const fileInput = document.getElementById('comment-audio-input-<%= post.id %>');
            const form = document.getElementById('comment-form-<%= post.id %>');
            if (fileInput && form) {
              const dataTransfer = new DataTransfer();
              dataTransfer.items.add(new File([audioBlob], `voice_comment_${Date.now()}.webm`, { type: 'audio/webm' }));
              fileInput.files = dataTransfer.files;
              
              // Automatically submit the form
              form.requestSubmit();
            }
          });
        }
      })();
    </script>
  </div>
</article>
<% end %>
