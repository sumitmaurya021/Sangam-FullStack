<%= form_with model: post, url: posts_path, class: 'create-post-form', id: 'new-post-form' do |f| %>
  <% if post.errors.any? %>
    <div class="post-edit-errors" style="margin-bottom:0.75rem;">
      <% post.errors.full_messages.each do |msg| %>
        <p>• <%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="post-input-wrapper" data-controller="ai-caption" data-ai-caption-target="container" style="align-items: flex-start;">
    <div class="user-avatar-small">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar, alt: "Your avatar" %>
      <% else %>
        <%= current_user.name&.first&.upcase || 'U' %>
      <% end %>
    </div>
    <div style="flex: 1; display: flex; flex-direction: column; position: relative;" class="caption-input-container">
      <%= f.text_area :content,
            placeholder: "What's on your mind, #{current_user.name || 'there'}?",
            class: 'post-input',
            rows: 3,
            id: 'post-content-input',
            data: { "ai-caption-target": "textarea" } %>
      
      <div class="ai-action-bar">
        <button type="button" class="btn-futuristic-ai" data-action="click->ai-caption#generate" data-ai-caption-target="button">
          <svg class="ai-icon" viewBox="0 0 24 24">
            <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
          </svg>
          <span class="ai-text">AI Magic</span>
        </button>
      </div>
    </div>
  </div>

  <%# Link Preview Area (auto-populated by JS) %>
  <div id="post-image-preview-area"></div>
  <div id="link-preview-area"></div>

  <%# Hidden link preview fields — populated by JS %>
  <%= f.hidden_field :link_url,         id: 'post_link_url' %>
  <%= f.hidden_field :link_title,       id: 'post_link_title' %>
  <%= f.hidden_field :link_description, id: 'post_link_description' %>
  <%= f.hidden_field :link_image_url,   id: 'post_link_image_url' %>
  <%= f.hidden_field :link_domain,      id: 'post_link_domain' %>

  <%# ── Poll Builder ── %>
  <div id="poll-builder" style="display:none;">
    <fieldset id="poll-fieldset" disabled style="border:none; padding:0; margin:0; min-width:0;">
      <%= f.fields_for :poll, Poll.new do |pf| %>
        <div class="poll-builder-card">
          <div class="poll-builder-header">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
            </svg>
            <span>Add a Poll</span>
            <button type="button" class="poll-builder-close" onclick="closePollBuilder()" aria-label="Remove poll">✕</button>
          </div>
          <div class="poll-builder-body">
            <div class="poll-builder-field">
              <%= pf.text_field :question, placeholder: 'Ask a question...', class: 'poll-builder-input poll-builder-question', maxlength: 280, required: true %>
            </div>
            <div class="poll-options-list" id="pollOptionsList">
              <% 4.times do |i| %>
                <%= pf.fields_for :poll_options_attributes, PollOption.new(position: i), index: i do |opf| %>
                  <div class="poll-builder-option" id="poll-option-row-<%= i %>">
                    <%= opf.hidden_field :position, value: i %>
                    <%= opf.text_field :body,
                          placeholder: i < 2 ? "Option #{i + 1}" : "Option #{i + 1} (optional)",
                          class: 'poll-builder-input',
                          maxlength: 100,
                          required: i < 2 %>
                  </div>
                <% end %>
              <% end %>
            </div>
            <div class="poll-builder-field poll-builder-enddate">
              <label class="poll-builder-label">⏱ End date (optional)</label>
              <%= pf.datetime_local_field :ends_at, class: 'poll-builder-input', min: Time.current.strftime('%Y-%m-%dT%H:%M') %>
            </div>
          </div>
        </div>
      <% end %>
    </fieldset>
  </div>

  <%# ── Fundraiser Builder ── %>
  <div id="fundraiser-builder" style="display:none;">
    <fieldset id="fundraiser-fieldset" disabled style="border:none; padding:0; margin:0; min-width:0;">
      <%= f.fields_for :fundraiser, Fundraiser.new do |ff| %>
        <div class="poll-builder-card">
          <div class="poll-builder-header">
            <span>💰</span>
            <span>Add Fundraiser</span>
            <button type="button" class="poll-builder-close" onclick="closeFundraiserBuilder()">✕</button>
          </div>
          <div class="poll-builder-body">
            <div class="poll-builder-field">
              <%= ff.text_field :title, placeholder: 'Fundraiser title...', class: 'poll-builder-input', maxlength: 100 %>
            </div>
            <div class="poll-builder-field">
              <%= ff.text_area :description, placeholder: 'Why are you raising funds?', rows: 2, class: 'poll-builder-input' %>
            </div>
            <div class="form-row" style="display:flex;gap:10px;">
              <div style="flex:1">
                <label class="poll-builder-label">Goal Amount ($)</label>
                <%= ff.number_field :goal_amount, placeholder: '500.00', step: '0.01', min: 1, class: 'poll-builder-input' %>
              </div>
              <div style="flex:1">
                <label class="poll-builder-label">End Date (optional)</label>
                <%= ff.date_field :ends_at, class: 'poll-builder-input' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </fieldset>
  </div>

  <%# ── Location Tag ── %>
  <div id="location-builder" style="display:none;">
    <div class="location-builder-card">
      <div class="location-builder__row">
        <span>📍</span>
        <%= f.text_field :location_name, placeholder: 'Add a location...', class: 'poll-builder-input', id: 'location-name-input' %>
        <button type="button" onclick="closeLocationBuilder()" class="poll-builder-close">✕</button>
      </div>
    </div>
  </div>

  <%# ── Schedule ── %>
  <div id="schedule-builder" style="display:none;">
    <div class="location-builder-card">
      <div class="location-builder__row">
        <span>🕐</span>
        <label class="poll-builder-label" style="margin:0 8px 0 0;">Schedule Post:</label>
        <%= f.datetime_local_field :scheduled_at,
              id: 'post-scheduled-at',
              class: 'poll-builder-input',
              min: Time.current.strftime('%Y-%m-%dT%H:%M') %>
        <button type="button" onclick="closeScheduleBuilder()" class="poll-builder-close">✕</button>
      </div>
      <p class="form-hint" style="margin:4px 0 0 28px;font-size:12px;color:var(--text-tertiary)">Post will be published automatically at this time</p>
    </div>
    <%# When scheduled, published = false %>
    <%= f.hidden_field :published, value: true, id: 'post-published-field' %>
  </div>

  <%# ── Actions & Options ── %>
  <div class="post-actions-container">
    <div class="post-options">
      <label class="post-option post-option--media" title="Add photos or videos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#31a24c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        <span>Photo/Video</span>
        <%= f.file_field :images, class: 'file-input', accept: 'image/*,video/*', multiple: true %>
      </label>

      <button type="button" class="post-option poll-toggle-btn" id="pollToggleBtn" onclick="togglePollBuilder()" title="Add poll">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#667eea" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
        <span>Poll</span>
      </button>

      <button type="button" class="post-option" onclick="toggleLocationBuilder()" title="Tag location">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span>Location</span>
      </button>

      <button type="button" class="post-option" onclick="toggleScheduleBuilder()" title="Schedule post">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Schedule</span>
      </button>

      <button type="button" class="post-option" onclick="toggleFundraiserBuilder()" title="Add fundraiser">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"/>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
        <span>Fundraise</span>
      </button>
    </div>

    <div class="post-footer-bar">
      <div class="post-visibility-wrapper">
        <%= f.select :visibility,
                     [['🌐 Public', 'public'], ['👥 Friends', 'friends'], ['⭐ Close Friends', 'close_friends'], ['🔒 Only Me', 'private']],
                     {},
                     class: 'visibility-select', id: 'post-visibility' %>
      </div>
      <%= f.submit 'Post', class: 'btn-post', id: 'post-submit-btn' %>
    </div>
  </div>
<% end %>

<script>
  function togglePollBuilder() {
    const builder = document.getElementById('poll-builder');
    const fieldset = document.getElementById('poll-fieldset');
    const btn     = document.getElementById('pollToggleBtn');
    const visible = builder.style.display !== 'none';
    
    builder.style.display = visible ? 'none' : 'block';
    fieldset.disabled = visible; // disable if it becomes hidden
    btn.classList.toggle('poll-toggle-btn--active', !visible);
    
    if (visible) builder.querySelectorAll('input, textarea').forEach(el => { if (el.type !== 'hidden') el.value = ''; });
  }
  function closePollBuilder() {
    document.getElementById('poll-builder').style.display = 'none';
    document.getElementById('poll-fieldset').disabled = true;
    document.getElementById('pollToggleBtn')?.classList.remove('poll-toggle-btn--active');
    document.getElementById('poll-builder').querySelectorAll('input, textarea').forEach(el => { if (el.type !== 'hidden') el.value = ''; });
  }
  function toggleLocationBuilder() {
    const el = document.getElementById('location-builder');
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
  }
  function closeLocationBuilder() {
    document.getElementById('location-builder').style.display = 'none';
    document.getElementById('location-name-input').value = '';
  }
  function toggleScheduleBuilder() {
    const el = document.getElementById('schedule-builder');
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
    // When scheduling, mark post as not published immediately
    const publishedField = document.getElementById('post-published-field');
    if (el.style.display !== 'none' && publishedField) publishedField.value = 'false';
  }
  function closeScheduleBuilder() {
    document.getElementById('schedule-builder').style.display = 'none';
    document.getElementById('post-scheduled-at').value = '';
    const publishedField = document.getElementById('post-published-field');
    if (publishedField) publishedField.value = 'true';
  }
  function toggleFundraiserBuilder() {
    const builder = document.getElementById('fundraiser-builder');
    const fieldset = document.getElementById('fundraiser-fieldset');
    const visible = builder.style.display !== 'none';
    
    builder.style.display = visible ? 'none' : 'block';
    fieldset.disabled = visible;
  }
  function closeFundraiserBuilder() {
    document.getElementById('fundraiser-builder').style.display = 'none';
    document.getElementById('fundraiser-fieldset').disabled = true;
    document.getElementById('fundraiser-builder').querySelectorAll('input, textarea').forEach(el => { if (el.type !== 'hidden') el.value = ''; });
  }
</script>
