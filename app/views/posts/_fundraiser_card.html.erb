<div class="fundraiser-card" id="fundraiser-<%= fundraiser.id %>">
  <div class="fundraiser-card__header">
    <span class="fundraiser-card__icon">💰</span>
    <h4 class="fundraiser-card__title"><%= fundraiser.title %></h4>
  </div>
  <% if fundraiser.description.present? %>
    <p class="fundraiser-card__desc"><%= fundraiser.description.truncate(150) %></p>
  <% end %>

  <div class="fundraiser-progress">
    <div class="fundraiser-progress__bar">
      <div class="fundraiser-progress__fill" style="width: <%= fundraiser.percentage %>%"></div>
    </div>
    <div class="fundraiser-progress__stats">
      <span class="fundraiser-raised">$<%= number_with_delimiter(fundraiser.raised_amount.to_i) %> raised</span>
      <span class="fundraiser-goal">of $<%= number_with_delimiter(fundraiser.goal_amount.to_i) %> goal</span>
      <span class="fundraiser-pct"><%= fundraiser.percentage %>%</span>
    </div>
  </div>

  <% if fundraiser.days_remaining %>
    <p class="fundraiser-time">
      <% if fundraiser.days_remaining > 0 %>
        ⏳ <%= fundraiser.days_remaining %> days remaining
      <% else %>
        ✅ Campaign ended
      <% end %>
    </p>
  <% end %>

  <% if fundraiser.status == 'active' && fundraiser.post.user != current_user %>
    <div class="fundraiser-donate-row">
      <input type="number" id="donate-amount-<%= fundraiser.id %>" placeholder="$10" min="1" step="1" class="fundraiser-input" />
      <button class="btn-primary btn-sm"
              onclick="donateFundraiser(<%= fundraiser.id %>, document.getElementById('donate-amount-<%= fundraiser.id %>').value)">
        Donate
      </button>
    </div>
  <% end %>
</div>

<script>
  window.donateFundraiser = async function(fundraiserId, amount) {
    if (!amount || parseFloat(amount) <= 0) { alert('Enter a valid amount'); return; }
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const resp = await fetch(`/fundraisers/${fundraiserId}/donate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ amount })
    });
    const data = await resp.json();
    if (data.success) {
      const fill = document.querySelector(`#fundraiser-${fundraiserId} .fundraiser-progress__fill`);
      if (fill) fill.style.width = data.percentage + '%';
      const raised = document.querySelector(`#fundraiser-${fundraiserId} .fundraiser-raised`);
      if (raised) raised.textContent = `$${parseFloat(data.raised_amount).toFixed(0)} raised`;
      const pct = document.querySelector(`#fundraiser-${fundraiserId} .fundraiser-pct`);
      if (pct) pct.textContent = data.percentage + '%';
    }
  };
</script>
