<div class="feed-container">
  <%= render 'shared/header' %>
  <div class="feed-layout">
    <main class="feed-main" style="max-width: 680px; margin: 0 auto;">

      <div class="create-post-card" style="padding: 24px;">
        <div class="page-header-card" style="margin-bottom: 20px; padding: 0;">
          <h2 style="margin: 0; font-size: 20px; font-weight: 700;">✏️ Edit Post</h2>
        </div>

        <%= form_with model: @post, url: post_path(@post), method: :patch, class: 'create-post-form' do |f| %>
          <% if @post.errors.any? %>
            <div class="alert alert-error" style="margin-bottom: 16px; padding: 12px; background: #ffebe9; border-radius: 8px; color: #c0392b;">
              <% @post.errors.full_messages.each do |msg| %>
                <p style="margin: 4px 0; font-size: 14px;">• <%= msg %></p>
              <% end %>
            </div>
          <% end %>

          <div class="post-input-wrapper">
            <div class="user-avatar-small">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, alt: "Your avatar" %>
              <% else %>
                <%= current_user.name&.first&.upcase || 'U' %>
              <% end %>
            </div>
            <%= f.text_area :content,
                  placeholder: "What's on your mind?",
                  class: 'post-input',
                  rows: 5,
                  style: "min-height: 120px;" %>
          </div>

          <!-- Existing images preview -->
          <% if @post.images.attached? && @post.images.any? %>
            <div class="edit-existing-images" style="margin: 12px 0;">
              <p style="font-size: 13px; color: #65676b; margin-bottom: 8px;">Current images:</p>
              <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <% @post.images.each do |img| %>
                  <div style="position: relative;">
                    <%= image_tag img, style: "width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 2px solid #e4e6ea;" %>
                  </div>
                <% end %>
              </div>
              <p style="font-size: 12px; color: #aaa; margin-top: 6px;">Upload new images below to replace existing ones.</p>
            </div>
          <% end %>

          <div class="post-actions" style="margin-top: 16px;">
            <div class="post-options">
              <label class="post-option">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#45bd62">
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5.04-6.71l-2.75 3.54-1.96-2.36L6.5 17h11l-3.54-4.71z"/>
                </svg>
                <span>Replace Photos</span>
                <%= f.file_field :images, class: 'file-input', accept: 'image/*', multiple: true %>
              </label>
            </div>

            <div class="post-visibility-wrapper">
              <%= f.select :visibility,
                           [['🌐 Public', 'public'], ['👥 Friends', 'friends'], ['🔒 Only Me', 'private']],
                           { selected: @post.visibility },
                           class: 'visibility-select' %>
            </div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 16px; justify-content: flex-end;">
            <%= link_to 'Cancel', posts_path, class: 'btn-secondary' %>
            <%= f.submit 'Save Changes', class: 'btn-post' %>
          </div>
        <% end %>
      </div>

    </main>
  </div>
</div>

<%= stylesheet_link_tag 'posts/feed', 'data-turbo-track': 'reload' %>
<%= stylesheet_link_tag 'posts/post_card', 'data-turbo-track': 'reload' %>
