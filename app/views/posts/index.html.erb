<div class="feed-container">
  <%= render 'shared/header' %>

  <div class="feed-layout">
    <!-- Sidebar -->
    <aside class="feed-sidebar">
      <div class="sidebar-section">
        <h3>Friend Requests</h3>
        <% if current_user.pending_friend_requests.any? %>
          <% current_user.pending_friend_requests.limit(5).each do |friendship| %>
            <div class="friend-request-item">
              <div class="friend-info">
                <div class="friend-avatar"><%= friendship.user.name&.first&.upcase || 'U' %></div>
                <span><%= friendship.user.name || friendship.user.email %></span>
              </div>
              <div class="friend-actions">
                <%= button_to accept_friendship_path(friendship), method: :patch, class: 'btn-accept' do %>
                  ✓
                <% end %>
                <%= button_to reject_friendship_path(friendship), method: :patch, class: 'btn-reject' do %>
                  ✕
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="empty-state">No pending requests</p>
        <% end %>
      </div>

      <div class="sidebar-section">
        <h3>Suggested Friends</h3>
        <% @users.each do |user| %>
          <% unless current_user.friends_with?(user) || current_user.friend_request_pending?(user) %>
            <div class="suggested-friend">
              <div class="friend-info">
                <div class="friend-avatar"><%= user.name&.first&.upcase || 'U' %></div>
                <div>
                  <div class="friend-name"><%= user.name || user.email %></div>
                  <div class="friend-meta"><%= user.all_friends.count %> friends</div>
                </div>
              </div>
              <%= button_to friendships_path(friend_id: user.id), class: 'btn-add-friend' do %>
                Add Friend
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </aside>

    <!-- Main Feed -->
    <main class="feed-main">
      <!-- Create Post -->
      <div class="create-post-card">
        <%= form_with model: @post, url: posts_path, class: 'create-post-form' do |f| %>
          <div class="post-input-wrapper">
            <div class="user-avatar-small">
              <%= current_user.name&.first&.upcase || 'U' %>
            </div>
            <%= f.text_area :content, placeholder: "What's on your mind, #{current_user.name || 'there'}?", class: 'post-input', rows: 3 %>
          </div>
          
          <div class="post-actions">
            <div class="post-options">
              <label class="post-option">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#45bd62">
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5.04-6.71l-2.75 3.54-1.96-2.36L6.5 17h11l-3.54-4.71z"/>
                </svg>
                <span>Photo</span>
                <%= f.file_field :image, class: 'file-input', accept: 'image/*' %>
              </label>
            </div>
            <%= f.submit 'Post', class: 'btn-post' %>
          </div>
        <% end %>
      </div>

      <!-- Posts Feed -->
      <div class="posts-feed">
        <% @posts.each do |post| %>
          <article class="post-card" id="post-<%= post.id %>">
            <!-- Post Header -->
            <div class="post-header">
              <div class="post-author">
                <%= link_to profile_path(post.user), class: 'author-link' do %>
                  <div class="author-avatar">
                    <%= post.user.name&.first&.upcase || 'U' %>
                  </div>
                  <div class="author-info">
                    <div class="author-name"><%= post.user.name || post.user.email %></div>
                    <div class="post-time"><%= time_ago_in_words(post.created_at) %> ago</div>
                  </div>
                <% end %>
              </div>
              <% if post.user == current_user %>
                <div class="post-menu">
                  <button class="post-menu-btn" onclick="togglePostMenu(<%= post.id %>)">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                      <circle cx="10" cy="4" r="1.5"/>
                      <circle cx="10" cy="10" r="1.5"/>
                      <circle cx="10" cy="16" r="1.5"/>
                    </svg>
                  </button>
                  <div class="post-dropdown" id="postMenu<%= post.id %>">
                    <%= button_to 'Delete Post', post_path(post), method: :delete, class: 'dropdown-item-danger', data: { confirm: 'Are you sure?' } %>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Post Content -->
            <div class="post-content">
              <p><%= simple_format(post.content) %></p>
              <% if post.image.present? %>
                <div class="post-image">
                  <%= image_tag post.image, alt: 'Post image' %>
                </div>
              <% end %>
            </div>

            <!-- Post Stats -->
            <div class="post-stats">
              <div class="stat-item">
                <div class="reaction-icons">
                  <span class="reaction-icon like">👍</span>
                  <span class="reaction-icon love">❤️</span>
                </div>
                <span><%= post.likes_count %></span>
              </div>
              <div class="stat-links">
                <span><%= pluralize(post.comments_count, 'comment') %></span>
                <span><%= pluralize(post.shares_count, 'share') %></span>
              </div>
            </div>

            <!-- Post Actions -->
            <div class="post-actions-bar">
              <%= button_to like_post_path(post), method: :post, class: "action-btn #{current_user.liked?(post) ? 'active' : ''}", id: "like-btn-#{post.id}", data: { turbo: false } do %>
                <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
                </svg>
                <span>Like</span>
              <% end %>
              
              <button class="action-btn" onclick="toggleComments(<%= post.id %>)">
                <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"/>
                </svg>
                <span>Comment</span>
              </button>
              
              <%= button_to share_post_path(post), method: :post, class: 'action-btn', data: { turbo: false } do %>
                <svg class="action-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
                </svg>
                <span>Share</span>
              <% end %>
            </div>

            <!-- Comments Section -->
            <div class="comments-section" id="comments-<%= post.id %>" style="display: none;">
              <div class="comments-list">
                <% post.comments.recent.limit(5).each do |comment| %>
                  <div class="comment-item">
                    <div class="comment-avatar">
                      <%= comment.user.name&.first&.upcase || 'U' %>
                    </div>
                    <div class="comment-content">
                      <div class="comment-bubble">
                        <div class="comment-author"><%= comment.user.name || comment.user.email %></div>
                        <p><%= comment.content %></p>
                      </div>
                      <div class="comment-meta">
                        <span><%= time_ago_in_words(comment.created_at) %> ago</span>
                        <% if comment.user == current_user %>
                          <%= button_to 'Delete', post_comment_path(post, comment), method: :delete, class: 'comment-delete', data: { confirm: 'Delete this comment?' } %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <%= form_with model: [post, Comment.new], class: 'comment-form' do |f| %>
                <div class="comment-input-wrapper">
                  <div class="comment-avatar-small">
                    <%= current_user.name&.first&.upcase || 'U' %>
                  </div>
                  <%= f.text_field :content, placeholder: 'Write a comment...', class: 'comment-input', autocomplete: 'off' %>
                  <%= f.submit 'Post', class: 'btn-comment' %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </main>

    <!-- Right Sidebar -->
    <aside class="feed-right-sidebar">
      <div class="sidebar-section">
        <h3>Your Friends</h3>
        <% current_user.all_friends.first(8).each do |friend| %>
          <%= link_to profile_path(friend), class: 'friend-item' do %>
            <div class="friend-avatar-small"><%= friend.name&.first&.upcase || 'U' %></div>
            <span><%= friend.name || friend.email %></span>
          <% end %>
        <% end %>
        <% if current_user.all_friends.count > 8 %>
          <%= link_to profile_friends_path(current_user), class: 'see-all-link' do %>
            See All Friends
          <% end %>
        <% end %>
      </div>
    </aside>
  </div>
</div>

<%= stylesheet_link_tag 'posts/feed', 'data-turbo-track': 'reload' %>
<%= javascript_include_tag 'posts/feed', 'data-turbo-track': 'reload' %>
