<%# Renders a poll inside a post card.
    `poll`         — Poll instance
    `current_user` — provided by the parent view context
    Turbo Frame wraps the whole poll so a vote response replaces just this section. %>

<%= turbo_frame_tag "poll-#{poll.id}" do %>
  <div class="poll-card" id="poll-card-<%= poll.id %>">

    <%# Question %>
    <p class="poll-question"><%= poll.question %></p>

    <%# Status bar %>
    <div class="poll-meta">
      <span class="poll-total-votes">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <%= poll.total_votes %> vote<%= poll.total_votes == 1 ? '' : 's' %>
      </span>
      <% if poll.ends_at.present? %>
        <span class="poll-time-left <%= poll.active? ? '' : 'poll-ended' %>">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
          <%= poll.active? ? poll.time_remaining : 'Poll ended' %>
        </span>
      <% end %>
    </div>

    <%# Options — show results if voted OR poll expired, otherwise show vote buttons %>
    <% voted      = poll.voted_by?(current_user) %>
    <% user_choice_id = voted ? poll.user_choice(current_user)&.id : nil %>
    <% show_results = voted || !poll.active? %>

    <div class="poll-options" id="poll-options-<%= poll.id %>">
      <% poll.poll_options.each do |option| %>
        <div class="poll-option-row <%= 'poll-option--chosen' if user_choice_id == option.id %>">

          <% if show_results %>
            <%# Results view: progress bar %>
            <div class="poll-bar-wrapper">
              <div class="poll-bar-fill" style="width: <%= option.percentage %>%;"
                   data-option-id="<%= option.id %>"></div>
              <div class="poll-bar-label">
                <span class="poll-option-text">
                  <% if user_choice_id == option.id %>
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" class="poll-check">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  <% end %>
                  <%= option.body %>
                </span>
                <span class="poll-pct" id="poll-pct-<%= option.id %>"><%= option.percentage %>%</span>
              </div>
            </div>
          <% else %>
            <%# Vote button view %>
            <%= button_to vote_poll_path(poll),
                  method: :post,
                  params: { poll_option_id: option.id },
                  class: 'poll-vote-btn',
                  id: "poll-vote-btn-#{option.id}",
                  data: {
                    turbo_stream: true,
                    poll_id: poll.id,
                    option_id: option.id
                  },
                  form: { class: 'poll-vote-form' } do %>
              <span class="poll-option-text"><%= option.body %></span>
            <% end %>
          <% end %>

        </div>
      <% end %>
    </div>

  </div>
<% end %>
