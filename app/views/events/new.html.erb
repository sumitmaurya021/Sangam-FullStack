<div class="events-page-wrapper">
  <%= render 'shared/header' %>
  
  <div class="event-form-container">
    <h2 class="event-form-title">Create New Event</h2>

    <%= form_with model: @event, url: events_path, method: :post, multipart: true, class: 'event-form' do |f| %>
      <% if @event.errors.any? %>
        <div class="form-errors" style="background: rgba(255, 107, 107, 0.1); border-left: 4px solid #ff6b6b; padding: 16px; border-radius: 8px; margin-bottom: 24px;">
          <% @event.errors.full_messages.each do |msg| %>
            <p style="color: #ff6b6b; margin: 0 0 8px; font-size: 14px; font-weight: 600;"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="premium-form-group">
        <%= f.label :title, 'Event Name *', class: 'premium-form-label' %>
        <%= f.text_field :title, placeholder: 'What is the event called?', class: 'premium-form-input', maxlength: 200 %>
      </div>

      <div class="premium-form-row">
        <div class="premium-form-group">
          <%= f.label :starts_at, 'Start Date & Time *', class: 'premium-form-label' %>
          <%= f.datetime_local_field :starts_at, class: 'premium-form-input' %>
        </div>
        <div class="premium-form-group">
          <%= f.label :ends_at, 'End Date & Time', class: 'premium-form-label' %>
          <%= f.datetime_local_field :ends_at, class: 'premium-form-input' %>
        </div>
      </div>

      <div class="premium-form-group">
        <%= f.label :location, 'Location', class: 'premium-form-label' %>
        <div style="position: relative;">
          <svg style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--event-text-sub);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <%= f.text_field :location, placeholder: 'Where is it happening?', class: 'premium-form-input', style: 'padding-left: 44px;' %>
        </div>
      </div>

      <div class="premium-form-group">
        <%= f.label :description, 'Description', class: 'premium-form-label' %>
        <%= f.text_area :description, placeholder: 'Tell people what this event is about...', class: 'premium-form-input', rows: 4, style: 'resize: vertical;' %>
      </div>

      <div class="premium-form-row">
        <div class="premium-form-group">
          <%= f.label :privacy, 'Privacy', class: 'premium-form-label' %>
          <%= f.select :privacy,
              [['🌐 Public', 'public'], ['👥 Friends Only', 'friends'], ['🔒 Private', 'private']],
              {},
              class: 'premium-form-input' %>
        </div>
        <div class="premium-form-group">
          <%= f.label :cover_photo, 'Cover Photo', class: 'premium-form-label' %>
          <%= f.file_field :cover_photo, accept: 'image/*', class: 'premium-form-input', style: 'padding: 11px 18px;' %>
        </div>
      </div>

      <div class="premium-form-actions">
        <%= link_to 'Cancel', events_path, class: 'btn-form-cancel' %>
        <%= f.button type: 'submit', class: 'btn-form-submit' do %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Create Event
        <% end %>
      </div>
    <% end %>
  </div>
</div>
