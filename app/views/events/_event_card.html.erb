<div class="event-card">
  <%= link_to event_path(event), class: 'event-card-link' do %>
    <div class="event-card-cover">
      <% if event.cover_photo.attached? %>
        <%= image_tag event.cover_photo, alt: event.title, class: 'event-cover-img' %>
      <% else %>
        <div class="event-cover-placeholder">
          <span class="event-date-big"><%= event.starts_at.strftime('%d') %></span>
          <span class="event-month-big"><%= event.starts_at.strftime('%b').upcase %></span>
        </div>
      <% end %>
    </div>
    <div class="event-card-body">
      <div class="event-date-badge">
        <span class="event-date-day"><%= event.starts_at.strftime('%a') %></span>
        <span class="event-date-full"><%= event.starts_at.strftime('%b %d at %I:%M %p') %></span>
      </div>
      <h3 class="event-title"><%= event.title %></h3>
      <% if event.location.present? %>
        <p class="event-location">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" style="vertical-align:middle;">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <%= event.location %>
        </p>
      <% end %>
      <div class="event-stats">
        <span><%= event.going_count %> going</span>
        <span>·</span>
        <span><%= event.interested_count %> interested</span>
      </div>
    </div>
  <% end %>

  <div class="event-card-footer">
    <% response = event.user_response(current_user) %>
    <button class="event-rsvp-btn <%= response == 'going' ? 'active' : '' %>"
            onclick="rsvpEvent(<%= event.id %>, 'going', this)">
      ✅ Going
    </button>
    <button class="event-rsvp-btn-secondary <%= response == 'interested' ? 'active' : '' %>"
            onclick="rsvpEvent(<%= event.id %>, 'interested', this)">
      ⭐ Interested
    </button>
  </div>
</div>
