<div class="events-page-wrapper">
  <%= render 'shared/header' %>

  <div class="events-hero">
    <div class="events-hero-content">
      <h1 class="events-hero-title">Discover Amazing Events</h1>
      <p class="events-hero-subtitle">Connect with friends, join communities, and explore what's happening around you.</p>
      <%= link_to new_event_path, class: 'btn-hero-action' do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Create Event
      <% end %>
    </div>
  </div>

  <main class="events-main">
    <!-- My Events (Going) -->
    <% if @my_events.any? %>
      <div class="events-section">
        <div class="events-section-header">
          <h2 class="events-section-title">Events You're Going To</h2>
        </div>
        <div class="events-grid">
          <% @my_events.each do |event| %>
            <%= render 'events/event_card', event: event %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Upcoming Events -->
    <div class="events-section">
      <div class="events-section-header">
        <h2 class="events-section-title">Upcoming Events</h2>
      </div>
      
      <% if @upcoming_events.empty? %>
        <div class="events-empty-state">
          <div class="empty-state-icon-wrapper">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h3>No upcoming events yet</h3>
          <p>Be the first to create an event and invite your friends!</p>
          <%= link_to 'Create Event', new_event_path, class: 'btn-empty-action' %>
        </div>
      <% else %>
        <div class="events-grid">
          <% @upcoming_events.each do |event| %>
            <%= render 'events/event_card', event: event %>
          <% end %>
        </div>
        
        <% if @upcoming_events.next_page %>
          <div class="pagination-wrapper">
            <%= link_to 'Load More Events', events_path(page: @upcoming_events.next_page), class: 'btn-load-more' %>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
