<%= form_with model: listing, url: listing.new_record? ? marketplace_listing_index_path : marketplace_listing_path(listing), class: 'market-form', html: { multipart: true } do |f| %>

  <% if listing.errors.any? %>
    <div class="form-errors">
      <% listing.errors.full_messages.each do |msg| %>
        <p>⚠️ <%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="premium-form-group">
    <%= f.label :title, 'Title *', class: 'premium-form-label' %>
    <%= f.text_field :title, placeholder: 'What are you selling?', class: 'premium-form-input', required: true %>
  </div>

  <div class="premium-form-group">
    <%= f.label :description, 'Description', class: 'premium-form-label' %>
    <%= f.text_area :description, placeholder: 'Describe your item in detail...', rows: 5, class: 'premium-form-input', style: 'resize: vertical;' %>
  </div>

  <div class="premium-form-row">
    <div class="premium-form-group">
      <%= f.label :price, 'Price ($)', class: 'premium-form-label' %>
      <div style="position: relative;">
        <span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--market-text-sub); font-weight: 800; pointer-events: none;">$</span>
        <%= f.number_field :price, placeholder: '0.00', step: '0.01', min: 0, class: 'premium-form-input', style: 'padding-left: 36px;', id: 'marketplace_listing_price' %>
      </div>
      <div style="margin-top:6px;">
        <button type="button" onclick="estimateAiPrice()" style="background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(99,102,241,0.15)); border:1px solid rgba(16,185,129,0.3); color:#10b981; font-weight:600; font-size:0.75rem; padding:4px 10px; border-radius:8px; cursor:pointer;">✨ Estimate Fair Price</button>
      </div>
    </div>
    
    <div class="premium-form-group" style="display: flex; align-items: center; padding-top: 24px;">
      <label style="display: flex; align-items: center; gap: 12px; cursor: pointer; color: var(--market-text-main); font-weight: 600;">
        <%= f.check_box :price_negotiable, style: 'width: 20px; height: 20px; accent-color: var(--market-primary);' %>
        Price Negotiable (OBO)
      </label>
    </div>
  </div>

  <div class="premium-form-row">
    <div class="premium-form-group">
      <%= f.label :category, 'Category *', class: 'premium-form-label' %>
      <div style="position: relative;">
        <svg style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--market-text-sub); pointer-events: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        <%= f.select :category, MarketplaceListing::CATEGORIES.map { |c| [c.humanize, c] }, { prompt: 'Select category' }, class: 'premium-form-input', required: true, style: 'appearance: none; -webkit-appearance: none; padding-right: 40px;' %>
      </div>
    </div>
    <div class="premium-form-group">
      <%= f.label :condition, 'Condition *', class: 'premium-form-label' %>
      <div style="position: relative;">
        <svg style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--market-text-sub); pointer-events: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        <%= f.select :condition, MarketplaceListing::CONDITIONS.map { |c| [c.humanize, c] }, { prompt: 'Select condition' }, class: 'premium-form-input', required: true, style: 'appearance: none; -webkit-appearance: none; padding-right: 40px;' %>
      </div>
    </div>
  </div>

  <div class="premium-form-group">
    <%= f.label :location_name, 'Location', class: 'premium-form-label' %>
    <div style="position: relative;">
      <svg style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--market-text-sub); pointer-events: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
      <%= f.text_field :location_name, placeholder: 'City, Neighborhood, etc.', class: 'premium-form-input', style: 'padding-left: 44px;' %>
    </div>
  </div>

  <div class="premium-form-group">
    <%= f.label :images, 'Photos (up to 10)', class: 'premium-form-label' %>
    
    <div style="border: 2px dashed rgba(16, 185, 129, 0.3); border-radius: 16px; padding: 32px 16px; text-align: center; background: rgba(16, 185, 129, 0.05); transition: all 0.3s ease;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--market-primary); margin-bottom: 12px;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
      <div style="margin-bottom: 16px; color: var(--market-text-main); font-weight: 600;">Drag and drop or click to upload</div>
      <%= f.file_field :images, multiple: true, accept: 'image/*', class: 'premium-form-input', style: 'padding: 12px; cursor: pointer;' %>
    </div>
    
    <div id="aiAutoFillWrapper" style="display: none; margin-top: 16px; text-align: center;">
      <button type="button" id="aiAutoFillBtn" class="ai-autofill-btn">
        <span class="btn-text">✨ Auto-fill Listing from Photo</span>
        <span class="btn-loader" style="display: none;">✨ Analyzing Photo...</span>
      </button>
      <div id="aiAutoFillError" class="ai-autofill-error" style="display: none; color: #ef4444; font-size: 13px; margin-top: 8px;"></div>
    </div>
    
    <% if listing.images.attached? %>
      <div style="margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap;">
        <% listing.images.each do |img| %>
          <div style="width: 64px; height: 64px; border-radius: 8px; overflow: hidden; border: 1px solid var(--market-glass-border);">
            <%= image_tag img, style: 'width:100%; height:100%; object-fit:cover;' %>
          </div>
        <% end %>
      </div>
    <% end %>
    
    <p style="margin-top: 8px; font-size: 13px; color: var(--market-text-sub);">* The first photo will be used as the cover image.</p>
  </div>

  <div class="premium-form-actions">
    <%= link_to 'Cancel', marketplace_listing_index_path, class: 'btn-market-action btn-market-secondary', style: 'width: auto; padding: 14px 24px;' %>
    <%= f.button type: 'submit', class: 'btn-market-action btn-market-primary', style: 'width: auto; padding: 14px 32px;' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      <%= listing.new_record? ? 'Publish Listing' : 'Save Changes' %>
    <% end %>
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", function() {
    const fileInput = document.getElementById("marketplace_listing_images");
    const autoFillWrapper = document.getElementById("aiAutoFillWrapper");
    const autoFillBtn = document.getElementById("aiAutoFillBtn");
    const errorDiv = document.getElementById("aiAutoFillError");
    
    // Form fields
    const titleInput = document.getElementById("marketplace_listing_title");
    const descInput = document.getElementById("marketplace_listing_description");
    const catInput = document.getElementById("marketplace_listing_category");

    if (!fileInput || !autoFillBtn) return;

    let selectedImageDataUrl = null;

    fileInput.addEventListener("change", function(e) {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        const reader = new FileReader();
        
        reader.onload = function(event) {
          selectedImageDataUrl = event.target.result;
          autoFillWrapper.style.display = "block";
          errorDiv.style.display = "none";
        };
        
        reader.readAsDataURL(file);
      } else {
        autoFillWrapper.style.display = "none";
        selectedImageDataUrl = null;
      }
    });

    autoFillBtn.addEventListener("click", function() {
      if (!selectedImageDataUrl) return;

      const btnText = autoFillBtn.querySelector(".btn-text");
      const btnLoader = autoFillBtn.querySelector(".btn-loader");
      
      autoFillBtn.disabled = true;
      btnText.style.display = "none";
      btnLoader.style.display = "inline-block";
      autoFillBtn.classList.add("is-generating");
      errorDiv.style.display = "none";

      fetch("/api/ai/auto_fill_listing", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
          "Accept": "application/json"
        },
        body: JSON.stringify({ image_data_url: selectedImageDataUrl })
      })
      .then(r => r.json())
      .then(data => {
        autoFillBtn.disabled = false;
        btnText.style.display = "inline-block";
        btnLoader.style.display = "none";
        autoFillBtn.classList.remove("is-generating");

        if (data.error) {
          errorDiv.textContent = data.error;
          errorDiv.style.display = "block";
        } else {
          // Pre-fill the form
          if (data.title && titleInput) {
            titleInput.value = data.title;
            // Trigger animation or highlight to show it changed
            titleInput.style.borderColor = "#10b981";
            setTimeout(() => titleInput.style.borderColor = "", 1500);
          }
          if (data.description && descInput) {
            descInput.value = data.description;
            descInput.style.borderColor = "#10b981";
            setTimeout(() => descInput.style.borderColor = "", 1500);
          }
          if (data.category && catInput) {
            const match = Array.from(catInput.options).find(opt => opt.value === data.category.toLowerCase() || opt.text.toLowerCase() === data.category.toLowerCase());
            if (match) {
              catInput.value = match.value;
              catInput.style.borderColor = "#10b981";
              setTimeout(() => catInput.style.borderColor = "", 1500);
            }
          }
        }
      })
      .catch(err => {
        console.error("Auto-fill error:", err);
        autoFillBtn.disabled = false;
        btnText.style.display = "inline-block";
        btnLoader.style.display = "none";
        autoFillBtn.classList.remove("is-generating");
        errorDiv.textContent = "Network error. Please try again.";
        errorDiv.style.display = "block";
      });
    });
  });

  window.estimateAiPrice = function() {
    const title = document.getElementById("marketplace_listing_title")?.value || "";
    const category = document.getElementById("marketplace_listing_category")?.value || "";
    const condition = document.getElementById("marketplace_listing_condition")?.value || "";
    const description = document.getElementById("marketplace_listing_description")?.value || "";
    const priceInput = document.getElementById("marketplace_listing_price");

    if (!title || !category) {
      alert("Please fill in Title and Category first to get an AI price estimation.");
      return;
    }

    fetch("/api/ai/estimate_price", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || ""
      },
      body: JSON.stringify({ title, category, condition, description })
    })
    .then(r => r.json())
    .then(data => {
      if (data.suggested_price && priceInput) {
        priceInput.value = data.suggested_price;
        alert(`✨ AI Valuation Estimate:\nSuggested Price: $${data.suggested_price}\nRange: $${data.min_price} - $${data.max_price}\n\n${data.reasoning || ''}`);
      } else {
        alert(data.error || "Failed to calculate valuation.");
      }
    })
    .catch(err => alert("Network error calculating valuation."));
  };
</script>
