<div class="marketplace-page">
  <%= render 'shared/header' %>

  <div class="market-hero" style="height: 200px;">
    <div class="market-hero-content">
      <h1 class="market-hero-title" style="font-size: 36px;">My Listings</h1>
      <p class="market-hero-subtitle"><%= @listings.total_count %> item<%= @listings.total_count == 1 ? '' : 's' %> in your inventory</p>
    </div>
  </div>

  <div class="market-filters-wrapper" style="margin-top: -30px; max-width: 600px; justify-content: center;">
    <%= link_to marketplace_listing_index_path, class: 'btn-market-action btn-market-secondary', style: 'margin: 0; width: auto; padding: 10px 24px;' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Browse Market
    <% end %>
    <%= link_to new_marketplace_listing_path, class: 'btn-market-create' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      New Listing
    <% end %>
  </div>

  <main>
    <% if @listings.any? %>
      <div class="market-grid">
        <% @listings.each do |listing| %>
          <div class="market-card">
            <div class="market-card-image-wrap">
              <% if listing.status == 'sold' %>
                <div class="market-badge sold">SOLD</div>
              <% elsif listing.status == 'reserved' %>
                <div class="market-badge reserved">RESERVED</div>
              <% else %>
                <div class="market-badge" style="background: rgba(16, 185, 129, 0.8);">ACTIVE</div>
              <% end %>
              
              <% if listing.images.attached? %>
                <%= image_tag listing.images.first, class: 'market-card-image', alt: listing.title %>
              <% else %>
                <div class="market-card-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                </div>
              <% end %>
            </div>

            <div class="market-card-body">
              <h3 class="market-card-price"><%= listing.formatted_price %></h3>
              <h4 class="market-card-title"><%= listing.title.truncate(50) %></h4>
              
              <div class="market-card-footer" style="flex-direction: column; gap: 8px; border-top: none; padding-top: 8px;">
                
                <div style="display: flex; gap: 8px; width: 100%;">
                  <%= link_to 'View', marketplace_listing_path(listing), class: 'btn-market-action btn-market-secondary', style: 'padding: 8px; font-size: 13px; margin: 0;' %>
                  <%= link_to 'Edit', edit_marketplace_listing_path(listing), class: 'btn-market-action btn-market-secondary', style: 'padding: 8px; font-size: 13px; margin: 0;' %>
                </div>

                <div style="display: flex; gap: 8px; width: 100%;">
                  <% if listing.status == 'active' %>
                    <%= button_to mark_sold_marketplace_listing_path(listing), method: :patch, class: 'btn-market-action', style: 'background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 8px; font-size: 13px; margin: 0;' do %>
                      Mark Sold
                    <% end %>
                  <% end %>
                  <%= button_to marketplace_listing_path(listing), method: :delete, data: { confirm: 'Delete this listing?' }, class: 'btn-market-action', style: 'background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 8px; font-size: 13px; margin: 0;' do %>
                    Delete
                  <% end %>
                </div>

              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @listings.next_page %>
        <div class="pagination-wrapper" style="margin-top: 40px;">
          <%= link_to 'Load More', my_listings_marketplace_listing_index_path(page: @listings.next_page), class: 'btn-market-create', style: 'background: var(--market-glass-bg); color: var(--market-text-main); backdrop-filter: blur(20px); border: 1px solid var(--market-glass-border);' %>
        </div>
      <% end %>
    <% else %>
      <div class="market-empty-state">
        <div class="market-empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
        </div>
        <h3>No listings yet</h3>
        <p>You haven't posted any items for sale yet. Start building your inventory!</p>
        <%= link_to new_marketplace_listing_path, class: 'btn-market-create' do %>
          Create Listing
        <% end %>
      </div>
    <% end %>
  </main>
</div>

<%= stylesheet_link_tag 'shared/marketplace', 'data-turbo-track': 'reload' %>
