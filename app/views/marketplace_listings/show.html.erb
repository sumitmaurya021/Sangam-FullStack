<div class="marketplace-page">
  <%= render 'shared/header' %>

  <div style="margin-bottom: 24px;">
    <%= link_to marketplace_listing_index_path, class: 'btn-market-action btn-market-secondary', style: 'display: inline-flex; width: auto; padding: 10px 20px; font-size: 14px;' do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Back to Market
    <% end %>
  </div>

  <div class="market-detail-layout">
    
    <!-- Left Gallery -->
    <div class="market-gallery">
      <% if @listing.images.attached? %>
        <div class="market-gallery-main">
          <%= image_tag @listing.images.first, id: 'mainImage', alt: @listing.title %>
        </div>
        
        <% if @listing.images.count > 1 %>
          <div class="market-gallery-thumbs">
            <% @listing.images.each_with_index do |image, index| %>
              <div class="market-gallery-thumb <%= 'active' if index == 0 %>" onclick="document.getElementById('mainImage').src='<%= url_for(image) %>'; document.querySelectorAll('.market-gallery-thumb').forEach(t => t.classList.remove('active')); this.classList.add('active');">
                <%= image_tag image %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="market-gallery-main" style="display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(16,185,129,0.1), rgba(6,182,212,0.1)); color: var(--market-primary);">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
      <% end %>
    </div>

    <!-- Right Info Panel -->
    <div class="market-info-panel">
      
      <div class="market-detail-badges">
        <span class="market-pill"><%= @listing.category.humanize %></span>
        <span class="market-pill"><%= @listing.condition.humanize %></span>
        <% if @listing.status == 'sold' %>
          <span class="market-pill" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border-color: rgba(239, 68, 68, 0.2);">SOLD OUT</span>
        <% elsif @listing.status == 'reserved' %>
          <span class="market-pill" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-color: rgba(245, 158, 11, 0.2);">RESERVED</span>
        <% end %>
      </div>

      <h1 class="market-detail-title"><%= @listing.title %></h1>
      
      <h2 class="market-detail-price">
        <%= @listing.formatted_price %>
        <% if @listing.price_negotiable %>
          <span style="font-size: 16px; font-weight: 600; color: var(--market-text-sub); opacity: 0.8;">(OBO)</span>
        <% end %>
      </h2>

      <% if @listing.location_name.present? %>
        <div style="display: flex; align-items: center; gap: 8px; color: var(--market-text-sub); font-weight: 600; margin-bottom: 24px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <%= @listing.location_name %>
        </div>
      <% end %>

      <div class="market-detail-desc">
        <%= simple_format(@listing.description.presence || 'No description provided.') %>
      </div>

      <!-- Seller Widget -->
      <div class="market-seller-widget">
        <div class="market-seller-widget-avatar">
          <% if @listing.user.avatar.attached? %>
            <%= image_tag @listing.user.avatar, alt: @listing.user.name %>
          <% else %>
            <%= @listing.user.name&.first&.upcase || 'U' %>
          <% end %>
        </div>
        <div class="market-seller-widget-info">
          <h4><%= @listing.user.name %></h4>
          <p>Listed <%= time_ago_in_words(@listing.created_at) %> ago</p>
        </div>
      </div>

      <% if @listing.status == 'active' && @listing.user != current_user %>
        <div style="margin-bottom:16px; background:linear-gradient(135deg, rgba(16,185,129,0.08), rgba(99,102,241,0.08)); padding:12px 14px; border-radius:12px; border:1px solid rgba(16,185,129,0.2); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
          <div>
            <div style="font-weight:700; color:#10b981; font-size:0.85rem; display:flex; align-items:center; gap:4px;">🏷️ AI Fair Valuation</div>
            <div style="font-size:0.78rem; color:#475569;">Fair Market Value: <strong>$<%= (@listing.price * 0.85).round(2) %> - $<%= (@listing.price * 1.15).round(2) %></strong></div>
          </div>
          <button onclick="makeAiOffer(<%= @listing.id %>, <%= @listing.price %>)" style="background:linear-gradient(135deg, #10b981, #059669); color:white; border:none; padding:8px 14px; border-radius:8px; font-size:0.8rem; font-weight:600; cursor:pointer;">🤖 Negotiate with AI</button>
        </div>
      <% end %>

      <!-- Actions -->
      <div style="margin-top: auto;">
        <% if @listing.user == current_user %>
          <div style="display: flex; gap: 16px;">
            <%= link_to edit_marketplace_listing_path(@listing), class: 'btn-market-action btn-market-secondary' do %>
              Edit Listing
            <% end %>
            <% if @listing.status == 'active' %>
              <%= button_to mark_sold_marketplace_listing_path(@listing), method: :patch, class: 'btn-market-action btn-market-primary' do %>
                Mark as Sold
              <% end %>
            <% end %>
          </div>
        <% else %>
          <% if @listing.status == 'active' %>
            <%= link_to conversations_path(recipient_id: @listing.user_id), method: :post, class: 'btn-market-action btn-market-primary' do %>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              Contact Seller
            <% end %>
          <% else %>
            <button class="btn-market-action btn-market-secondary" disabled style="opacity: 0.5; cursor: not-allowed;">
              Item Unavailable
            </button>
          <% end %>
        <% end %>

        <script>
          function makeAiOffer(listingId, listPrice) {
            const offerStr = prompt(`Item Price: $${listPrice}\nEnter your offer price ($):`, (listPrice * 0.9).toFixed(2));
            if (!offerStr) return;
            const offerPrice = parseFloat(offerStr);
            if (isNaN(offerPrice) || offerPrice <= 0) {
              alert('Please enter a valid offer price.');
              return;
            }

            fetch('/api/ai/negotiate_offer', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
              },
              body: JSON.stringify({ listing_id: listingId, offer_price: offerPrice })
            })
            .then(r => r.json())
            .then(data => {
              alert(data.message || 'Offer processed.');
            })
            .catch(err => alert('Failed to negotiate offer.'));
          }
        </script>

        <div style="text-align: center; margin-top: 16px; font-size: 12px; color: var(--market-text-sub); font-weight: 600;">
          👁 <%= @listing.views_count %> views
        </div>
      </div>

    </div>
  </div>

</div>

<%= stylesheet_link_tag 'shared/marketplace', 'data-turbo-track': 'reload' %>
