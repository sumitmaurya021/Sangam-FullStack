<%# Renders a single group chat message bubble.
    `msg` is a GroupChatMessage instance.
    Used both server-side and injected by JS (via as_json_payload + buildMsgHtml). %>

<div class="message-wrapper <%= msg.user_id == current_user.id ? 'mine' : 'theirs' %>"
     id="gc-msg-<%= msg.id %>">

  <% unless msg.user_id == current_user.id %>
    <div class="message-avatar-wrapper">
      <% if msg.user.avatar.attached? %>
        <%= image_tag url_for(msg.user.avatar), class: 'message-avatar', alt: msg.user.name %>
      <% else %>
        <div class="message-avatar-placeholder"><%= msg.user.name&.first&.upcase || 'U' %></div>
      <% end %>
    </div>
  <% end %>

  <div class="message-content-wrapper">
    <%# Show sender name for group context (not for own messages) %>
    <% unless msg.user_id == current_user.id %>
      <span class="gc-msg-sender-name"><%= msg.user.name %></span>
    <% end %>

    <div class="message-bubble <%= 'deleted' if msg.deleted %>">
      <% if msg.deleted %>
        <span class="message-deleted-text">Message deleted</span>
      <% elsif msg.message_type == 'image' && msg.attachment.attached? %>
        <div class="message-image-wrapper">
          <%= image_tag url_for(msg.attachment), class: 'message-image', alt: 'Image' %>
        </div>
      <% elsif msg.message_type == 'file' && msg.attachment.attached? %>
        <div class="message-file-wrapper">
          <span class="message-file-icon">📎</span>
          <div class="message-file-info">
            <div class="message-file-name"><%= msg.attachment.filename %></div>
          </div>
          <%= link_to url_for(msg.attachment), class: 'message-file-download',
                      download: msg.attachment.filename, target: '_blank', rel: 'noopener' do %>
            ⬇
          <% end %>
        </div>
      <% elsif msg.message_type == 'audio' && msg.attachment.attached? %>
        <% is_mine_gc = msg.user_id == current_user.id %>
        <div class="message-audio-wrapper">
          <audio controls class="message-audio" style="width:100%; border-radius:30px;">
            <source src="<%= url_for(msg.attachment) %>">
          </audio>

          <% gc_box_style = is_mine_gc ? "margin-top:8px; font-size:0.82rem; background:rgba(0,0,0,0.22); backdrop-filter:blur(8px); padding:10px 12px; border-radius:12px; border:1px solid rgba(255,255,255,0.25); color:#ffffff;" : "margin-top:8px; font-size:0.82rem; background:rgba(139,92,246,0.08); padding:10px 12px; border-radius:12px; border-left:3px solid #8b5cf6; color:#1e293b;" %>
          <% gc_header_color = is_mine_gc ? "#ffffff" : "#7c3aed" %>
          <% gc_select_style = is_mine_gc ? "font-size:0.72rem; border-radius:6px; border:1px solid rgba(255,255,255,0.4); padding:3px 6px; background:rgba(255,255,255,0.2); color:#ffffff; font-weight:500; cursor:pointer; outline:none;" : "font-size:0.72rem; border-radius:6px; border:1px solid #cbd5e1; padding:3px 6px; background:#ffffff; color:#334155; font-weight:500; cursor:pointer; outline:none;" %>
          <% gc_text_color = is_mine_gc ? "rgba(255,255,255,0.95)" : "#334155" %>
          <% gc_status_color = is_mine_gc ? "rgba(255,255,255,0.85)" : "#64748b" %>

          <div class="message-transcription-box" id="gc-transcription-<%= msg.id %>" style="<%= gc_box_style %>">
            <% if msg.transcription.present? %>
              <div style="font-weight:600; color:<%= gc_header_color %>; margin-bottom:6px; display:flex; align-items:center; justify-content:space-between; gap:6px; flex-wrap:wrap;">
                <span style="display:flex; align-items:center; gap:4px;">🎙️ AI Transcript</span>
                <select onchange="translateTranscriptText(this, 'gc-transcript-text-<%= msg.id %>')" style="<%= gc_select_style %>">
                  <option value="" style="color:#1e293b; background:white;">🌐 Translate To...</option>
                  <option value="CUSTOM" style="color:#1e293b; background:white;">✏️ Type Any World Language...</option>
                  <optgroup label="Global Languages" style="color:#1e293b; background:white;">
                    <option value="English">🇬🇧 English</option>
                    <option value="Hindi">🇮🇳 Hindi (हिंदी)</option>
                    <option value="Hinglish">💬 Hinglish</option>
                    <option value="Spanish">🇪🇸 Spanish</option>
                    <option value="French">🇫🇷 French</option>
                    <option value="German">🇩🇪 German</option>
                    <option value="Mandarin Chinese">🇨🇳 Chinese</option>
                    <option value="Japanese">🇯🇵 Japanese</option>
                    <option value="Korean">🇰🇷 Korean</option>
                    <option value="Arabic">🇸🇦 Arabic</option>
                    <option value="Russian">🇷🇺 Russian</option>
                    <option value="Portuguese">🇵🇹 Portuguese</option>
                    <option value="Italian">🇮🇹 Italian</option>
                  </optgroup>
                  <optgroup label="Indian Languages" style="color:#1e293b; background:white;">
                    <option value="Marathi">🚩 Marathi (मराठी)</option>
                    <option value="Gujarati">🚩 Gujarati (ગુજરાતી)</option>
                    <option value="Bengali">🚩 Bengali (বাংলা)</option>
                    <option value="Punjabi">🚩 Punjabi (ਪੰਜਾਬੀ)</option>
                    <option value="Tamil">🚩 Tamil (தமிழ்)</option>
                    <option value="Telugu">🚩 Telugu (తెలుగు)</option>
                    <option value="Kannada">🚩 Kannada (ಕನ್ನಡ)</option>
                    <option value="Malayalam">🚩 Malayalam (മലയാളം)</option>
                    <option value="Urdu">🚩 Urdu (اردو)</option>
                  </optgroup>
                </select>
              </div>
              <p id="gc-transcript-text-<%= msg.id %>" style="margin:0; color:<%= gc_text_color %>; font-style:italic; line-height:1.45; word-break:break-word;"><%= msg.transcription %></p>
            <% elsif msg.transcription_status == 'processing' || msg.transcription_status == 'pending' %>
              <span style="color:<%= gc_status_color %>; font-style:italic;">⚡ Transcribing audio with Whisper AI...</span>
            <% else %>
              <span style="color:<%= gc_status_color %>; font-style:italic;">🎙️ Voice Note</span>
            <% end %>
          </div>
        </div>
      <% else %>
        <p class="message-text"><%= msg.body %></p>
      <% end %>
    </div>

    <div class="message-meta">
      <span class="message-time"><%= msg.created_at.strftime('%H:%M') %></span>
    </div>

    <%# Delete action — own messages or group admins %>
    <% if !msg.deleted && (msg.user_id == current_user.id || @group_chat&.admin?(current_user)) %>
      <div class="message-actions">
        <button class="message-action-btn delete-message-btn"
                onclick="gcApp.deleteMessage(<%= msg.id %>)"
                title="Delete message">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
            <path d="M6.5 1.5h3a.5.5 0 010 1h-3a.5.5 0 010-1zM2 3.5h12l-.9 9.5a1 1 0 01-1 .9H3.9a1 1 0 01-1-.9L2 3.5z"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
</div>
